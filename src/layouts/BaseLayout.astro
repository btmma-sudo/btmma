---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { site, type ThemeName } from "../data/site";

type Props = {
  title: string;
  description: string;
  path?: string;
  keywords?: string[];
  image?: string;
  theme?: ThemeName;
};

const {
  title,
  description,
  path = "/",
  keywords = [],
  image = "/images/home-hero.jpg",
  theme = "flame"
} = Astro.props;

const canonical = new URL(path, site.primaryDomain).toString();
const bodyClass = site.themes[theme].bodyClass;
const imageUrl = new URL(image, site.primaryDomain).toString();
const dayUrlMap = {
  Monday: "https://schema.org/Monday",
  Tuesday: "https://schema.org/Tuesday",
  Wednesday: "https://schema.org/Wednesday",
  Thursday: "https://schema.org/Thursday",
  Friday: "https://schema.org/Friday",
  Saturday: "https://schema.org/Saturday",
  Sunday: "https://schema.org/Sunday"
} as const;
const schoolId = `${site.primaryDomain}/#martial-arts-school`;
const websiteId = `${site.primaryDomain}/#website`;
// One stable school entity across every page, linked to each page's unique identity.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "SportsActivityLocation"],
      "@id": schoolId,
      name: site.name,
      alternateName: site.shortName,
      description: "Beginner-friendly Kenpo Karate, Muay Thai, Wing Chun, and women's self-defense training for kids, teens, and adults in Owings Mills, Maryland.",
      url: `${site.primaryDomain}/`,
      telephone: site.phone,
      email: site.email,
      slogan: "One Tree. One Family.",
      image: new URL("/images/logo.png", site.primaryDomain).toString(),
      hasMap: site.mapUrl,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.addressLine1,
        addressLocality: site.city,
        addressRegion: site.region,
        postalCode: site.postalCode,
        addressCountry: site.country
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: site.latitude,
        longitude: site.longitude
      },
      openingHoursSpecification: site.schemaHours.map((entry) => ({
        "@type": "OpeningHoursSpecification",
        dayOfWeek: entry.days.map((day) => dayUrlMap[day as keyof typeof dayUrlMap]),
        opens: entry.opens,
        closes: entry.closes
      })),
      areaServed: [
        { "@type": "Place", name: "Owings Mills, Maryland" },
        { "@type": "Place", name: "Reisterstown, Maryland" },
        { "@type": "Place", name: "Pikesville, Maryland" },
        { "@type": "Place", name: "Randallstown, Maryland" },
        { "@type": "AdministrativeArea", name: site.serviceArea }
      ],
      knowsAbout: ["American Kenpo Karate", "Muay Thai", "Wing Chun", "Sanuces Ryu Jujitsu", "Women's self-defense", "Kids martial arts"],
      sameAs: [site.social.instagram, site.social.facebook]
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: site.name,
      url: `${site.primaryDomain}/`,
      inLanguage: "en-US",
      publisher: { "@id": schoolId }
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "en-US",
      isPartOf: { "@id": websiteId },
      about: { "@id": schoolId },
      primaryImageOfPage: { "@type": "ImageObject", url: imageUrl }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MNQC3K79EV" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MNQC3K79EV');
    </script>
    <!-- End Google tag -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Black+Ops+One&display=swap" />
    <link rel="icon" href="/favicon.ico?v=1" sizes="any" type="image/x-icon" />
    <link rel="shortcut icon" href="/favicon.ico?v=1" type="image/x-icon" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <!-- Meta Pixel Code -->
<script is:inline>
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '1531558921681879');
fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id=1531558921681879&ev=PageView&noscript=1"
/></noscript>
<!-- End Meta Pixel Code -->
  </head>
  <body class={bodyClass}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const revealSelectors = [
          "main > section",
          ".program-card",
          ".detail-card",
          ".quote-card",
          ".faq-card",
          ".gallery-card",
          ".chimpangi-gallery-card",
          ".lead-card-compact-card",
          ".section-heading"
        ];

        const revealElements = document.querySelectorAll(revealSelectors.join(", "));
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          {
            threshold: 0,
            rootMargin: "0px 0px 100px 0px"
          }
        );

        revealElements.forEach((element, index) => {
          if (!(element instanceof HTMLElement)) return;
          element.classList.add("reveal-on-scroll");
          element.style.setProperty("--reveal-delay", `0ms`);
          observer.observe(element);
        });
      }
    </script>
  </body>
</html>
