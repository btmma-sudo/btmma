---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const photos = [
  { src: "/images/kids-martial-arts-group.png", alt: "Junior martial arts students together at Burning Tree MMA", label: "Our Junior Martial Arts Family" },
  { src: "/images/kids-martial-arts-karate-guard.png", alt: "Young martial artist practicing a karate guard", label: "Learning Karate Fundamentals" },
  { src: "/images/kids-martial-arts-bag-training.png", alt: "Young student practicing with a training bag", label: "Building Skills With Practice" },
  { src: "/images/kids-martial-arts-partner-practice.png", alt: "Two junior martial artists practicing together", label: "Partner Training" },
  { src: "/images/kids-martial-arts-certificates.png", alt: "Young martial arts students celebrating certificates", label: "Celebrating Progress" },
  { src: "/images/jr-kenpo-gallery-3.jpg", alt: "Junior Kenpo student displaying martial arts medals", label: "Student Achievements" },
  { src: "/images/Gallery/gallery11.jpeg", alt: "Junior martial arts students and instructors together at Burning Tree", label: "Junior Students and Instructors" },
  { src: "/images/Gallery/gallery6.jpeg", alt: "Young Burning Tree martial arts student with an instructor", label: "Student Progress" },
  { src: "/images/burning-tree-teen-kenpo-training.webp", alt: "Teen martial arts student on the training mat", label: "Teen Kenpo Training" },
  { src: "/images/burning-tree-muay-thai-female.webp", alt: "Female martial artist working on striking skills", label: "Striking Practice" },
  { src: "/images/burning-tree-adult-striking-drill.webp", alt: "Adult martial arts students practicing a striking drill", label: "Adult Martial Arts" },
  { src: "/images/burning-tree-womens-self-defense-cropped.webp", alt: "Women's self-defense training partners practicing technique", label: "Women's Self-Defense" }
];
---
<BaseLayout
  title="Martial Arts Class Photos in Owings Mills | Burning Tree MMA"
  description="See our students in action at Burning Tree Mixed Martial Arts in Owings Mills. Explore kids karate, Muay Thai, Wing Chun, adult classes and self-defense training."
  path="/gallery"
  image="/images/kids-martial-arts-group.png">
  <section class="shell gallery-intro">
    <p class="eyebrow">One Tree. One Family.</p>
    <h1>Photos From the Burning Tree Mats</h1>
    <p>See moments from our junior and adult martial arts classes in Owings Mills, Maryland. Building confidence, learning new skills and celebrating progress are all part of our school community.</p>
    <p>Explore <a href="/kids-martial-arts">kids martial arts</a>, <a href="/teens-adults-martial-arts">teen and adult classes</a> and <a href="/womens-defense">women's self-defense</a>.</p>
  </section>
  <section class="shell gallery-grid" aria-label="Student training photo gallery">
    {photos.map((photo) => (
      <figure class="gallery-item">
        <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="750" height="580" />
        <figcaption>{photo.label}</figcaption>
      </figure>
    ))}
  </section>
  <section class="shell gallery-cta">
    <h2>Ready to Join Our Martial Arts Family?</h2>
    <p>Come train with us at {site.addressLine1}, {site.city}, {site.region} {site.postalCode}.</p>
    <a class="button" href="/29-trial">Claim 2 Beginner Classes + a Free Uniform for $29</a>
  </section>
</BaseLayout>
<style>
  .gallery-intro { padding: 3rem 0 1.6rem; }
  .gallery-intro p { max-width: 820px; }
  .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; padding-bottom: 2.5rem; }
  .gallery-item { margin: 0; background: var(--surface); border: 1px solid var(--line); overflow: hidden; }
  .gallery-item img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .gallery-item figcaption { font-weight: 700; padding: .75rem 1rem; }
  .gallery-cta { border-top: 1px solid var(--line); padding: 2.5rem 0 3rem; }
  .gallery-cta p { margin: .8rem 0 1.4rem; }
  @media (max-width: 800px) { .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .gallery-grid { grid-template-columns: 1fr; } }
</style>
