---
import BaseLayout from "../layouts/BaseLayout.astro";
import SeminarDonations from "../components/SeminarDonations.astro";

const eventStructuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "Build a Flame — Confidence & Emotional Strength Workshop",
  description: "A hands-on confidence and emotional strength workshop for children featuring practical responses to bullying, emotion management, peer pressure and resilience.",
  startDate: "2026-12-05T11:45:00-05:00",
  endDate: "2026-12-05T12:45:00-05:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: "Burning Tree Mixed Martial Arts",
    address: {
      "@type": "PostalAddress",
      streetAddress: "10210 S. Dolfield Rd., Suite C",
      addressLocality: "Owings Mills",
      addressRegion: "MD",
      postalCode: "21117",
      addressCountry: "US"
    }
  },
  offers: {
    "@type": "Offer",
    url: "https://burningtreemma.com/build-a-flame/",
    price: "50",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    validThrough: "2026-11-29T23:59:00-05:00"
  }
};
---
<BaseLayout
  title="Upcoming Seminars & Events | Burning Tree Mixed Martial Arts"
  description="Register for Build a Flame on Saturday, December 5, 2026, from 11:45 AM to 12:45 PM: a hands-on confidence and emotional strength workshop for children in Owings Mills, Maryland."
  path="/seminars/"
  keywords={["martial arts events Owings Mills", "children confidence workshop Maryland", "bullying awareness workshop Baltimore County", "Burning Tree MMA events"]}
  image="/images/build-a-flame-workshop-flyer.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(eventStructuredData)} />
  <div class="seminar-page">
    <section class="seminar-hero" aria-labelledby="seminar-heading">
      <div class="shell">
        <p class="seminar-eyebrow">BURNING TREE MIXED MARTIAL ARTS · OWINGS MILLS, MD</p>
        <h1 id="seminar-heading">Upcoming Seminars <span>&amp; Events</span></h1>
        <p>Join us Saturday, December 5, from 11:45 AM to 12:45 PM for Build a Flame, a hands-on confidence and emotional strength workshop for children. Registration is $50 per child, with no fixed attendance limit.</p>
        <a class="seminar-cta" href="/build-a-flame/">EXPLORE BUILD A FLAME</a>
        <a class="seminar-cta seminar-donate-link" href="#donate">SUPPORT BURNING TREE</a>
        <p class="seminar-motto">One Tree. One Family.</p>
      </div>
    </section>

    <section class="shell seminar-events" id="events" aria-label="Upcoming martial arts seminars and events">
      <article class="seminar-card" id="build-a-flame">
        <a class="flame-flyer-link" href="/build-a-flame/" aria-label="Open Build a Flame registration and payment">
          <img class="seminar-flyer" src="/images/build-a-flame-workshop-flyer.webp" alt="Build a Flame Confidence and Emotional Strength Workshop flyer — Saturday December 5, 2026, 11:45 AM–12:45 PM, $50 per child, register and pay by November 29" width="1122" height="1402" loading="lazy" decoding="async" />
        </a>
        <div class="seminar-card-content">
          <p class="seminar-eyebrow">SATURDAY, DECEMBER 5, 2026 · 11:45 AM–12:45 PM ET</p>
          <h2>Build <span>a Flame</span></h2>
          <p class="seminar-tagline">Strong children aren't born. They're built.</p>
          <p>Join our hands-on Confidence &amp; Emotional Strength Workshop for children. Learn to manage emotions, respond safely to bullying, handle peer pressure and build resilience and self-respect.</p>
          <p>One interactive 60-minute workshop with no fixed attendance limit. One parent or guardian included with each child's registration.</p>
          <div class="seminar-prices two">
            <div><strong>$50</strong><span>Per Child</span></div>
            <div><strong>Nov 29</strong><span>Register &amp; Pay By</span></div>
          </div>
          <a class="seminar-cta" href="/build-a-flame/">REGISTER FOR BUILD A FLAME</a>
        </div>
      </article>
    </section>
    <SeminarDonations />
  </div>
</BaseLayout>

<style>
  .seminar-page { --seminar-red: #b91c1c; color: #f7f7f7; }
  .seminar-page *, .seminar-page *::before, .seminar-page *::after { box-sizing: border-box; }
  .seminar-hero { padding: 4rem 0 3.4rem; background: linear-gradient(110deg, #111 10%, #351010 100%); border-bottom: 4px solid var(--seminar-red); }
  .seminar-hero .shell { max-width: 960px; text-align: center; }
  .seminar-eyebrow { color: #ffb7b7; font-size: .85rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .seminar-hero h1 { font-family: 'Black Ops One', 'Open Sans', sans-serif; line-height: 1.13; font-size: clamp(2.3rem, 5vw, 4.4rem); margin: .8rem 0; color: #fff; }
  .seminar-hero h1 span, .seminar-card h2 span { color: #ff6767; }
  .seminar-hero p:not(.seminar-eyebrow):not(.seminar-motto) { max-width: 700px; line-height: 1.7; margin: 1.25rem auto; color: #f1f1f1; font-size: 1.08rem; }
  .seminar-motto { color: #fff; font-weight: 700; margin-top: 1.2rem; }
  .seminar-cta { display: inline-block; appearance: none; border: 2px solid #8e1010; background: #b91c1c; color: #fff; font: 800 .95rem/1.4 'Open Sans', sans-serif; padding: .92rem 1.3rem; text-decoration: none; border-radius: .35rem; cursor: pointer; text-align: center; transition: background .18s ease; }
  .seminar-cta:hover, .seminar-cta:focus-visible { background: #861010; color: #fff; }
  .seminar-donate-link { margin-left: .5rem; }
  .seminar-events { display: grid; grid-template-columns: minmax(0, 830px); justify-content: center; gap: 1.7rem; padding-top: 3rem; padding-bottom: 3rem; }
  .seminar-card { background: #1c1c1c; border: 1px solid #65302c; border-radius: .65rem; overflow: hidden; display: flex; flex-direction: column; }
  #build-a-flame > .flame-flyer-link {
    display: grid; place-items: center; width: 100%; aspect-ratio: 5 / 4;
    max-height: 490px; padding: 12px; overflow: hidden;
    background: radial-gradient(ellipse at center, #33110d 0%, #130c0a 76%, #090909 100%);
  }
  #build-a-flame > .flame-flyer-link > img.seminar-flyer {
    display: block; width: 100%; height: 100%; max-width: 100%;
    max-height: 100%; object-fit: contain; object-position: center;
    border-radius: 4px; background: transparent;
  }
  #build-a-flame > .flame-flyer-link:focus-visible { outline: 3px solid #ffb65c; outline-offset: -3px; }
  .seminar-card-content { padding: 1.5rem 1.5rem 1.8rem; display: flex; flex-direction: column; flex: 1; }
  .seminar-card h2 { margin: .3rem 0 .5rem; font: 900 clamp(1.6rem, 2.7vw, 2.4rem)/1.18 'Black Ops One', 'Open Sans', sans-serif; color: #fff; }
  .seminar-card p { color: #ececec; line-height: 1.65; }
  .seminar-card .seminar-tagline { color: #fff; font-weight: 800; font-size: 1.1rem; }
  .seminar-card .seminar-eyebrow { color: #ffc6c6; line-height: 1.5; }
  .seminar-card .seminar-cta { margin-top: auto; width: 100%; }
  .seminar-prices { display: flex; flex-wrap: wrap; margin: 1rem 0 1.6rem; gap: .5rem; }
  .seminar-prices > div { flex: 1 1 105px; background: #2c2c2c; border-top: 3px solid #dc3333; padding: .8rem .5rem; text-align: center; border-radius: .25rem; }
  .seminar-prices strong { display: block; font-size: 1.65rem; line-height: 1.25; color: #fff; }
  .seminar-prices span { display: block; color: #eaeaea; font-size: .79rem; font-weight: 700; }
  @media (max-width: 860px) {
    .seminar-events { grid-template-columns: minmax(0, 1fr); }
    #build-a-flame > .flame-flyer-link { max-height: none; aspect-ratio: 5 / 4; }
  }
  @media (max-width: 520px) {
    .seminar-card-content { padding: 1.2rem; }
    .seminar-prices > div { flex-basis: 95px; }
    .seminar-cta { width: 100%; }
    .seminar-donate-link { margin-left: 0; margin-top: .6rem; }
  }
</style>
