---
import BaseLayout from "../layouts/BaseLayout.astro";
const eventStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Event",
      name: "United by Purpose — Martial Arts Fundraising Seminar",
      startDate: "2026-11-15T14:00:00-05:00",
      endDate: "2026-11-15T16:00:00-05:00",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      eventStatus: "https://schema.org/EventScheduled",
      location: { "@type": "Place", name: "Burning Tree Mixed Martial Arts", address: { "@type": "PostalAddress", streetAddress: "10210 South Dolfield Road, Suite C", addressLocality: "Owings Mills", addressRegion: "MD", postalCode: "21117", addressCountry: "US" } },
      description: "Martial arts fundraising seminar with Master Mike Lambert and Master Lee Epperson, featuring hands-on training, three support levels, and a community mission. All ages and martial arts backgrounds welcome.",
      offers: { "@type": "AggregateOffer", lowPrice: "50", highPrice: "100", priceCurrency: "USD", url: "https://burningtreemma.com/seminars/?event=united#registration" }
    },
    {
      "@type": "Event",
      name: "Striking a Nerve — Anatomy & Physiology of Martial Arts",
      startDate: "2026-11-21T12:00:00-05:00",
      endDate: "2026-11-22T14:00:00-05:00",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      eventStatus: "https://schema.org/EventScheduled",
      location: { "@type": "Place", name: "Burning Tree Mixed Martial Arts", address: { "@type": "PostalAddress", streetAddress: "10210 South Dolfield Road, Suite C", addressLocality: "Owings Mills", addressRegion: "MD", postalCode: "21117", addressCountry: "US" } },
      description: "Two-day anatomy and physiology seminar with Dr. Frederick Weiss, MD, DPT. Day 1 focuses on Kenpo; Day 2 covers martial arts more broadly.",
      offers: { "@type": "AggregateOffer", lowPrice: "100", highPrice: "190", priceCurrency: "USD", url: "https://burningtreemma.com/seminars/?event=nerve#registration" }
    }
  ]
};
---
<BaseLayout
  title="November 2026 Martial Arts Seminars & Registration | Burning Tree MMA"
  description="Register for United by Purpose, November 15 from 2–4 PM with Masters Mike Lambert and Lee Epperson, and Striking a Nerve, November 21–22, in Owings Mills."
  path="/seminars/"
  keywords={["martial arts seminar Owings Mills", "Kenpo seminar Maryland", "martial arts workshop Baltimore County", "martial arts anatomy seminar", "martial arts fundraiser Maryland"]}
  image="/images/burning-tree-kenpo-team.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(eventStructuredData)} />
  <div class="seminar-page">
    <section class="seminar-hero" aria-labelledby="seminar-heading">
      <div class="shell">
        <p class="seminar-eyebrow">BURNING TREE MIXED MARTIAL ARTS · OWINGS MILLS, MD</p>
        <h1 id="seminar-heading">Two Seminars. <span>One Community.</span></h1>
        <p>Join us this November for a community fundraising seminar and a special two-day martial arts education event. Choose your seminar, register online, and pay through secure Stripe checkout or direct Cash App.</p>
        <a class="seminar-cta" href="#events">EXPLORE BOTH SEMINARS</a>
        <p class="seminar-motto">One Tree. One Family.</p>
      </div>
    </section>

    <section class="shell seminar-events" id="events" aria-label="Upcoming martial arts seminars">
      <article class="seminar-card" id="united-by-purpose">
        <img class="seminar-flyer" src="/images/seminar-united-by-purpose-2026.webp" alt="United by Purpose seminar flyer — Sunday November 15, 2026, 2–4 PM; Masters Mike Lambert and Lee Epperson; $50, $75, and $100 participation levels" width="1179" height="1334" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/images/burning-tree-milestones-group-certificates.webp';" />
        <div class="seminar-card-content">
          <p class="seminar-eyebrow">SUNDAY · NOVEMBER 15, 2026 · 2–4 PM</p>
          <h2>United by <span>Purpose</span></h2>
          <p class="seminar-tagline">Same training. Same experience. A bigger impact.</p>
          <p>Join the Burning Tree family for two hours of hands-on martial arts training with <strong>Master Mike Lambert and Master Lee Epperson</strong> as we come together to support our school's future and our community.</p>
          <p><strong>All are welcome!</strong> Open to all skill levels and martial arts backgrounds — youth, teens, and adults.</p>
          <p><strong>Everyone trains together.</strong> All three ticket levels receive the same seminar instruction; choose how much you would like to support the school.</p>
          <div class="seminar-prices" aria-label="United by Purpose admission pricing">
            <div><strong>$50</strong><span>General Admission</span></div>
            <div><strong>$75</strong><span>Community Supporter</span></div>
            <div><strong>$100</strong><span>Flame Sponsor</span></div>
          </div>
          <p class="seminar-note">All include hands-on instruction and a certificate of participation. Community Supporters receive a special Flame Certificate; Flame Sponsors receive a Sponsor Burning Flame Certificate.</p>
          <button class="seminar-cta select-seminar" data-event="united" type="button">REGISTER FOR UNITED BY PURPOSE</button>
          <p class="seminar-note">Can't attend but want to support the school? Text Coach David at <a href="sms:+14102180894">410-218-0894</a> to ask about donating. A donation by itself is not an event registration.</p>
        </div>
      </article>

      <article class="seminar-card" id="striking-a-nerve">
        <img class="seminar-flyer" src="/images/seminar-striking-a-nerve-2026.webp" alt="Striking a Nerve anatomy and physiology seminar flyer — November 21 and 22, 2026, noon–2 PM; Dr. Frederick Weiss; $100 for one day or $190 for both" width="707" height="1536" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/burning-tree-adult-striking-drill.webp';" />
        <div class="seminar-card-content">
          <p class="seminar-eyebrow">NOVEMBER 21 &amp; 22, 2026 · 12–2 PM EACH DAY</p>
          <h2>Striking <span>a Nerve</span></h2>
          <p class="seminar-tagline">The anatomy and physiology behind martial arts.</p>
          <p>Join special guest instructor <strong>Dr. Frederick Weiss, MD, DPT</strong>, Assistant Professor of Radiology, for a hands-on exploration of how muscles, joints, the nervous system, structure, timing, and movement apply to Kenpo and other martial arts.</p>
          <ul class="seminar-topics">
            <li><strong>Day 1 — Saturday, Nov 21 · 12–2 PM:</strong> The true anatomy and physiology of Kenpo: muscles, joints, nervous system, technique, power, structure, timing, and injury prevention.</li>
            <li><strong>Day 2 — Sunday, Nov 22 · 12–2 PM:</strong> The true anatomy and physiology of martial arts: striking, grappling, balance, movement, and long-term training.</li>
          </ul>
          <p>Open to martial artists of all styles and ranks, including students, coaches, and instructors. <strong>Limited spots available.</strong></p>
          <div class="seminar-prices two">
            <div><strong>$100</strong><span>One Day</span></div>
            <div><strong>$190</strong><span>Both Days</span></div>
          </div>
          <button class="seminar-cta select-seminar" data-event="nerve" type="button">REGISTER FOR STRIKING A NERVE</button>
        </div>
      </article>
    </section>

    <section class="shell seminar-registration" id="registration" aria-labelledby="registration-heading">
      <div class="seminar-intro">
        <p class="seminar-eyebrow">SAVE YOUR PLACE</p>
        <h2 id="registration-heading">Register &amp; Pay Online</h2>
        <p>Choose your seminar and admission option, enter attendee names and contact details, then select Apple Pay/Apple Cash, a credit/debit card, or direct Cash App. You can register up to six attendees together.</p>
        <p class="seminar-note">For multiple attendees, enter one full name per line. The total updates automatically. Your registration is confirmed only after successful payment.</p>
      </div>
      <form id="seminar-form" class="seminar-form">
        <div class="seminar-field">
          <label for="seminar-event">Choose seminar</label>
          <select id="seminar-event" required>
            <option value="united">United by Purpose — Nov 15</option>
            <option value="nerve">Striking a Nerve — Nov 21–22</option>
          </select>
        </div>
        <div class="seminar-field">
          <label for="seminar-ticket">Admission option</label>
          <select id="seminar-ticket" required></select>
        </div>
        <div class="seminar-fields-row">
          <div class="seminar-field">
            <label for="seminar-contact-name">Contact full name</label>
            <input id="seminar-contact-name" type="text" autocomplete="name" maxlength="120" required />
          </div>
          <div class="seminar-field">
            <label for="seminar-contact-email">Contact email</label>
            <input id="seminar-contact-email" type="email" autocomplete="email" maxlength="254" required />
          </div>
        </div>
        <div class="seminar-field">
          <label for="seminar-contact-phone">Contact phone</label>
          <input id="seminar-contact-phone" type="tel" autocomplete="tel" maxlength="30" required />
        </div>
        <div class="seminar-field">
          <label for="seminar-attendees">Full name of each attendee (one per line)</label>
          <textarea id="seminar-attendees" rows="4" maxlength="500" placeholder="Your name&#10;Second attendee's name" required></textarea>
          <p class="seminar-note">Enter 1–6 names. Include yourself if you will be attending. Each name counts as one paid seat.</p>
        </div>
        <div class="seminar-total" aria-live="polite">
          <span id="seminar-total-label">General Admission × 1</span>
          <strong id="seminar-total-amount">$50.00</strong>
        </div>
        <p class="seminar-note">Review your details to see the same payment choices as our $29 special. Apple Pay (including eligible Apple Cash cards) and credit/debit cards use secure Stripe checkout. Direct Cash App payments are manually verified.</p>
        <p class="seminar-note">We do not collect or store card numbers on this website. By registering, you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
        <p id="seminar-form-message" class="seminar-message" role="status" aria-live="polite"></p>
        <button id="seminar-submit" class="seminar-cta seminar-checkout" type="submit">REVIEW REGISTRATION &amp; CHOOSE PAYMENT</button>
        <div id="seminar-payment-options" class="seminar-payment-options" hidden>
          <h3>Choose Your Payment Method</h3>
          <p id="seminar-reviewed-total" class="seminar-reviewed-total" aria-live="polite"></p>
          <button id="seminar-applepay" class="seminar-cta seminar-pay-choice" type="button">APPLE PAY / APPLE CASH</button>
          <button id="seminar-card" class="seminar-cta seminar-pay-choice" type="button">PAY WITH CREDIT / DEBIT CARD</button>
          <button id="seminar-cashapp" class="seminar-cta seminar-pay-choice" type="button">PAY DIRECTLY WITH CASH APP</button>
          <p class="seminar-note">Apple Pay and card payments open the same secure Stripe checkout. Apple Pay appears only on supported devices. To use an eligible Apple Cash balance, select the Apple Cash card in Apple Pay. A credit or debit card remains available as a fallback.</p>
          <div class="seminar-security">
            <p class="seminar-note"><strong>Security check for card / Apple Pay</strong></p>
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAD6Ievu-t0Ll1euh" data-size="normal"></div>
          </div>
        </div>
        <div id="seminar-cashapp-instructions" class="seminar-cashapp-instructions" hidden aria-live="polite">
          <h3>Direct Cash App Payment</h3>
          <p>Send exactly <strong id="seminar-cashapp-amount"></strong> to <strong>$BTMMA</strong> using Cash App.</p>
          <a class="seminar-cta seminar-cashapp-link" href="https://cash.app/$BTMMA" target="_blank" rel="noopener noreferrer">OPEN CASH APP — $BTMMA</a>
          <p class="seminar-note"><strong>Check before paying:</strong> The Cash App profile should be $BTMMA. Enter the exact amount shown above; this link does not prefill your ticket total. If the recipient or total is different, do not send the payment.</p>
          <p><strong>Payment note:</strong> <span id="seminar-cashapp-note"></span></p>
          <p><strong>After paying:</strong> Text your payment confirmation and the attendee details to <a href="sms:+14102180894">(410) 218-0894</a>.</p>
          <label for="seminar-cashapp-details" class="seminar-copy-label">Your registration details (copy into your text)</label>
          <textarea id="seminar-cashapp-details" rows="5" readonly aria-label="Registration details to text to Burning Tree"></textarea>
          <button type="button" id="seminar-copy-details" class="seminar-cta seminar-pay-choice">COPY REGISTRATION DETAILS</button>
          <p id="seminar-copy-message" class="seminar-note" role="status"></p>
          <p class="seminar-cashapp-warning"><strong>Registration pending:</strong> Cash App does not automatically confirm an attendee on this website. Your place is confirmed by Burning Tree after we verify your payment and attendee details. Do not pay a second time through Stripe.</p>
          <button type="button" id="seminar-back-to-payments" class="seminar-cta seminar-pay-choice">CHANGE PAYMENT METHOD</button>
        </div>
        <p class="seminar-note">Seminar questions? Call or text <a href="tel:+14102180894">(410) 218-0894</a>.</p>
      </form>
      <div id="registration-result" class="seminar-confirmation" hidden tabindex="-1" aria-live="polite">
        <h3 id="registration-result-heading">Checking your payment...</h3>
        <p id="registration-result-detail">We're verifying your payment directly with Stripe.</p>
        <p id="registration-result-note"></p>
        <a href="/seminars/" class="seminar-cta">BACK TO SEMINARS</a>
      </div>
    </section>

    <section class="shell seminar-location" aria-label="Location and questions">
      <div>
        <h2>Both Seminars at Burning Tree</h2>
        <p><strong>10210 South Dolfield Road, Suite C</strong></p>
        <p>Owings Mills, MD 21117</p>
        <p>Questions or accessibility needs? Call or text <a href="tel:+14102180894">(410) 218-0894</a>.</p>
      </div>
      <div>
        <p class="seminar-eyebrow">SHARE WITH A TRAINING PARTNER</p>
        <p>Bring your family, invite another instructor, or share the registration link with someone interested in martial arts. Both events are open to the wider martial arts community.</p>
        <p><strong>One Tree. One Family.</strong></p>
      </div>
    </section>
  </div>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline>
    (() => {
      // These are display amounts only. The dedicated /api/seminar-checkout
      // endpoint independently owns and enforces all Stripe ticket prices.
      const priceLists = {
        united: [
          { id: "general", label: "General Admission — $50 per person", name: "General Admission", cents: 5000 },
          { id: "supporter", label: "Community Supporter — $75 per person", name: "Community Supporter", cents: 7500 },
          { id: "sponsor", label: "Flame Sponsor — $100 per person", name: "Flame Sponsor", cents: 10000 }
        ],
        nerve: [
          { id: "day1", label: "Saturday Nov 21 only — $100 per person", name: "Day 1", cents: 10000 },
          { id: "day2", label: "Sunday Nov 22 only — $100 per person", name: "Day 2", cents: 10000 },
          { id: "both", label: "Both days — $190 per person", name: "Both Days", cents: 19000 }
        ]
      };
      const closingTimes = {
        united: { general: "2026-11-15T19:00:00Z", supporter: "2026-11-15T19:00:00Z", sponsor: "2026-11-15T19:00:00Z" },
        nerve: { day1: "2026-11-21T17:00:00Z", day2: "2026-11-22T17:00:00Z", both: "2026-11-21T17:00:00Z" }
      };
      const $ = id => document.getElementById(id);
      const form = $("seminar-form");
      const eventSelect = $("seminar-event");
      const ticketSelect = $("seminar-ticket");
      const attendeesInput = $("seminar-attendees");
      const message = $("seminar-form-message");
      const verifyButton = $("seminar-submit");
      const choices = $("seminar-payment-options");
      const applePayButton = $("seminar-applepay");
      const cardButton = $("seminar-card");
      const cashAppButton = $("seminar-cashapp");
      const cashAppInstructions = $("seminar-cashapp-instructions");
      const paymentButtons = [applePayButton, cardButton, cashAppButton];
      let reviewed = null;

      const names = () => attendeesInput.value.split(/\r?\n/).map(s => s.trim()).filter(Boolean);
      const dollars = cents => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(cents / 100);
      const ticketFor = (eventId, ticketId) => priceLists[eventId]?.find(item => item.id === ticketId);
      const isClosed = (eventId, ticketId) => Date.now() >= Date.parse(closingTimes[eventId]?.[ticketId] || "1970-01-01T00:00:00Z");

      function resetPaymentChoices() {
        reviewed = null;
        choices.hidden = true;
        cashAppInstructions.hidden = true;
        verifyButton.hidden = false;
        paymentButtons.forEach(button => { button.disabled = false; });
        message.textContent = "";
      }

      function setEvent(value) {
        eventSelect.value = value === "nerve" ? "nerve" : "united";
        ticketSelect.replaceChildren();
        priceLists[eventSelect.value].forEach(item => {
          const option = document.createElement("option");
          option.value = item.id;
          option.textContent = item.label;
          ticketSelect.appendChild(option);
        });
        resetPaymentChoices();
        updateTotal();
      }

      function updateTotal() {
        const tier = ticketFor(eventSelect.value, ticketSelect.value);
        if (!tier) return;
        const count = names().length || 1;
        $("seminar-total-label").textContent = tier.name + " × " + count + (count > 6 ? " (maximum 6)" : "");
        $("seminar-total-amount").textContent = dollars(tier.cents * count);
      }

      eventSelect.addEventListener("change", () => setEvent(eventSelect.value));
      ticketSelect.addEventListener("change", () => { resetPaymentChoices(); updateTotal(); });
      form.addEventListener("input", () => { resetPaymentChoices(); updateTotal(); });
      document.querySelectorAll(".select-seminar").forEach(selectButton => {
        selectButton.addEventListener("click", () => {
          setEvent(selectButton.dataset.event);
          $("registration").scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      const params = new URLSearchParams(location.search);
      setEvent(params.get("event") === "nerve" ? "nerve" : "united");
      if (params.get("checkout") === "cancelled") {
        message.textContent = "Checkout was cancelled. No registration has been confirmed. You can choose another payment method.";
      }

      // Do not mark a seminar paid based on a redirect alone.
      if (params.get("checkout") === "success") {
        const result = $("registration-result");
        result.hidden = false;
        form.hidden = true;
        const id = params.get("session_id") || "";
        const show = (heading, detail, note) => {
          $("registration-result-heading").textContent = heading;
          $("registration-result-detail").textContent = detail;
          $("registration-result-note").textContent = note || "";
        };
        if (!/^cs_live_[A-Za-z0-9_]{10,180}$/.test(id)) {
          show("We could not verify your payment", "Please call the studio with your Stripe receipt or checkout reference.", "Do not submit another payment until you have checked your existing charge.");
        } else {
          fetch("/api/seminar-checkout-status?session_id=" + encodeURIComponent(id), { cache: "no-store" })
            .then(async r => {
              const data = await r.json();
              if (!r.ok) throw new Error(data.error || "Unable to verify this payment.");
              return data;
            })
            .then(data => {
              if (data.confirmed) {
                const seminar = data.event === "united" ? "United by Purpose" : "Striking a Nerve";
                show("You're registered!", "Stripe confirms payment of " + dollars(data.amount) + " for " + data.quantity + " attendee" + (data.quantity === 1 ? "" : "s") + " at " + seminar + ".", "Keep your Stripe receipt. Questions? Call (410) 218-0894. One Tree. One Family.");
                try {
                  const key = "btmma_seminar_ga4_purchase_" + id;
                  if (window.sessionStorage.getItem(key) !== "sent") {
                    window.gtag?.("event", "purchase", {
                      transaction_id: id, currency: "USD", value: data.amount / 100,
                      items: [{ item_id: "btmma_seminar_" + data.event + "_" + data.ticket, item_name: seminar, quantity: data.quantity, price: data.amount / 100 / data.quantity }]
                    });
                    window.sessionStorage.setItem(key, "sent");
                  }
                } catch { /* Analytics cannot affect payment verification. */ }
              } else {
                show("Payment has not been confirmed", "Your checkout is not marked paid by Stripe yet.", "Do not pay again until checking your receipt or contacting the studio.");
              }
            })
            .catch(error => show("Verification is temporarily unavailable", error.message, "Please check your Stripe payment receipt or contact the studio before paying again."));
        }
      }

      form.addEventListener("submit", event => {
        event.preventDefault();
        const attendeeNames = names();
        if (attendeeNames.length < 1 || attendeeNames.length > 6 || attendeeNames.some(name => name.length < 2 || name.length > 75 || /[<>\r\n]/.test(name))) {
          resetPaymentChoices();
          message.textContent = "Enter 1 to 6 attendee names, one per line, with a valid full name for each person.";
          attendeesInput.focus();
          return;
        }
        if (isClosed(eventSelect.value, ticketSelect.value)) {
          resetPaymentChoices();
          message.textContent = "Registration for this seminar session has closed. Please contact the studio.";
          return;
        }
        const tier = ticketFor(eventSelect.value, ticketSelect.value);
        reviewed = {
          event: eventSelect.value,
          ticket: ticketSelect.value,
          contactName: $("seminar-contact-name").value.trim(),
          email: $("seminar-contact-email").value.trim(),
          phone: $("seminar-contact-phone").value.trim(),
          attendees: attendeeNames.join("\n"),
          count: attendeeNames.length,
          ticketName: tier.name,
          totalCents: tier.cents * attendeeNames.length
        };
        const total = dollars(reviewed.totalCents);
        $("seminar-reviewed-total").textContent = reviewed.ticketName + " × " + reviewed.count + " = " + total;
        applePayButton.textContent = "APPLE PAY / APPLE CASH — " + total;
        cardButton.textContent = "PAY " + total + " WITH CREDIT / DEBIT CARD";
        cashAppButton.textContent = "PAY " + total + " DIRECTLY WITH CASH APP";
        verifyButton.hidden = true;
        choices.hidden = false;
        cashAppInstructions.hidden = true;
        message.textContent = "Details reviewed. Choose your payment method below. Nothing has been charged.";
        choices.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });

      const openStripeCheckout = async () => {
        if (!reviewed || isClosed(reviewed.event, reviewed.ticket)) {
          message.textContent = "Please review your registration again before paying.";
          resetPaymentChoices();
          message.textContent = "Registration details must be reviewed before paying, or this session has closed.";
          return;
        }
        const token = document.querySelector("#seminar-form [name='cf-turnstile-response']")?.value || "";
        if (!token) {
          message.textContent = "Please complete the security check under the payment buttons to use card or Apple Pay.";
          $("seminar-payment-options").scrollIntoView({ behavior: "smooth", block: "nearest" });
          return;
        }
        paymentButtons.forEach(button => { button.disabled = true; });
        message.textContent = "Connecting to secure Stripe checkout. No charge has been made yet.";
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 20000);
        try {
          const r = await fetch("/api/seminar-checkout", {
            method: "POST", cache: "no-store",
            headers: { "content-type": "application/json" },
            signal: controller.signal,
            body: JSON.stringify({
              event: reviewed.event,
              ticket: reviewed.ticket,
              contactName: reviewed.contactName,
              email: reviewed.email,
              phone: reviewed.phone,
              attendees: reviewed.attendees,
              turnstileToken: token
            })
          });
          const data = await r.json().catch(() => ({}));
          if (!r.ok || !/^https:\/\/checkout\.stripe\.com\//.test(data.url || "")) throw new Error(data.error || "Could not open secure checkout.");
          window.location.assign(data.url);
        } catch (err) {
          message.textContent = err.message || "Checkout is unavailable. Please try again.";
          paymentButtons.forEach(button => { button.disabled = false; });
          window.turnstile?.reset?.();
        } finally {
          clearTimeout(timeout);
        }
      };
      applePayButton.addEventListener("click", openStripeCheckout);
      cardButton.addEventListener("click", openStripeCheckout);

      cashAppButton.addEventListener("click", () => {
        if (!reviewed || isClosed(reviewed.event, reviewed.ticket)) {
          resetPaymentChoices();
          message.textContent = "Please review the current seminar and ticket before paying.";
          return;
        }
        const eventName = reviewed.event === "united" ? "United by Purpose" : "Striking a Nerve";
        const note = "BTMMA " + eventName + " - " + reviewed.ticketName + " x " + reviewed.count;
        $("seminar-cashapp-amount").textContent = dollars(reviewed.totalCents);
        $("seminar-cashapp-note").textContent = note;
        $("seminar-cashapp-details").value = "Burning Tree seminar - Cash App payment\n" +
          "Event: " + eventName + "\n" +
          "Ticket: " + reviewed.ticketName + " x " + reviewed.count + "\n" +
          "Amount: " + dollars(reviewed.totalCents) + " to $BTMMA\n" +
          "Contact: " + reviewed.contactName + "\n" +
          "Email: " + reviewed.email + "\n" +
          "Phone: " + reviewed.phone + "\n" +
          "Attendees:\n" + reviewed.attendees + "\n" +
          "Payment confirmation: [attach Cash App receipt after paying]";
        choices.hidden = true;
        cashAppInstructions.hidden = false;
        message.textContent = "Direct Cash App selected. Your registration is pending until Burning Tree verifies payment.";
        cashAppInstructions.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });

      $("seminar-copy-details").addEventListener("click", async () => {
        const details = $("seminar-cashapp-details");
        try {
          await navigator.clipboard.writeText(details.value);
          $("seminar-copy-message").textContent = "Registration details copied. Paste into a text to (410) 218-0894 and attach your payment receipt.";
        } catch {
          details.focus();
          details.select();
          $("seminar-copy-message").textContent = "Details selected. Copy the text and send it to (410) 218-0894 with your receipt.";
        }
      });

      $("seminar-back-to-payments").addEventListener("click", () => {
        if (!reviewed) return;
        cashAppInstructions.hidden = true;
        choices.hidden = false;
        message.textContent = "Do not select another payment method if you've already sent a Cash App payment. Contact the studio instead.";
        choices.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    })();
  </script>
</BaseLayout>

