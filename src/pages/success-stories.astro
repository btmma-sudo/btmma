---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const stories = [
  {
    heading: "Finding Confidence and Discipline",
    quote: "My grandson has learned discipline, confidence and martial arts techniques. I am so glad my husband made the decision to enroll him, it was the best choice.",
    attribution: "Kelly W.",
    relationship: "Grandparent"
  },
  {
    heading: "A Place Their Child Loves",
    quote: "Best place ever for mixed martial arts. My child is super happy there, come and try today!",
    attribution: "Shoshana S.",
    relationship: "Parent"
  },
  {
    heading: "Lessons Beyond the Mats",
    quote: "This is the best place for kids to learn and practice Karate. And this place is just not about Karate but also the trainer helps kids to gain focus and teaches valuables lesson for life.",
    attribution: "Kamal N.",
    relationship: "Family review"
  },
  {
    heading: "A Great Martial Arts Experience",
    quote: "Great place to be for the best experience in martial arts.",
    attribution: "Zainab A.",
    relationship: "Community review"
  }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.primaryDomain },
    { "@type": "ListItem", position: 2, name: "Parent Success Stories", item: new URL("/success-stories", site.primaryDomain).toString() }
  ]
};

const questions = [
  {
    question: "Can martial arts help my child build confidence?",
    answer: "Our junior classes give students age-appropriate challenges, achievable goals and opportunities to practice new skills. Families on this page describe positive experiences with confidence and discipline; each child's progress is different."
  },
  {
    question: "Are Burning Tree martial arts classes suitable for beginners?",
    answer: "Yes. Children with no previous martial arts experience can start in junior Kenpo Karate, Muay Thai or Wing Chun. We introduce skills step by step and help families choose a class."
  },
  {
    question: "Where is Burning Tree Mixed Martial Arts located?",
    answer: "Our studio is at 10210 S Dolfield Rd, Owings Mills, MD 21117. We welcome families from Reisterstown, Pikesville, Randallstown and other Baltimore County communities."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer }
  }))
};
---

<BaseLayout
  title="Parent Reviews & Student Success Stories | Burning Tree MMA Owings Mills"
  description="Read real parent reviews and student success stories from Burning Tree MMA in Owings Mills, MD. See families discuss kids karate, confidence and focus."
  path="/success-stories"
  image="/images/kids-martial-arts-karate-guard.png"
  keywords={["Burning Tree MMA reviews", "Owings Mills martial arts reviews", "kids karate testimonials Owings Mills", "student success stories martial arts", "parent reviews kids martial arts Baltimore County"]}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="shell stories-hero" aria-labelledby="stories-title">
    <p class="eyebrow">One Tree. One Family.</p>
    <h1 id="stories-title">Parent Reviews &amp; Student Success Stories in Owings Mills</h1>
    <p class="stories-lead">Every student arrives with a different story. Families at Burning Tree Mixed Martial Arts in Owings Mills share what their children have gained through training—from growing confidence to stronger focus and discipline.</p>
    <p>Real Families. Real Progress. Real Confidence.</p>
    <a href="/29-trial" class="button">Start With 2 Classes + Free Uniform for $29</a>
  </section>

  <section class="shell section-divider" aria-labelledby="why-families">
    <article class="detail-card story-invite">
      <p class="eyebrow">Kids Martial Arts in Baltimore County</p>
      <h2 id="why-families">What Parents Look for in a Martial Arts School</h2>
      <p>When families choose kids martial arts classes in Owings Mills, they often want more than exercise. They look for an encouraging place where children can practice listening, build self-control, make steady progress and feel welcomed. At Burning Tree MMA, our <a href="/kids-martial-arts">junior martial arts programs</a> combine guided instruction with age-appropriate goals.</p>
      <p>Students can explore <a href="/kenpo-karate">American Kenpo Karate</a>, <a href="/muay-thai">Muay Thai</a> and <a href="/wing-chun">Wing Chun</a>. Every student's journey is different, and we encourage families to judge the experience for themselves through a beginner class.</p>
      <p>Our Owings Mills location welcomes nearby families from Reisterstown, Pikesville, Randallstown and across Baltimore County. Learn <a href="/your-first-class">what to expect at your first class</a> before visiting.</p>
    </article>
  </section>

  <section class="shell section-divider" aria-labelledby="student-moments">
    <div class="section-heading">
      <div>
        <p class="eyebrow">From Our Own Training Mats</p>
        <h2 id="student-moments">Student Moments Worth Celebrating</h2>
        <p>Real photos from Burning Tree classes and achievements. These are snapshots of our school community, shown separately from individual family reviews.</p>
      </div>
    </div>
    <div class="student-moments-grid">
      <figure><img src="/images/kids-martial-arts-karate-guard.png" alt="Young Burning Tree student practicing a karate guard" width="750" height="580" loading="lazy" decoding="async" /><figcaption>Learning Karate Fundamentals</figcaption></figure>
      <figure><img src="/images/kids-martial-arts-bag-training.png" alt="Young Burning Tree students practicing strikes with a training bag" width="750" height="580" loading="lazy" decoding="async" /><figcaption>Building Skills With Practice</figcaption></figure>
      <figure><img src="/images/kids-martial-arts-smiling-student.png" alt="Young Burning Tree martial arts student smiling in class" width="750" height="580" loading="lazy" decoding="async" /><figcaption>Confidence on the Mats</figcaption></figure>
    </div>
  </section>

  <section class="shell section-divider" aria-labelledby="parent-voices">
    <div class="section-heading">
      <div>
        <p class="eyebrow">In Their Own Words</p>
        <h2 id="parent-voices">What Our Families Are Saying</h2>
        <p>These testimonials are reproduced from reviews already featured on our website. They are the families' own words, not invented student outcomes.</p>
      </div>
    </div>
    <div class="stories-grid">
      {stories.map(story => (
        <article class="story-card">
          <p class="eyebrow">Family Experience</p>
          <h3>{story.heading}</h3>
          <blockquote>
            <p>“{story.quote}”</p>
            <footer>— {story.attribution} · {story.relationship}</footer>
          </blockquote>
        </article>
      ))}
    </div>
    <p class="google-review-note">Want to read more feedback? <a href="https://www.google.com/search?q=Burning+Tree+Mixed+Martial+Arts%2C+South+Dolfield+Road%2C+Owings+Mills%2C+MD" target="_blank" rel="noopener noreferrer">Read Our Google Reviews</a>.</p>
  </section>

  <section class="shell section-divider">
    <div class="detail-card story-invite">
      <p class="eyebrow">Every Milestone Matters</p>
      <h2>Confidence. Focus. Discipline. Belonging.</h2>
      <p>Sometimes success is a first class completed. Sometimes it's asking a question with confidence, learning a new technique, or earning a belt after weeks of practice. Our instructors celebrate every student's progress at their own pace.</p>
      <p>Want to share your family's experience? Call or text <a href={`tel:${site.phoneHref}`}>{site.phone}</a>. With your permission, we can feature your words and an approved photo of your student on this page. Student names and photographs are never added here without appropriate permission.</p>
    </div>
  </section>

  <section class="shell section-divider">
    <div class="story-cta">
      <p class="eyebrow">Your Child's Story Could Be Next</p>
      <h2>Come See What Burning Tree Can Mean for Your Family</h2>
      <p>Explore beginner-friendly American Kenpo Karate, Muay Thai and Wing Chun classes in Owings Mills. No prior martial arts experience is required.</p>
      <a class="button" href="/29-trial">Claim the $29 New Student Special</a>
      <p><a href="/kids-martial-arts">Explore Kids Martial Arts</a> · <a href="/your-first-class">What to Expect at Your First Class</a></p>
    </div>
  </section>

</BaseLayout>

<style>
  .stories-hero { padding-top: 4rem; padding-bottom: 3rem; max-width: 1040px; }
  .stories-hero h1 { max-width: 850px; line-height: 1.1; }
  .stories-lead { max-width: 770px; font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.65; margin: 1.4rem 0 2rem; }
  .student-moments-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:1.4rem; }
  .student-moments-grid figure { margin:0; background:#1b1b1b; border:1px solid #543030; min-width:0; }
  .student-moments-grid img { display:block; width:100%; aspect-ratio:4 / 3; height:auto; object-fit:contain; background:#111; }
  .student-moments-grid figcaption { padding:.8rem 1rem; font-weight:700; }
  .google-review-note { margin-top: 1.5rem; }
  .stories-faq-grid { display:grid; gap:1rem; grid-template-columns:repeat(3,minmax(0,1fr)); margin:1.4rem 0; }\n  .stories-faq-grid h3 { font-size:1.2rem; line-height:1.3; }\n  .stories-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.25rem; margin-top: 1.4rem; }
  .story-card { background: #1b1b1b; border: 1px solid #543030; border-top: 3px solid #b52525; padding: 1.6rem; min-width: 0; }
  .story-card h3 { margin: .4rem 0 1.2rem; }
  .story-card blockquote { margin: 0; }
  .story-card blockquote p { line-height: 1.7; color: #f1f1f1; }
  .story-card footer { margin-top: 1.2rem; font-weight: 700; color: #fff; }
  .story-invite { padding: 2rem; }
  .story-invite p { max-width: 850px; }
  .story-cta { background: #1b1b1b; border: 1px solid #543030; text-align: center; padding: 3rem 1.6rem; }
  .story-cta p { max-width: 740px; margin-left: auto; margin-right: auto; }
  .story-cta .button { margin: 1rem 0; }
  @media (max-width: 800px) { .stories-faq-grid { grid-template-columns:1fr; } .student-moments-grid { grid-template-columns:1fr; } .stories-grid { grid-template-columns: 1fr; } .stories-hero { padding-top: 2.5rem; } .story-cta { padding: 2rem 1rem; } }
</style>
