---
import BaseLayout from "../layouts/BaseLayout.astro";
import { weeklySchedule, formatClassTime } from "../data/schedule";
import { site } from "../data/site";

const adultSchedule = weeklySchedule
  .map((day) => ({
    day: day.day,
    slots: day.slots.filter((slot) => slot.cls.startsWith("Teens & Adults") || slot.cls.startsWith("Women's Self-Defense"))
  }))
  .filter((day) => day.slots.length > 0);

const womensClass = weeklySchedule
  .flatMap((day) => day.slots
    .filter((slot) => slot.cls.startsWith("Women's Self-Defense"))
    .map((slot) => ({ day: day.day, ...slot })))[0];

const faqs = [
  {
    question: "Can I start martial arts as an adult with no experience?",
    answer: "Absolutely. Our teens and adults classes welcome beginners. We introduce fundamentals, demonstrate techniques, and help you build confidence at a pace that works for your experience level."
  },
  {
    question: "Do I need to be in shape before starting?",
    answer: "No. You don't have to get fit before joining martial arts. Classes involve movement and physical training, and you can speak with an instructor about your comfort level and any limitations before you begin."
  },
  {
    question: "What martial arts do you teach teens and adults?",
    answer: "We offer American Kenpo Karate, Muay Thai, and Wing Chun. Each has a different focus: practical self-defense and forms in Kenpo, striking and conditioning in Muay Thai, and close-range technique and efficiency in Wing Chun."
  },
  {
    question: "Which martial art should I choose for self-defense?",
    answer: "All three programs teach useful skills in different ways. Kenpo emphasizes practical self-defense techniques, Muay Thai develops striking fundamentals, and Wing Chun focuses on distance, timing, and efficient movement. Contact us and we'll help you choose a starting class."
  },
  {
    question: "Do adults have to spar or compete?",
    answer: "Competition is not a prerequisite for getting started. Ask your instructor about partner drills, sparring, and the expectations for the class you choose so you can make an informed decision."
  },
  {
    question: "When are your teens and adults classes?",
    answer: "Kenpo is Monday evening, Muay Thai is Tuesday and Thursday evenings, and Wing Chun is Wednesday evening. We also list a teens and adults open mat on Saturday mornings. Check the weekly schedule on this page for current times."
  },
  {
    question: "What should I bring to my first martial arts class?",
    answer: "Wear comfortable workout clothes and bring water. If you're a new student, our $29 introductory special includes two beginner classes and a free uniform."
  },
  {
    question: "How much does it cost to try a class?",
    answer: "New students can start with two beginner classes and a free uniform for $29. Contact Burning Tree to discuss ongoing training and the program that best fits your goals."
  },
  {
    question: "Can I join adult martial arts classes if I am over 40 or returning after years away?",
    answer: "Many people begin or return to martial arts as adults. You can discuss your goals, experience, and any physical limitations with an instructor to decide whether a class is suitable for you."
  },
  {
    question: "Are there evening martial arts classes after work or school?",
    answer: "Yes. Our teens and adults Kenpo class meets Monday evening, Muay Thai meets Tuesday and Thursday evenings, and Wing Chun meets Wednesday evening. The up-to-date class times appear in the schedule on this page."
  },
  {
    question: "What is the difference between adult Kenpo Karate and Muay Thai?",
    answer: "American Kenpo includes structured self-defense techniques, striking, forms, and progression through a curriculum. Muay Thai places more emphasis on active striking combinations, kicks, footwork, and pad work. Both welcome beginners."
  },
  {
    question: "Can teenagers attend the same martial arts classes as adults?",
    answer: "Our published schedule includes combined Teens & Adults classes for Kenpo, Muay Thai, and Wing Chun. Contact us if you're unsure about the right placement for a specific teenager."
  },
  {
    question: "Do you offer women's self-defense classes as well?",
    answer: "Yes. Burning Tree offers a separate Women's Self-Defense / Sanuces program taught by Coach Dana Marable II and Coach Devan Young. Classes focus on awareness, escape fundamentals, and practical self-defense skills. Sunday class times appear in the weekly schedule above."
  },
  {
    question: "Do I need previous training to join women's self-defense?",
    answer: "No prior martial arts experience is needed to ask about joining. Contact us to discuss class placement, your goals, and any physical limitations before you begin."
  },
  {
    question: "What does the women's self-defense class teach?",
    answer: "Our Sanuces-focused women's self-defense training emphasizes situational awareness, movement, practical escapes, and responding to common grabs or holds. Specific drills are supervised and adapted to the class."
  },
  {
    question: "Where can I take adult karate or Muay Thai near Owings Mills?",
    answer: "Burning Tree Mixed Martial Arts is located at 10210 S Dolfield Rd, Owings Mills, MD 21117. We welcome teens and adults from Owings Mills, Reisterstown, Pikesville, Randallstown, and surrounding Baltimore County communities."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Teen, Adult and Women's Self-Defense Classes in Owings Mills, Maryland",
  description: "Beginner-friendly American Kenpo Karate, Muay Thai, Wing Chun and women's self-defense / Sanuces training at Burning Tree Mixed Martial Arts.",
  serviceType: ["Teen and adult martial arts instruction", "Women's self-defense instruction"],
  url: new URL("/teens-adults-martial-arts/", site.primaryDomain).toString(),
  inLanguage: "en-US",
  areaServed: [
    { "@type": "City", name: "Owings Mills" },
    { "@type": "AdministrativeArea", name: "Baltimore County", containedInPlace: { "@type": "State", name: "Maryland" } }
  ],
  provider: {
    "@type": "SportsActivityLocation",
    name: site.name,
    url: site.primaryDomain,
    telephone: site.phone,
    address: {
      "@type": "PostalAddress",
      streetAddress: site.addressLine1,
      addressLocality: site.city,
      addressRegion: site.region,
      postalCode: site.postalCode,
      addressCountry: "US"
    }
  },
  offers: {
    "@type": "Offer",
    name: "New Student Special: Two Beginner Classes and a Free Uniform",
    price: "29",
    priceCurrency: "USD",
    url: new URL("/29-trial", site.primaryDomain).toString()
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.primaryDomain },
    {
      "@type": "ListItem",
      position: 2,
      name: "Teens & Adults Martial Arts",
      item: new URL("/teens-adults-martial-arts/", site.primaryDomain).toString()
    }
  ]
};
---

<BaseLayout
  title="Teen & Adult Martial Arts and Women's Self-Defense | Owings Mills"
  description="Explore adult karate, teen martial arts, Muay Thai, Wing Chun and women's self-defense in Owings Mills, MD. Beginner-friendly training at Burning Tree MMA."
  keywords={["adult martial arts Owings Mills", "adult karate Owings Mills MD", "martial arts for teens Owings Mills", "beginner adult karate classes Baltimore County", "Muay Thai classes Owings Mills", "Wing Chun classes Owings Mills", "adult self-defense classes Owings Mills", "women's self-defense Owings Mills", "Sanuces women's self-defense Baltimore County", "martial arts beginners near Reisterstown", "evening martial arts classes Owings Mills"]}
  path="/teens-adults-martial-arts/"
  image="/images/adult-martial-arts-hero.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="ta-page">
    <section class="ta-hero" aria-labelledby="ta-heading">
      <div class="shell ta-hero-grid">
        <div class="ta-hero-copy">
          <nav class="ta-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true"> / </span><span>Teens & Adults Martial Arts</span>
          </nav>
          <p class="ta-eyebrow">TEEN & ADULT MARTIAL ARTS • OWINGS MILLS, MD</p>
          <h1 id="ta-heading">Teen &amp; Adult Martial Arts in Owings Mills. <em>Discover what you're capable of.</em></h1>
          <p class="ta-hero-subhead">Beginner-friendly martial arts classes for teens and adults in Owings Mills—built around real skills, stronger confidence, and steady progress.</p>
          <p class="ta-hero-lead">Maybe you've always wanted to learn self-defense. Maybe you're ready for a challenge beyond the gym. Or maybe you just want to feel more confident in yourself. Whether you're a teen trying your first class, an adult beginner, or someone returning after a break, you don't need experience to take the first step.</p>
          <div class="ta-hero-actions">
            <a class="ta-button" href="/29-trial">Try 2 Classes + a FREE Uniform for $29</a>
            <a class="ta-text-link ta-text-link-light" href="#ta-programs">Explore Our Classes →</a>
          </div>
          <p class="ta-hero-note">New students only • Questions? <a href={"tel:" + site.phoneHref}>{site.phone}</a></p>
        </div>
        <div class="ta-hero-photo">
          <img src="/images/adult-martial-arts-hero.jpg" alt="Teen and adult martial artists training together at Burning Tree Mixed Martial Arts in Owings Mills" width="1000" height="750" fetchpriority="high" />
          <div class="ta-photo-stamp"><strong>ONE TREE.</strong><span>ONE FAMILY.</span></div>
        </div>
      </div>
    </section>

    <section class="ta-benefits" aria-labelledby="ta-benefits-heading">
      <div class="shell">
        <p class="ta-eyebrow">MORE THAN ANOTHER WORKOUT</p>
        <h2 id="ta-benefits-heading">Training that gives you something to work toward.</h2>
        <div class="ta-benefit-grid">
          <article><span aria-hidden="true">01</span><h3>Practical Self-Defense</h3><p>Build awareness, movement, and martial arts fundamentals through consistent, supervised practice.</p></article>
          <article><span aria-hidden="true">02</span><h3>Fitness With Purpose</h3><p>Get moving, challenge your coordination, and work on strength and endurance while learning new skills.</p></article>
          <article><span aria-hidden="true">03</span><h3>Confidence & Discipline</h3><p>Learn techniques one step at a time. Showing up, practicing, and making progress create reasons to be proud.</p></article>
          <article><span aria-hidden="true">04</span><h3>A Community That Supports You</h3><p>Train alongside people who want to improve, learn from one another, and support each other's efforts.</p></article>
        </div>
      </div>
    </section>

    <section class="ta-programs shell" id="ta-programs" aria-labelledby="ta-programs-heading">
      <p class="ta-eyebrow">FIND YOUR STYLE</p>
      <h2 id="ta-programs-heading">Three martial arts. Your next chapter.</h2>
      <p class="ta-intro">Whether you're a teenager trying martial arts for the first time or an adult returning to training, we'll help you find a class that fits your goals. You can begin without a martial arts background.</p>
      <div class="ta-program-grid">
        <article class="ta-program-card">
          <img src="/images/adult-martial-arts-gallery-1.jpg" alt="Adults wearing black martial arts uniforms practicing control techniques during Kenpo training" loading="lazy" decoding="async" width="600" height="440" />
          <div class="ta-program-body">
            <p class="ta-program-label">MONDAY EVENINGS</p>
            <h3>American Kenpo Karate</h3>
            <p>Our American Kenpo Karate classes for teens and adults introduce practical self-defense concepts, striking combinations, forms, and the discipline of a structured belt-progression system. You can begin with basic movements and build toward more detailed techniques through guided practice.</p>
            <a href="/kenpo-karate">Explore Kenpo Karate <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <article class="ta-program-card">
          <img src="/images/burning-tree-muay-thai-female.webp" alt="Female Muay Thai student delivering a controlled kick to a coach holding pads in the martial arts studio" loading="lazy" decoding="async" width="600" height="400" />
          <div class="ta-program-body">
            <p class="ta-program-label">TUESDAY & THURSDAY EVENINGS</p>
            <h3>Muay Thai</h3>
            <p>Adult Muay Thai classes focus on punches, kicks, footwork, pad work, and combinations through controlled striking drills. It's an active option for students looking to build coordination, work on conditioning, and learn practical striking fundamentals.</p>
            <a href="/muay-thai">Explore Muay Thai <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <article class="ta-program-card">
          <img src="/images/wing-chun-gallery-1.jpg" alt="Wing Chun students practicing close-range defense and striking drills with a training partner" loading="lazy" decoding="async" width="600" height="440" />
          <div class="ta-program-body">
            <p class="ta-program-label">WEDNESDAY EVENINGS</p>
            <h3>Wing Chun</h3>
            <p>Our teen and adult Wing Chun classes explore centerline theory, efficient movement, timing, and close-range defensive techniques through controlled partner practice. Students develop precision and awareness while learning a system that emphasizes skill over brute force.</p>
            <a href="/wing-chun">Explore Wing Chun <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </section>

    <section class="ta-womens" id="womens-self-defense" aria-labelledby="ta-womens-heading">
      <div class="shell ta-womens-grid">
        <div class="ta-womens-image">
          <img src="/images/womens-defense-hero.jpg" alt="Women's self-defense martial arts training at Burning Tree Mixed Martial Arts in Owings Mills" width="900" height="680" loading="lazy" decoding="async" />
        </div>
        <div class="ta-womens-copy">
          <p class="ta-eyebrow">WOMEN'S SELF-DEFENSE • SANUCES RYU JUJITSU</p>
          <h2 id="ta-womens-heading">Women's Self-Defense Classes in Owings Mills</h2>
          <p class="ta-womens-intro">Feel more prepared, more aware, and more confident. Our dedicated women's self-defense program teaches practical martial arts skills for everyday situations in a supportive learning environment.</p>
          <p>Learn from <strong>Coach Dana Marable II</strong>, a 2nd Degree Black Belt in Sanuces Ryu Jujitsu and retired U.S. Army veteran, and <strong>Coach Devan Young</strong>, a 1st Dan Black Belt in Sanuces Ryu Jujutsu. Together, they guide practical self-defense and Sanuces training through supervised practice—not competition.</p>
          <ul class="ta-womens-benefits">
            <li>Situational awareness and recognizing potential danger</li>
            <li>Foundational escapes from grabs and holds</li>
            <li>Balance, movement, control and practical defensive options</li>
            <li>Confidence, personal boundaries and continued skill-building</li>
          </ul>
          {womensClass && (
            <p class="ta-womens-time"><strong>{womensClass.day} Women's Self-Defense / Sanuces</strong><span>{formatClassTime(womensClass.start, womensClass.end)}</span></p>
          )}
          <div class="ta-womens-actions">
            <a class="ta-button" href="/womens-defense">Explore Women's Self-Defense</a>
            <a class="ta-text-link" href={"tel:" + site.phoneHref}>Questions? Call {site.phone}</a>
          </div>
          <p class="ta-womens-note">Beginners can contact us about joining; ask about class suitability and current enrollment before attending.</p>
        </div>
      </div>
    </section>

    <section class="ta-compare shell" aria-labelledby="ta-compare-heading">
      <p class="ta-eyebrow">COMPARE YOUR OPTIONS</p>
      <h2 id="ta-compare-heading">Adult karate vs. Muay Thai vs. Wing Chun: which class should you try?</h2>
      <p class="ta-intro">There's no one-size-fits-all answer. The right martial arts class depends on whether you enjoy structured karate training, energetic striking practice, or technical close-range drills. Here's what to expect from each program at Burning Tree.</p>
      <div class="ta-compare-grid">
        <article>
          <h3>Kenpo Karate</h3>
          <p><strong>A good starting point if you want:</strong> a traditional martial arts path with progressive techniques, forms, and self-defense applications.</p>
          <p><strong>Practice includes:</strong> strikes, blocks, movement patterns, and guided partner technique.</p>
          <a href="/kenpo-karate">Learn more about Kenpo Karate →</a>
        </article>
        <article>
          <h3>Muay Thai</h3>
          <p><strong>A good starting point if you want:</strong> an active striking class that also challenges your conditioning and coordination.</p>
          <p><strong>Practice includes:</strong> punches, kicks, footwork, combinations, and pad drills.</p>
          <a href="/muay-thai">Learn more about Muay Thai →</a>
        </article>
        <article>
          <h3>Wing Chun</h3>
          <p><strong>A good starting point if you want:</strong> a technique-focused art centered on timing, distance, and precise movements.</p>
          <p><strong>Practice includes:</strong> centerline fundamentals, close-range drills, and controlled partner work.</p>
          <a href="/wing-chun">Learn more about Wing Chun →</a>
        </article>
      </div>
      <p class="ta-compare-note">Still undecided? <a href={"tel:" + site.phoneHref}>Call {site.phone}</a> and tell us what you're looking for. We'll help you choose a class to try first.</p>
    </section>

    <section class="ta-chooser" aria-labelledby="ta-chooser-heading">
      <div class="shell ta-chooser-inner">
        <div>
          <p class="ta-eyebrow">NOT SURE WHERE TO START?</p>
          <h2 id="ta-chooser-heading">You don't have to pick the perfect martial art before you walk in.</h2>
          <p>Want traditional karate and self-defense? Start by exploring <a href="/kenpo-karate">Kenpo</a>. Want striking drills and conditioning? Look at <a href="/muay-thai">Muay Thai</a>. Interested in precise close-range techniques? Try <a href="/wing-chun">Wing Chun</a>.</p>
          <p>Tell us what you're interested in, and we'll help you choose a good first class.</p>
          <a class="ta-button" href="/29-trial">Get Started for $29</a>
        </div>
        <div class="ta-chooser-points">
          <p><strong>No experience necessary</strong><span>New students are welcome.</span></p>
          <p><strong>No need to get in shape first</strong><span>Talk with our instructors about your current fitness and comfort level.</span></p>
          <p><strong>Real progress, one class at a time</strong><span>Give yourself the chance to learn something new.</span></p>
        </div>
      </div>
    </section>

    <section class="ta-start-paths shell" aria-labelledby="ta-paths-heading">
      <p class="ta-eyebrow">THERE'S A PLACE TO START</p>
      <h2 id="ta-paths-heading">Martial arts for teens, adult beginners, and people starting again</h2>
      <div class="ta-paths-grid">
        <article>
          <h3>Martial arts for teens</h3>
          <p>For teenagers looking for a new challenge beyond school or sports, martial arts offers a chance to practice focus, responsibility, and controlled movement. Our teens and adults classes introduce real techniques in a training environment that values respect and effort.</p>
        </article>
        <article>
          <h3>Beginner martial arts for adults</h3>
          <p>Never trained before? That's fine. You don't have to know a stance, memorize a combination, or already be in peak shape. Ask questions, learn the fundamentals, and build confidence through repetition.</p>
        </article>
        <article>
          <h3>Coming back after time away</h3>
          <p>If you used to practice karate or another martial art, you don't need to pick up exactly where you left off. Talk with an instructor about your background and comfort level, then find a practical way to return to training.</p>
        </article>
      </div>
      <p class="ta-paths-note">Interested in a program focused specifically on women's self-defense? <a href="/womens-defense">Explore our Women's Self-Defense classes</a>.</p>
    </section>

    <section class="ta-first shell" aria-labelledby="ta-first-heading">
      <div class="ta-first-grid">
        <div>
          <p class="ta-eyebrow">YOUR FIRST CLASS</p>
          <h2 id="ta-first-heading">New to martial arts? That's exactly where everyone starts.</h2>
          <p>Walking into a martial arts school for the first time can feel intimidating. It doesn't have to be. Come ready to learn, ask questions, and work through the basics.</p>
        </div>
        <ol class="ta-steps">
          <li><span>1</span><div><h3>Tell us your goal.</h3><p>Self-defense, fitness, confidence, or simply trying something new—we'll help point you toward a program.</p></div></li>
          <li><span>2</span><div><h3>Show up and start learning.</h3><p>Wear comfortable athletic clothes, bring water, and let us know you're new.</p></div></li>
          <li><span>3</span><div><h3>Build on your first class.</h3><p>Practice, ask questions, and discover what you can accomplish with consistent training.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="ta-schedule" aria-labelledby="ta-schedule-heading">
      <div class="shell">
        <p class="ta-eyebrow">FIND YOUR TRAINING TIME</p>
        <h2 id="ta-schedule-heading">Teen, adult & women's self-defense class schedule</h2>
        <p class="ta-intro">These class times come from our shared school schedule, so updates to the schedule carry through to this page.</p>
        <div class="ta-schedule-grid">
          {adultSchedule.map((day) => (
            <article class="ta-schedule-day">
              <h3>{day.day}</h3>
              <ul>
                {day.slots.map((slot) => (
                  <li><strong>{slot.cls}</strong><span>{formatClassTime(slot.start, slot.end)}</span></li>
                ))}
              </ul>
            </article>
          ))}
        </div>
        <p class="ta-schedule-note">Class placement and attendance may depend on experience and instructor guidance. Contact us with questions about your first class or Saturday open mat.</p>
        <a class="ta-button" href="/29-trial">Claim Your $29 New Student Special</a>
      </div>
    </section>

    <section class="ta-community shell" aria-labelledby="ta-community-heading">
      <div class="ta-community-grid">
        <img src="/images/adult-martial-arts-gallery-3.jpg" alt="Adult martial arts partners practicing blocking and hand techniques together at Burning Tree MMA" width="700" height="530" loading="lazy" decoding="async" />
        <div>
          <p class="ta-eyebrow">ONE TREE. ONE FAMILY.</p>
          <h2 id="ta-community-heading">More than a place to work out.</h2>
          <p>At Burning Tree, you're not just showing up to burn calories. You're learning skills, building habits, and training alongside people who want to see you succeed.</p>
          <p>We welcome teens who want a positive challenge, adults getting back into an active routine, and people who have always been curious about martial arts but weren't sure where to begin.</p>
          <a class="ta-text-link" href="/about">Get to know Burning Tree →</a>
        </div>
      </div>
    </section>

    <section class="ta-gallery" aria-labelledby="ta-gallery-heading">
      <div class="shell">
        <p class="ta-eyebrow">REAL MOMENTS AT BURNING TREE</p>
        <h2 id="ta-gallery-heading">Real people. Real training. Real progress.</h2>
        <p class="ta-intro">There's more to martial arts than learning a technique. It's the practice, the encouragement, and the moments when students see how far they've come. Here's a look inside the Burning Tree family.</p>
        <div class="ta-gallery-grid">
          <figure class="ta-gallery-feature">
            <img src="/images/burning-tree-adult-striking-drill.webp" alt="Adults at Burning Tree Mixed Martial Arts practicing a controlled punch and defensive technique with training partners in Owings Mills" width="900" height="1200" loading="lazy" decoding="async" />
            <figcaption><strong>Learn by doing.</strong><span>Adult martial arts students working on a partner technique in class.</span></figcaption>
          </figure>
          <div class="ta-gallery-more">
            <figure class="ta-gallery-team">
              <img src="/images/burning-tree-kenpo-team.webp" alt="Burning Tree MMA martial arts instructors and students of different ages posing together in black uniforms after a belt achievement" width="1200" height="873" loading="lazy" decoding="async" />
              <figcaption><strong>One Tree. One Family.</strong><span>Our martial arts community grows together.</span></figcaption>
            </figure>
            <figure>
              <img src="/images/burning-tree-belt-achievements.webp" alt="Martial arts instructor and younger students smiling while holding their Burning Tree belt rank achievement certificates" width="1200" height="900" loading="lazy" decoding="async" />
              <figcaption><strong>Every milestone matters.</strong><span>Recognizing the effort behind each step forward.</span></figcaption>
            </figure>
            <figure>
              <img src="/images/burning-tree-teen-kenpo-training.webp" alt="Teen martial arts student in a black uniform with a yellow belt kneeling on the training mats during a Kenpo session" width="900" height="1170" loading="lazy" decoding="async" />
              <figcaption><strong>Practice builds confidence.</strong><span>Showing up and putting in the work.</span></figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="ta-local" aria-labelledby="ta-local-heading">
      <div class="shell ta-local-grid">
        <div>
          <p class="ta-eyebrow">YOUR LOCAL MARTIAL ARTS SCHOOL</p>
          <h2 id="ta-local-heading">Martial arts for teens and adults in Owings Mills, Maryland</h2>
          <p>Looking for adult karate, Muay Thai, Wing Chun, or beginner self-defense classes near Owings Mills? Burning Tree Mixed Martial Arts welcomes students from Reisterstown, Pikesville, Randallstown, and surrounding Baltimore County communities.</p>
          <address><strong>{site.name}</strong><span>{site.addressLine1}, {site.city}, {site.region} {site.postalCode}</span><a href={"tel:" + site.phoneHref}>{site.phone}</a></address>
          <div class="ta-local-actions">
            <a class="ta-button" href="/29-trial">Try Two Classes for $29</a>
            <a class="ta-text-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Get Directions →</a>
          </div>
        </div>
        <aside>
          <h3>Why begin at Burning Tree?</h3>
          <ul>
            <li>Beginner-friendly teen and adult martial arts classes</li>
            <li>Kenpo Karate, Muay Thai, and Wing Chun</li>
            <li>Weeknight classes and Saturday open mat</li>
            <li>Practical training in a community-focused school</li>
            <li>New student offer: two classes and a uniform for $29</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="ta-faq shell" aria-labelledby="ta-faq-heading">
      <p class="ta-eyebrow">FREQUENTLY ASKED QUESTIONS</p>
      <h2 id="ta-faq-heading">Questions about starting martial arts as a teen or adult?</h2>
      <div class="ta-faq-list">
        {faqs.map((faq) => (
