---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProgramDetail from "../components/ProgramDetail.astro";
import ProgramDetailVariant from "../components/ProgramDetailVariant.astro";
import ProgramLocalSEO from "../components/ProgramLocalSEO.astro";
import ChimpmanGiPage from "../components/ChimpmanGiPage.astro";
import LeadForm from "../components/LeadForm.astro";
import WellnessBooking from "../components/WellnessBooking.astro";
import BirthdayPartyBooking from "../components/BirthdayPartyBooking.astro";
import { programPages } from "../data/site";

export function getStaticPaths() {
  return programPages.map((program) => ({
    params: { slug: program.slug },
    props: { program }
  }));
}

const { program } = Astro.props;
const isChimpmanGi  = program.slug === "chimpman-gi";
const isWellness    = program.slug === "health-and-wellness";
const isBirthday    = program.slug === "birthday-parties";
const isWomensDefense = program.slug === "womens-defense";
const variantDescriptions: Record<string, string> = {
  "kenpo-karate": "Build confidence, discipline, and practical self-defense skills through American Kenpo Karate for kids, teens, and adults.",
  "muay-thai": "Learn powerful striking fundamentals, footwork, and pad work in welcoming Muay Thai classes for kids, teens, and adults.",
  "wing-chun": "Discover centerline control, timing, and precise close-range techniques through real Wing Chun partner training on Wednesdays.",
  "womens-defense": "Build real-world self-defense skills, awareness, and confidence through practical Women’s Self-Defense and Sanuces training on Sundays."
};
const hasVariants   = !!program.variants?.length;
const showLeadForm  = program.showLeadForm !== false && !isBirthday && !isWomensDefense;
const centerContent = !isWellness && !isBirthday;
const useSplitLayout = !isChimpmanGi && !isWellness && !isBirthday && !hasVariants && showLeadForm;

const curriculumBlocks = !hasVariants ? program.curriculum.copy.split("\n\n") : [];
---

<BaseLayout
  title={program.seo.title}
  description={program.seo.description}
  path={`/${program.slug}`}
  keywords={program.seo.keywords}
  image={program.hero.image}
  theme={program.accentTheme ?? "flame"}>
  {isChimpmanGi ? (
    <ChimpmanGiPage program={program} />
  ) : (
    <>
      {(hasVariants || isWomensDefense) ? (
        <section class="program-variant-hero" aria-labelledby="program-variant-heading">
          <div class="shell program-variant-hero-grid">
            <div class="program-variant-hero-copy">
              <p class="program-variant-kicker">
                {isWomensDefense ? "WOMEN’S SELF-DEFENSE & SANUCES • SUNDAYS • OWINGS MILLS, MD" : program.slug === "wing-chun" ? "WEDNESDAY WING CHUN • OWINGS MILLS, MD" : "KIDS, TEENS & ADULTS • OWINGS MILLS, MD"}
              </p>
              <h1 id="program-variant-heading">{program.hero.title}</h1>
              <p>{variantDescriptions[program.slug]}</p>
              {isWomensDefense ? (
                <a class="button program-variant-cta" href="tel:+16673359592">Questions? Call Coach Dana</a>
              ) : (
                <>
                  <a class="button program-variant-cta" href="/29-trial">Start With 2 Classes for $29</a>
                  <p class="program-variant-offer">Includes a free uniform for new students.</p>
                </>
              )}
            </div>
            <figure class="program-variant-hero-photo">
              <img
                src={program.hero.image}
                alt={program.hero.imageAlt ?? program.hero.title}
                width="1200"
                height="900"
                loading="eager"
                decoding="async"
                fetchpriority="high" />
            </figure>
          </div>
        </section>
      ) : (
        <PageHero hero={program.hero} showMobileCta={showLeadForm} ctaLabel={program.mobileCta} centerMobile={isWellness} centerContent={centerContent} />
      )}

      {isBirthday && <BirthdayPartyBooking />}
      {isBirthday && (
        <div id="birthday-fallback" class="hero-form-float" hidden>
          <LeadForm config={{ ...program.leadForm, title: "Ask About a Birthday Party", intro: "Need help planning a birthday party? Send your contact details and preferred date, and our team will help you with availability." }} formId="birthday-fallback-lead" />
        </div>
      )}

      {useSplitLayout ? (
        <section class="shell section-divider">
          <div class="program-split">
            <div class="program-split-left">
              <LeadForm config={program.leadForm} />
            </div>
            <article class="detail-card detail-card-feature program-split-right">
              <p class="eyebrow">{program.audience}</p>
              <h2>{program.curriculum.title}</h2>
              <div class="program-copy">
                {curriculumBlocks.map((block) =>
                  block.startsWith("- ") ? (
                    <ul class="program-copy-list">
                      {block.split("\n").map((item) => (
                        <li>{item.replace(/^- /, "")}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>{block}</p>
                  )
                )}
              </div>
            </article>
          </div>
        </section>
      ) : showLeadForm && !hasVariants ? (
        <div class="hero-form-float">
          <LeadForm config={program.leadForm} />
        </div>
      ) : null}

      {isWomensDefense && (
        <section class="shell section-divider womens-overview">
          <div class="womens-overview-grid">
            <article class="detail-card detail-card-feature womens-overview-copy">
              <p class="eyebrow">{program.audience} • Sunday classes</p>
              <h2>{program.curriculum.title}</h2>
              <div class="program-copy">
                {curriculumBlocks.map((block) =>
                  block.startsWith("- ") ? (
                    <ul class="program-copy-list">
                      {block.split("\n").map((item) => (
                        <li>{item.replace(/^- /, "")}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>{block}</p>
                  )
                )}
              </div>
            </article>
            <aside class="womens-overview-benefits">
              <h3>{program.benefits.title}</h3>
              <ul>
                {program.benefits.items.map((item) => <li>{item}</li>)}
              </ul>
              <div class="womens-overview-contact" aria-label="Questions about the Women's Self-Defense program">
                <p class="womens-overview-contact-heading">HAVE QUESTIONS?</p>
                <p class="womens-overview-contact-name">Contact <strong>Coach Dana</strong> directly</p>
                <p class="womens-overview-contact-required">You must speak with Coach Dana before enrolling. Online registration and introductory trial promotions do not apply to this class.</p>
                <a class="womens-overview-contact-phone" href="tel:+16673359592" aria-label="Call Coach Dana at 667 335 9592">(667) 335-9592</a>
              </div>
            </aside>
          </div>
        </section>
      )}

      {isWomensDefense && (
        <section class="shell section-divider womens-photo-gallery" aria-labelledby="womens-gallery-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Training at Burning Tree</p>
              <h2 id="womens-gallery-heading">Women’s Self-Defense in Action</h2>
            </div>
          </div>
          <div class="womens-gallery-grid">
            <figure class="womens-gallery-tile">
              <img src="/images/womens-defense-professional-1.webp"
                alt="Women's self-defense participant practicing a controlled defense technique with a partner in the studio"
                loading="lazy" width="860" height="1147" decoding="async"
                />
            </figure>
            <figure class="womens-gallery-tile">
              <img src="/images/womens-defense-professional-2.webp"
                alt="Woman with a blue belt practicing a controlled self-defense response with a training partner"
                loading="lazy" width="860" height="1147" decoding="async"
                />
            </figure>
            <figure class="womens-gallery-tile">
              <img src="/images/womens-defense-professional-3.webp"
                alt="Martial arts instructor guiding a practical self-defense training drill"
                loading="lazy" width="860" height="1147" decoding="async"
                />
            </figure>
            <figure class="womens-gallery-tile">
              <img src="/images/womens-defense-professional-4.webp"
                alt="Women’s self-defense partners practicing a technique at Burning Tree Mixed Martial Arts"
                loading="lazy" width="860" height="1147" decoding="async"
                />
            </figure>
          </div>
        </section>
      )}

      {isWomensDefense && (
        <section class="shell section-divider womens-instructor-gallery" aria-labelledby="womens-instructor-gallery-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">An Inside Look at Our Training</p>
              <h2 id="womens-instructor-gallery-heading">Instructor Demonstrations</h2>
              <p class="womens-instructor-gallery-intro">
                Controlled partner demonstrations at Burning Tree Martial Arts show
                close-range awareness, movement, and defensive positioning.
                Our Women’s Self-Defense classes emphasize practical pad striking,
                escapes, and building confidence in a supportive environment.
              </p>
            </div>
          </div>
          <div class="womens-instructor-gallery-grid">
            {[
              { file: "instructor-demonstration-01.jpeg", alt: "Two martial artists practicing controlled arm positioning during a training demonstration" },
              { file: "instructor-demonstration-02.jpeg", alt: "Instructor and partner rehearsing a protective guard and close-range awareness" },
              { file: "instructor-demonstration-03.jpeg", alt: "Training partners demonstrating close-range body positioning and an elbow movement" },
              { file: "instructor-demonstration-04.jpeg", alt: "Martial artists practicing a controlled partner-defense movement in the studio" },
              { file: "instructor-demonstration-05.jpeg", alt: "Partner drill demonstrating defensive positioning and controlled footwork" },
              { file: "instructor-demonstration-06.jpeg", alt: "Instructor-guided movement drill showing close-range positioning" },
              { file: "instructor-demonstration-07.jpeg", alt: "Two martial artists working through an arm-positioning exercise" },
              { file: "instructor-demonstration-08.jpeg", alt: "Training partners practicing a controlled close-range defensive drill" },
              { file: "instructor-demonstration-09.jpeg", alt: "Martial arts instructor guiding a partner through a protective hand position" }
            ].map(({ file, alt }) => (
              <figure class="womens-instructor-gallery-tile">
                <img
                  src={`/images/womens-defense/${file}`}
                  alt={alt}
                  loading="lazy"
                  decoding="async"
                  width="960"
                  height="1100"
                />
              </figure>
            ))}
          </div>
        </section>
      )}

      {hasVariants ? (
        <ProgramDetailVariant program={program} />
      ) : (
        <ProgramDetail program={program} showCurriculum={!useSplitLayout && !isWomensDefense} />
      )}
      <ProgramLocalSEO program={program} />
      {["kenpo-karate", "muay-thai", "wing-chun"].includes(program.slug) && (
        <section class="shell section-divider">
          <article class="detail-card narrative-section">
            <p class="eyebrow">Looking for classes for your child?</p>
            <h2>Kids Martial Arts in Owings Mills</h2>
            <p>
              Explore our beginner-friendly junior Kenpo Karate, Muay Thai, and Wing Chun programs.
              See the kids class schedule, learn what to expect at the first class,
              and find out how to start with our $29 new student special.
            </p>
            <a class="button" href="/kids-martial-arts">Explore Kids Martial Arts Classes</a>
          </article>
        </section>
      )}
      {["kenpo-karate", "muay-thai", "wing-chun"].includes(program.slug) && (
        <section class="shell section-divider">
          <article class="detail-card narrative-section">
            <p class="eyebrow">Ready to train?</p>
            <h2>Teen &amp; Adult Martial Arts in Owings Mills</h2>
            <p>
              Beginner-friendly Kenpo Karate, Muay Thai, and Wing Chun classes for teens and adults.
              Compare the programs, check the evening class schedule, and learn how to start
              with our $29 new student special.
            </p>
            <a class="button" href="/teens-adults-martial-arts">Explore Teens &amp; Adults Classes</a>
          </article>
        </section>
      )}
      {isWellness && <WellnessBooking />}
    </>
  )}
</BaseLayout>

<style>
  .program-variant-hero {
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
    background: linear-gradient(135deg, #1b1b1b, #280e13);
    border-bottom: 3px solid #be1820;
  }
  .program-variant-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }
  .program-variant-hero-copy { min-width: 0; }
  .program-variant-kicker {
    margin: 0 0 .7rem;
    color: #ffabab;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .06em;
    line-height: 1.45;
  }
  .program-variant-hero h1 {
    color: #fff;
    -webkit-text-stroke: 0;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1.1;
    margin: 0 0 .75rem;
  }
  .program-variant-hero-copy > p:not(.program-variant-kicker) {
    color: #f5f5f5;
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 34rem;
  }
  .program-variant-hero-copy .program-variant-offer {
    font-size: .88rem;
    margin: .65rem 0 0;
  }
  .program-variant-hero-photo {
    min-width: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .program-variant-hero-photo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 300px;
    object-fit: contain;
    border: 2px solid rgba(255, 255, 255, .65);
    border-radius: 4px;
  }
  .womens-photo-gallery { padding-top: 1.2rem; padding-bottom: 1.5rem; }
  .womens-photo-gallery .section-heading { margin-bottom: 1.15rem; }
  .womens-gallery-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(.6rem, 1.5vw, 1rem); }
  .womens-gallery-tile { margin: 0; overflow: hidden; background: #1a1a1a; border: 1px solid rgba(255,255,255,.22); border-top: 3px solid #c7222c; border-radius: 6px; }
  .womens-gallery-tile img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; object-position: center; }
  @media (max-width: 900px) { .womens-gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 440px) { .womens-gallery-grid { gap: .55rem; } }
  .womens-instructor-gallery { padding-top: 1.2rem; padding-bottom: 1.6rem; }
  .womens-instructor-gallery .section-heading { margin-bottom: 1rem; }
  .womens-instructor-gallery-intro {
    color: #e8e8e8;
    max-width: 48rem;
    line-height: 1.65;
    margin: .7rem 0 0;
  }
  .womens-instructor-gallery-grid {
    columns: 3;
    column-gap: clamp(.6rem, 1.6vw, 1rem);
  }
  .womens-instructor-gallery-tile {
    display: inline-block;
    width: 100%;
    margin: 0 0 clamp(.6rem, 1.6vw, 1rem);
    break-inside: avoid;
    overflow: hidden;
    background: #171717;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 7px;
  }
  .womens-instructor-gallery-tile img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 900px) {
    .womens-instructor-gallery-grid { columns: 2; }
  }
  @media (max-width: 520px) {
    .womens-instructor-gallery-grid { columns: 1; }
  }
  .womens-overview { padding-top: 1.25rem; padding-bottom: 1.35rem; }
  .womens-overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: 1.15rem;
    align-items: start;
  }
  .womens-overview-copy { min-width: 0; }
  .womens-overview-copy h2 { font-size: clamp(1.35rem, 2.5vw, 2rem); }
  .womens-overview-copy .program-copy p { margin: 0; }
  .womens-overview-benefits {
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, .15);
    border-top: 2px solid var(--accent);
    background: #1f1f1f;
    padding: 1.15rem;
  }
  .womens-overview-benefits h3 {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    color: #fff;
    -webkit-text-stroke: 0;
    margin-bottom: .75rem;
  }
  .womens-overview-benefits ul {
    margin: 0 0 1.1rem;
    padding-left: 1.2rem;
    display: grid;
    gap: .5rem;
    color: #f5f5f5;
  }
  .womens-overview-benefits li { line-height: 1.5; font-size: .95rem; }
  .womens-overview-contact {
    margin: 1.25rem 0 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 3px solid #e52c35;
    border-radius: 8px;
    background: linear-gradient(150deg, #421218, #211013);
    text-align: center;
    box-shadow: 0 6px 24px rgba(0, 0, 0, .28);
  }
  .womens-overview-contact-heading {
    margin: 0 0 .45rem;
    color: #fff;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    letter-spacing: .035em;
    line-height: 1.15;
  }
  .womens-overview-contact-name {
    margin: 0 0 .65rem;
    color: #fff;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 800;
    line-height: 1.35;
  }
  .womens-overview-contact-required { color: #fff; font-size: clamp(1rem, 1.8vw, 1.15rem); font-weight: 800; line-height: 1.5; margin: 0 0 .85rem; }
  .womens-overview-contact-phone {
    display: block;
    color: #fff;
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -.025em;
    text-decoration: underline;
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
  }
  .womens-overview-contact-phone:hover, .womens-overview-contact-phone:focus-visible { color: #ffd2d2; }
  @media (max-width: 760px) {
    .program-variant-hero-grid { grid-template-columns: 1fr; }
    .womens-overview-grid { grid-template-columns: 1fr; }
    .program-variant-hero { padding: 1.25rem 0; }
    .program-variant-hero h1 { font-size: clamp(2rem, 9vw, 3rem); }
    .program-variant-cta { width: 100%; text-align: center; }
    .program-variant-hero-photo img { max-height: 240px; }
  }
</style>
