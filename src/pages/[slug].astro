---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProgramDetail from "../components/ProgramDetail.astro";
import ProgramDetailVariant from "../components/ProgramDetailVariant.astro";
import ProgramLocalSEO from "../components/ProgramLocalSEO.astro";
import ChimpmanGiPage from "../components/ChimpmanGiPage.astro";
import LeadForm from "../components/LeadForm.astro";
import WellnessBooking from "../components/WellnessBooking.astro";
import BirthdayPartyBooking from "../components/BirthdayPartyBooking.astro";
import { programPages } from "../data/site";

export function getStaticPaths() {
  return programPages.map((program) => ({
    params: { slug: program.slug },
    props: { program }
  }));
}

const { program } = Astro.props;
const isChimpmanGi  = program.slug === "chimpman-gi";
const isWellness    = program.slug === "health-and-wellness";
const isBirthday    = program.slug === "birthday-parties";
const isWomensDefense = program.slug === "womens-defense";
const variantDescriptions: Record<string, string> = {
  "kenpo-karate": "Build confidence, discipline, and practical self-defense skills through American Kenpo Karate for kids, teens, and adults.",
  "muay-thai": "Learn powerful striking fundamentals, footwork, and pad work in welcoming Muay Thai classes for kids, teens, and adults.",
  "wing-chun": "Discover centerline control, timing, and precise close-range techniques through real Wing Chun partner training on Wednesdays.",
  "womens-defense": "Build real-world self-defense skills, awareness, and confidence through practical Women’s Self-Defense and Sanuces training on Sundays."
};
const hasVariants   = !!program.variants?.length;
const showLeadForm  = program.showLeadForm !== false && !isBirthday && !isWomensDefense;
const centerContent = !isWellness && !isBirthday;
const useSplitLayout = !isChimpmanGi && !isWellness && !isBirthday && !hasVariants && showLeadForm;

const curriculumBlocks = !hasVariants ? program.curriculum.copy.split("\n\n") : [];
---

<BaseLayout
  title={program.seo.title}
  description={program.seo.description}
  path={`/${program.slug}`}
  keywords={program.seo.keywords}
  image={program.hero.image}
  theme={program.accentTheme ?? "flame"}>
  {isChimpmanGi ? (
    <ChimpmanGiPage program={program} />
  ) : (
    <>
      {(hasVariants || isWomensDefense) ? (
        <section class="program-variant-hero" aria-labelledby="program-variant-heading">
          <div class="shell program-variant-hero-grid">
            <div class="program-variant-hero-copy">
              <p class="program-variant-kicker">
                {isWomensDefense ? "WOMEN’S SELF-DEFENSE & SANUCES • SUNDAYS • OWINGS MILLS, MD" : program.slug === "wing-chun" ? "WEDNESDAY WING CHUN • OWINGS MILLS, MD" : "KIDS, TEENS & ADULTS • OWINGS MILLS, MD"}
              </p>
              <h1 id="program-variant-heading">{program.hero.title}</h1>
              <p>{variantDescriptions[program.slug]}</p>
              <a class="button program-variant-cta" href="/29-trial">Start With 2 Classes for $29</a>
              <p class="program-variant-offer">Includes a free uniform for new students.</p>
            </div>
            <figure class="program-variant-hero-photo">
              <img
                src={program.hero.image}
                alt={program.hero.imageAlt ?? program.hero.title}
                width="1200"
                height="900"
                loading="eager"
                decoding="async"
                fetchpriority="high" />
            </figure>
          </div>
        </section>
      ) : (
        <PageHero hero={program.hero} showMobileCta={showLeadForm} ctaLabel={program.mobileCta} centerMobile={isWellness} centerContent={centerContent} />
      )}

      {isBirthday && <BirthdayPartyBooking />}
      {isBirthday && (
        <div id="birthday-fallback" class="hero-form-float" hidden>
          <LeadForm config={{ ...program.leadForm, title: "Ask About a Birthday Party", intro: "Online date requests are temporarily unavailable. Send your contact details and preferred date so we can help you plan." }} formId="birthday-fallback-lead" />
        </div>
      )}

      {useSplitLayout ? (
        <section class="shell section-divider">
          <div class="program-split">
            <div class="program-split-left">
              <LeadForm config={program.leadForm} />
            </div>
            <article class="detail-card detail-card-feature program-split-right">
              <p class="eyebrow">{program.audience}</p>
              <h2>{program.curriculum.title}</h2>
              <div class="program-copy">
                {curriculumBlocks.map((block) =>
                  block.startsWith("- ") ? (
                    <ul class="program-copy-list">
                      {block.split("\n").map((item) => (
                        <li>{item.replace(/^- /, "")}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>{block}</p>
                  )
                )}
              </div>
            </article>
          </div>
        </section>
      ) : showLeadForm && !hasVariants ? (
        <div class="hero-form-float">
          <LeadForm config={program.leadForm} />
        </div>
      ) : null}

      {isWomensDefense && (
        <section class="shell section-divider womens-overview">
          <div class="womens-overview-grid">
            <article class="detail-card detail-card-feature womens-overview-copy">
              <p class="eyebrow">{program.audience} • Sunday classes</p>
              <h2>{program.curriculum.title}</h2>
              <div class="program-copy">
                {curriculumBlocks.map((block) =>
                  block.startsWith("- ") ? (
                    <ul class="program-copy-list">
                      {block.split("\n").map((item) => (
                        <li>{item.replace(/^- /, "")}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>{block}</p>
                  )
                )}
              </div>
            </article>
            <aside class="womens-overview-benefits">
              <h3>{program.benefits.title}</h3>
              <ul>
                {program.benefits.items.map((item) => <li>{item}</li>)}
              </ul>
              <a class="button womens-overview-cta" href="/29-trial">Claim the $29 New Student Special</a>
              <p class="womens-overview-note">2 beginner classes and a free uniform for new students.</p>
            </aside>
          </div>
        </section>
      )}

      {hasVariants ? (
        <ProgramDetailVariant program={program} />
      ) : (
        <ProgramDetail program={program} showCurriculum={!useSplitLayout && !isWomensDefense} />
      )}
      <ProgramLocalSEO program={program} />
      {["kenpo-karate", "muay-thai", "wing-chun"].includes(program.slug) && (
        <section class="shell section-divider">
          <article class="detail-card narrative-section">
            <p class="eyebrow">Looking for classes for your child?</p>
            <h2>Kids Martial Arts in Owings Mills</h2>
            <p>
              Explore our beginner-friendly junior Kenpo Karate, Muay Thai, and Wing Chun programs.
              See the kids class schedule, learn what to expect at the first class,
              and find out how to start with our $29 new student special.
            </p>
            <a class="button" href="/kids-martial-arts">Explore Kids Martial Arts Classes</a>
          </article>
        </section>
      )}
      {["kenpo-karate", "muay-thai", "wing-chun"].includes(program.slug) && (
        <section class="shell section-divider">
          <article class="detail-card narrative-section">
            <p class="eyebrow">Ready to train?</p>
            <h2>Teen &amp; Adult Martial Arts in Owings Mills</h2>
            <p>
              Beginner-friendly Kenpo Karate, Muay Thai, and Wing Chun classes for teens and adults.
              Compare the programs, check the evening class schedule, and learn how to start
              with our $29 new student special.
            </p>
            <a class="button" href="/teens-adults-martial-arts">Explore Teens &amp; Adults Classes</a>
          </article>
        </section>
      )}
      {isWellness && <WellnessBooking />}
    </>
  )}
</BaseLayout>

<style>
  .program-variant-hero {
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
    background: linear-gradient(135deg, #1b1b1b, #280e13);
    border-bottom: 3px solid #be1820;
  }
  .program-variant-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }
  .program-variant-hero-copy { min-width: 0; }
  .program-variant-kicker {
    margin: 0 0 .7rem;
    color: #ffabab;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .06em;
    line-height: 1.45;
  }
  .program-variant-hero h1 {
    color: #fff;
    -webkit-text-stroke: 0;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1.1;
    margin: 0 0 .75rem;
  }
  .program-variant-hero-copy > p:not(.program-variant-kicker) {
    color: #f5f5f5;
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 34rem;
  }
  .program-variant-hero-copy .program-variant-offer {
    font-size: .88rem;
    margin: .65rem 0 0;
  }
  .program-variant-hero-photo {
    min-width: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .program-variant-hero-photo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 300px;
    object-fit: contain;
    border: 2px solid rgba(255, 255, 255, .65);
    border-radius: 4px;
  }
  .womens-overview { padding-top: 1.25rem; padding-bottom: 1.35rem; }
  .womens-overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: 1.15rem;
    align-items: start;
  }
  .womens-overview-copy { min-width: 0; }
  .womens-overview-copy h2 { font-size: clamp(1.35rem, 2.5vw, 2rem); }
  .womens-overview-copy .program-copy p { margin: 0; }
  .womens-overview-benefits {
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, .15);
    border-top: 2px solid var(--accent);
    background: #1f1f1f;
    padding: 1.15rem;
  }
  .womens-overview-benefits h3 {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    color: #fff;
    -webkit-text-stroke: 0;
    margin-bottom: .75rem;
  }
  .womens-overview-benefits ul {
    margin: 0 0 1.1rem;
    padding-left: 1.2rem;
    display: grid;
    gap: .5rem;
    color: #f5f5f5;
  }
  .womens-overview-benefits li { line-height: 1.5; font-size: .95rem; }
  .womens-overview-cta { width: 100%; text-align: center; }
  .womens-overview-note { color: #efefef; font-size: .86rem; line-height: 1.5; margin: .65rem 0 0; }
  @media (max-width: 760px) {
    .program-variant-hero-grid { grid-template-columns: 1fr; }
    .womens-overview-grid { grid-template-columns: 1fr; }
    .program-variant-hero { padding: 1.25rem 0; }
    .program-variant-hero h1 { font-size: clamp(2rem, 9vw, 3rem); }
    .program-variant-cta { width: 100%; text-align: center; }
    .program-variant-hero-photo img { max-height: 240px; }
  }
</style>
