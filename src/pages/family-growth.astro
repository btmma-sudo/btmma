---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Refer a Family or Return to Martial Arts | Burning Tree MMA"
  description="Current Burning Tree families can refer friends and earn verified tuition rewards. Former students can request to return for $150/month with no testing fees, subject to eligibility confirmation in Owings Mills, Maryland."
  path="/family-growth/"
  image="/images/logo.png"
  keywords={["martial arts family referral Owings Mills","Burning Tree MMA referral program","return to karate classes Owings Mills","former martial arts students welcome back","family martial arts rewards Baltimore County"]}
>
  <main class="growth">
    <section class="growth-hero">
      <div class="growth-wrap growth-hero-inner">
        <img class="growth-logo" src="/images/logo.png" width="85" height="115" alt="Burning Tree Mixed Martial Arts logo" />
        <p class="growth-eyebrow">BURNING TREE MIXED MARTIAL ARTS · OWINGS MILLS</p>
        <h1>ONE TREE. <span>ONE FAMILY.</span></h1>
        <p class="growth-lead">Help our family grow. Or come home to the mats.</p>
        <p>Two ways to strengthen the Burning Tree community: introduce a friend to the school, or reconnect with the training and people you remember.</p>
        <div class="growth-actions">
          <a class="growth-btn" href="#referrals">REFER A FAMILY</a>
          <a class="growth-btn growth-outline" href="#welcome-back">I'M A FORMER STUDENT</a>
        </div>
      </div>
    </section>

    <section id="referrals" class="growth-section">
      <div class="growth-wrap">
        <p class="growth-eyebrow dark">CURRENT STUDENTS &amp; FAMILIES</p>
        <h2>SHARE THE FLAME. <span>EARN FREE TRAINING.</span></h2>
        <p class="growth-intro">Know someone who could benefit from more confidence, focus, or discipline? Invite two friends and help them discover Burning Tree.</p>
        <div class="growth-rewards">
          <div><p>REFER <strong>3</strong></p><h3>ONE YEAR FREE</h3><span>Three qualifying new full-time students</span></div>
          <div><p>REFER <strong>6</strong></p><h3>TWO YEARS FREE</h3><span>Six qualifying new full-time students</span></div>
        </div>
        <div class="growth-grid">
          <div>
            <h3>HOW THE REFERRAL PROGRAM WORKS</h3>
            <ol class="growth-steps">
              <li>Share this page with a friend or family you think would love Burning Tree.</li>
              <li>They complete the referral inquiry themselves and tell us who referred them.</li>
              <li>They can register for the <a href="/29-trial">existing $29 New Student Special</a>: two beginner classes plus a free uniform.</li>
              <li>We verify each new, unique full-time enrollment and at least six months of continued membership before approving a reward.</li>
            </ol>
            <button id="growth-share" type="button" class="growth-btn">COPY AN INVITATION TO SEND</button>
            <p id="growth-share-status" role="status" class="growth-help"></p>
            <p class="growth-small">Only verified, eligible referrals count. Trials, inquiries, duplicate referrals, and unconfirmed enrollments are not qualifying full-time students. Reward approval and tuition adjustment are handled by Burning Tree staff; nothing is credited automatically.</p>
          </div>
          <div class="growth-form-card">
            <p class="growth-card-label">NEW FRIENDS START HERE</p>
            <h3>WERE YOU REFERRED TO BURNING TREE?</h3>
            <p>If a Burning Tree family invited you, complete this form for yourself or your child. We will personally help you get started.</p>
            <form class="growth-form" data-kind="referral">
              <label>Who referred you? <span>*</span>
                <input name="referrerName" type="text" maxlength="120" placeholder="Burning Tree family or parent name" required />
              </label>
              <label>Referring student's name (optional)
                <input name="referrerStudent" type="text" maxlength="120" />
              </label>
              <label>New student's full name <span>*</span>
                <input name="studentName" type="text" maxlength="120" required />
              </label>
              <label>Your name (adult / parent / guardian) <span>*</span>
                <input name="contactName" type="text" maxlength="120" autocomplete="name" required />
              </label>
              <div class="growth-form-row">
                <label>Email <span>*</span><input name="email" type="email" maxlength="254" autocomplete="email" required /></label>
                <label>Phone <span>*</span><input name="phone" type="tel" maxlength="30" autocomplete="tel" required /></label>
              </div>
              <label>Interested in <span>*</span>
                <select name="program" required>
                  <option value="">Select a program</option>
                  <option>American Kenpo Karate</option><option>Muay Thai</option><option>Wing Chun</option>
                  <option>Women's Self-Defense / Sanuces</option><option>Not sure yet</option>
                </select>
              </label>
              <label>Questions (optional)<textarea name="notes" rows="3" maxlength="450" placeholder="How can we help your family?"></textarea></label>
              <label class="growth-check"><input type="checkbox" name="adultContact" required /> <span>I am an adult or the student's parent or guardian.</span></label>
              <label class="growth-check"><input type="checkbox" name="contactPermission" required /> <span>I would like Burning Tree to contact me about this inquiry. This is not an opt-in to unrelated marketing texts.</span></label>
              <div class="growth-captcha"><div class="cf-turnstile" data-sitekey="0x4AAAAAAD6Ievu-t0Ll1euh" data-theme="light"></div></div>
              <p class="growth-small">We use your details to respond to this request, as described in our <a href="/privacy">Privacy Policy</a>. No payment is collected on this form.</p>
              <button type="submit" class="growth-btn growth-submit">SEND MY REFERRAL INQUIRY</button>
              <p class="growth-status" role="status" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section id="welcome-back" class="growth-section growth-back">
      <div class="growth-wrap">
        <p class="growth-eyebrow dark">FORMER BURNING TREE STUDENTS</p>
        <h2>YOUR PLACE IN THE FAMILY <span>IS STILL HERE.</span></h2>
        <p class="growth-intro">Life gets busy, schedules change, and sometimes training takes a break. If you previously trained with Burning Tree, we'd love to reconnect.</p>
        <div class="growth-grid">
          <div>
            <div class="growth-return-offer"><p>WELCOME-BACK MEMBERSHIP</p><strong>$150<span>/month</span></strong><h3>NO TESTING FEES</h3><p>Available to eligible returning students after staff confirms their prior enrollment and membership details. This is separate from the new-student $29 trial.</p></div>
            <h3>HOW COMING BACK WORKS</h3>
            <ol class="growth-steps">
              <li>Tell us your name, your program, and when you might like to return.</li>
              <li>A coach checks your previous student record and confirms the returning-student terms.</li>
              <li>We'll help you choose a class and make your return easy.</li>
            </ol>
            <p class="growth-small">Submitting this inquiry does not start a membership or charge your card. Tuition and waived testing fees are confirmed with the school before reactivation.</p>
          </div>
          <div class="growth-form-card">
            <p class="growth-card-label">WELCOME BACK TO THE TREE</p>
            <h3>REQUEST TO REJOIN</h3>
            <p>Tell us a little about your return. Coach David or a team member will follow up personally.</p>
            <form class="growth-form" data-kind="returning">
              <label>Former student's full name <span>*</span><input name="studentName" type="text" maxlength="120" required /></label>
              <label>Your name (adult / parent / guardian) <span>*</span><input name="contactName" type="text" maxlength="120" autocomplete="name" required /></label>
              <div class="growth-form-row">
                <label>Email <span>*</span><input name="email" type="email" maxlength="254" autocomplete="email" required /></label>
                <label>Phone <span>*</span><input name="phone" type="tel" maxlength="30" autocomplete="tel" required /></label>
              </div>
              <label>Program of interest <span>*</span>
                <select name="program" required><option value="">Select a program</option>
                  <option>American Kenpo Karate</option><option>Muay Thai</option><option>Wing Chun</option>
                  <option>Women's Self-Defense / Sanuces</option><option>Not sure yet</option>
                </select>
              </label>
              <label>When would you like to return? <span>*</span>
                <select name="returnTiming" required><option value="">Choose timing</option>
                  <option>As soon as possible</option><option>Within a month</option><option>Exploring options</option>
                </select>
              </label>
              <label>Anything you'd like us to know? (optional)<textarea name="notes" rows="3" maxlength="450"></textarea></label>
              <label class="growth-check"><input type="checkbox" name="adultContact" required /> <span>I am an adult or the student's parent or guardian.</span></label>
              <label class="growth-check"><input type="checkbox" name="contactPermission" required /> <span>I would like Burning Tree to contact me about returning. This is not an opt-in to unrelated marketing texts.</span></label>
              <div class="growth-captcha"><div class="cf-turnstile" data-sitekey="0x4AAAAAAD6Ievu-t0Ll1euh" data-theme="light"></div></div>
              <p class="growth-small">Your information will be used to respond to this request according to our <a href="/privacy">Privacy Policy</a>.</p>
              <button type="submit" class="growth-btn growth-submit">REQUEST MY WELCOME BACK</button>
              <p class="growth-status" role="status" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </div>
    </section>
    <section class="growth-bottom"><div class="growth-wrap"><h2>QUESTIONS? LET'S TALK.</h2><p>Call or text <a href="tel:+14102180894">410-218-0894</a> and we'll help you find the right next step.</p><p><strong>KEEPERS OF THE FLAME. ONE TREE. ONE FAMILY.</strong></p></div></section>
  </main>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" is:inline async defer></script>
  <script is:inline>
    (() => {
      const share=document.getElementById("growth-share"),shareStatus=document.getElementById("growth-share-status");
      share?.addEventListener("click",async()=>{
        const message="Our Burning Tree family would love to meet yours! Visit https://burningtreemma.com/family-growth/#referrals and mention our family when you fill out the referral form. New students can also explore the $29 special for two classes and a free uniform.";
        try { await navigator.clipboard.writeText(message); shareStatus.textContent="Invitation copied. Send it to two friends or families!"; }
        catch { window.prompt("Copy this invitation:",message); shareStatus.textContent="Share this invitation with a friend who may be interested."; }
      });
      document.querySelectorAll(".growth-form").forEach(form=>{
        const status=form.querySelector(".growth-status"),button=form.querySelector(".growth-submit");
        form.addEventListener("submit",async(event)=>{
          event.preventDefault();
          const data=Object.fromEntries(new FormData(form).entries());
          const turnstileToken=String(data["cf-turnstile-response"]||"");
          if(!turnstileToken){status.textContent="Please complete the security check before sending.";return;}
          delete data["cf-turnstile-response"];
          data.kind=form.dataset.kind;
          data.adultContact=Boolean(data.adultContact);
          data.contactPermission=Boolean(data.contactPermission);
          data.turnstileToken=turnstileToken;
          button.disabled=true;button.textContent="SENDING…";status.textContent="Sending your request…";
          const controller=new AbortController(),timeout=setTimeout(()=>controller.abort(),18000);
          try {
            const response=await fetch("/api/family-growth",{
              method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(data),signal:controller.signal
            });
            const result=await response.json().catch(()=>({}));
            if(!response.ok||!result.ok)throw Error(result.error||"We couldn't save this request. Please contact Burning Tree directly.");
            status.classList.add("growth-success");
            status.textContent=result.message+" Your reference: "+result.reference+".";
            form.querySelectorAll("input,select,textarea,button").forEach(element=>element.disabled=true);
            if(window.gtag)window.gtag("event","generate_lead",{lead_source:form.dataset.kind==="referral"?"family_referral":"former_student_return"});
          } catch(e) {
            status.classList.remove("growth-success");
            status.textContent=e.name==="AbortError"?"This request timed out. Please text 410-218-0894 before trying again, to avoid duplicates.":e.message;
            try{window.turnstile?.reset?.();}catch{}
          } finally {clearTimeout(timeout);if(!form.querySelector(".growth-success")){button.disabled=false;button.textContent=form.dataset.kind==="referral"?"SEND MY REFERRAL INQUIRY":"REQUEST MY WELCOME BACK";}}
        });
      });
    })();
  </script>
  <style>
    .growth{background:#fff;color:#171717;font-family:Arial,sans-serif;line-height:1.65}
    .growth-wrap{width:min(1120px,calc(100% - 40px));margin:auto}
    .growth-hero{background:linear-gradient(125deg,#111 0%,#2b1113 65%,#780e15 100%);color:#fff;padding:58px 0 62px;text-align:center}
    .growth-hero-inner{max-width:840px}.growth-logo{display:block;margin:0 auto 15px;object-fit:contain}
    .growth-eyebrow{font-size:.78rem;letter-spacing:.16em;font-weight:900;color:#ffc0c0;text-transform:uppercase;margin:0 0 12px}
    .growth-eyebrow.dark{color:#9d121b}.growth h1,.growth h2,.growth h3{font-family:Arial,sans-serif;font-weight:900;line-height:1.15;margin:0}
    .growth h1{font-size:clamp(2.8rem,7vw,5rem)}.growth h1 span,.growth h2 span{color:#c81823}
    .growth-hero h1 span{color:#ff626b}.growth-lead{font-size:clamp(1.25rem,2.8vw,1.65rem);font-weight:800;margin:15px 0 8px}
    .growth-hero p:not(.growth-eyebrow){max-width:670px;margin-left:auto;margin-right:auto}
    .growth-actions{display:flex;flex-wrap:wrap;gap:13px;justify-content:center;margin-top:25px}
    .growth-btn{display:inline-block;appearance:none;border:2px solid #bd1621;border-radius:6px;background:#bd1621;color:#fff!important;text-decoration:none;text-align:center;font-size:.93rem;font-weight:900;line-height:1.3;padding:13px 20px;cursor:pointer}
    .growth-btn:hover,.growth-btn:focus-visible{background:#8b1119;border-color:#8b1119}
    .growth-outline{background:transparent;border-color:#fff}
    .growth-section{padding:65px 0;scroll-margin-top:85px}.growth-section h2{font-size:clamp(2rem,4.2vw,3rem);max-width:870px}
    .growth-intro{font-size:1.12rem;max-width:770px;margin:16px 0 30px}
    .growth-rewards{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:30px 0 38px}
    .growth-rewards>div{border:2px solid #ebd7d8;border-top:6px solid #ba1520;border-radius:9px;padding:23px;background:#fff;box-shadow:0 9px 20px #1300000a}
    .growth-rewards p{margin:0;font-size:1rem;font-weight:900;color:#9f161c}.growth-rewards p strong{font-size:2.7rem;color:#b5121d}
    .growth-rewards h3{font-size:clamp(1.3rem,2.3vw,1.9rem)}.growth-rewards span{font-size:.9rem}
    .growth-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:42px;align-items:start}
    .growth-grid>div>h3{font-size:1.35rem;margin-bottom:15px}.growth-steps{padding-left:22px;margin:15px 0 24px}
    .growth-steps li{padding-left:7px;margin:11px 0}.growth-steps li::marker{font-weight:900;color:#ad141d}
    .growth a:not(.growth-btn){color:#a6131e;text-underline-offset:3px;font-weight:700}
    .growth-small{font-size:.82rem;color:#444;line-height:1.55}
    .growth-help{min-height:22px;color:#15713a;font-weight:750}
    .growth-form-card{background:#fff;border:1px solid #e5d5d5;border-radius:12px;box-shadow:0 12px 36px #16050818;padding:29px}
    .growth-card-label{color:#b5121d;letter-spacing:.12em;font-size:.8rem;font-weight:900;margin:0 0 8px}
    .growth-form-card h3{font-size:1.5rem}.growth-form-card>p{font-size:.94rem}
    .growth-form{display:grid;gap:15px;margin-top:16px}
    .growth-form label{display:block;font-weight:800;font-size:.93rem;line-height:1.4}
    .growth-form label>span:not(.growth-check span){color:#b5121d}
    .growth-form input:not([type=checkbox]),.growth-form select,.growth-form textarea{display:block;width:100%;min-width:0;min-height:45px;box-sizing:border-box;border:1.5px solid #8d8d8d;border-radius:6px;background:white;color:#141414;padding:9px 11px;margin-top:7px;font:inherit;font-weight:500}
    .growth-form textarea{resize:vertical;min-height:84px}
    .growth-form-row{display:grid;grid-template-columns:1fr 1fr;gap:13px}
    .growth-form .growth-check{display:flex;gap:10px;align-items:flex-start;font-size:.85rem;font-weight:600}
    .growth-check input{margin-top:4px;flex-shrink:0;width:19px;height:19px;accent-color:#a9141d}
    .growth-check span{color:#252525!important}
    .growth-captcha{max-width:100%;overflow:hidden}
    .growth-submit{width:100%}.growth-submit:disabled{opacity:.7;cursor:wait}
    .growth-status{min-height:24px;color:#b5121d;font-size:.92rem;font-weight:800}
    .growth-success{color:#126c36}
    .growth-back{background:#faf6f6}
    .growth-return-offer{padding:26px 27px;margin-bottom:34px;background:#171717;color:#fff;border-left:7px solid #d51d29;border-radius:7px}
    .growth-return-offer>p:first-child{font-size:.8rem;color:#ffb4b4;font-weight:900;letter-spacing:.1em}
    .growth-return-offer strong{font-weight:900;display:block;font-size:clamp(3rem,6vw,4.4rem);line-height:1.1}
    .growth-return-offer strong span{font-size:1.3rem}.growth-return-offer h3{font-size:1.45rem;margin:6px 0 8px}
    .growth-return-offer>p:last-child{font-size:.87rem;color:#eee}
    .growth-bottom{background:#171717;color:#fff;text-align:center;padding:47px 0}
    .growth-bottom h2{font-size:1.9rem}.growth-bottom a{color:#fff!important}
    @media(max-width:760px){.growth-hero{padding:40px 0}.growth-grid{grid-template-columns:1fr;gap:24px}.growth-section{padding:43px 0}.growth-rewards{grid-template-columns:1fr;gap:12px;margin:25px 0}.growth-form-card{padding:21px}.growth-form-row{grid-template-columns:1fr}.growth-wrap{width:min(100% - 30px,1120px)}}
  </style>
</BaseLayout>
