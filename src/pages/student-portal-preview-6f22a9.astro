---
/**
 * Safe, visual-only preview of the student portal.
 * NO account credentials, portal APIs, login forms, billing buttons, or student data.
 * The real /student-portal/ and /api/student-portal/* routes remain disabled.
 */
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="referrer" content="no-referrer" />
  <title>Private Design Preview | Burning Tree Student Portal</title>
  <meta name="description" content="Non-functional, visual-only preview of the upcoming Burning Tree Student Portal." />
  <style is:global>

    *{box-sizing:border-box}body{margin:0;background:#111416;color:#f6f7f8;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.55}a{color:#fff}button,input{font:inherit}.shell{max-width:1100px;margin:auto;padding:0 22px}.top{border-bottom:1px solid #383e41;background:#07090b}.top-inner{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:85px}.brand{display:flex;align-items:center;gap:14px;text-decoration:none;font-weight:800;letter-spacing:.02em}.brand img{width:50px;height:65px;object-fit:contain}.back{font-size:.9rem;text-decoration:none;padding:10px 12px;border:1px solid #555;border-radius:8px}.back:hover,.back:focus{border-color:#fc4a40}.hero{padding:54px 0 30px}.eyebrow{letter-spacing:.18em;color:#fb6b5e;font-size:.78rem;font-weight:800}.hero h1{font-size:clamp(2rem,5vw,3.6rem);line-height:1.12;margin:8px 0 16px}.hero p{color:#d6d8da;max-width:690px}.red{color:#f85a50}.content{padding-bottom:72px}.panel{border:1px solid #3b4348;background:#1c2023;border-radius:18px;padding:25px;margin:18px 0;box-shadow:0 10px 30px #0002}.panel h2{font-size:1.35rem;margin:0 0 10px}.muted{color:#bfc5c8}.notice{border-left:4px solid #e7574f;background:#2c2423;padding:12px 16px;border-radius:4px}.fields{display:grid;gap:15px;max-width:480px}.fields label{font-weight:700;display:grid;gap:5px}.fields input{width:100%;background:#fff;color:#141414;padding:13px 15px;border:2px solid transparent;border-radius:8px}.fields input:focus{outline:2px solid #fb6257}.btn{display:inline-block;background:#c52724;color:#fff;border:0;border-radius:9px;text-decoration:none;padding:13px 20px;font-weight:800;cursor:pointer}.btn:hover,.btn:focus{background:#a91a18}.secondary{background:#363b3d}.secondary:hover{background:#555}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:18px}.grid .panel{margin:0}.pill{display:inline-block;font-size:.74rem;letter-spacing:.04em;text-transform:uppercase;padding:3px 9px;border:1px solid #b54843;border-radius:50px;color:#ffaaa5}.lesson{padding:20px}.lesson h3{margin:8px 0}.player{position:relative;padding-top:56.25%;border-radius:12px;overflow:hidden;background:#090b0d;margin:12px 0}.player iframe{border:0;position:absolute;inset:0;width:100%;height:100%}.price-table{width:100%;border-collapse:collapse}.price-table th,.price-table td{text-align:left;padding:12px 8px;border-bottom:1px solid #444}.price-table th{font-size:.82rem;color:#ccc}.foot{color:#b9bdc0;border-top:1px solid #383e41;padding:28px 0;text-align:center;font-size:.9rem}@media(max-width:520px){.top-inner{min-height:72px}.brand img{height:52px;width:38px}.brand span{font-size:.85rem}.back{font-size:.8rem}.panel{padding:19px}.price-table{font-size:.85rem}} 
    /* Portal-only logo treatment: the existing Burning Tree mark plus the
       Keepers of the Flame motto, without altering any public-site branding. */
    .brand .brand-title{display:block;font-size:12px;letter-spacing:.09em;line-height:1.25}
    .brand .brand-subtitle{display:block;color:#ffb6af;font-size:11px;letter-spacing:.12em;line-height:1.5}
    .top .brand img{width:54px;height:74px;object-fit:contain}
    .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(210px,290px);align-items:center;gap:26px}
    .hero-intro{min-width:0}
    .portal-identity{margin:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;background:#080a0c;border:1px solid #373a3c;border-radius:16px;padding:18px 10px 20px}
    .portal-identity img{display:block;width:min(100%,215px);height:auto;max-height:292px;object-fit:contain;object-position:center}
    .portal-identity figcaption{color:#ededee;font-size:11px;font-style:italic;letter-spacing:.08em;text-align:center}
    @media(max-width:720px){.hero{grid-template-columns:1fr;gap:22px;padding-top:34px}.portal-identity{order:-1;justify-self:center;width:min(100%,260px);padding:12px 10px}.portal-identity img{width:min(100%,175px);max-height:238px}.brand .brand-title{font-size:11px}.brand .brand-subtitle{font-size:10px}.top .brand img{width:41px;height:57px}}
  
    .preview-banner{background:#382324;border-bottom:1px solid #8d4444;color:#fff;text-align:center;padding:12px 16px;font-size:.85rem;font-weight:800}
    .preview-navigation{display:flex;gap:12px;flex-wrap:wrap;margin:15px 0 22px}
    .preview-tab{border:1px solid #6b767b;border-radius:9px;padding:11px 18px;font-size:.9rem;color:white;font-weight:750;background:#303539;cursor:pointer}
    .preview-tab[aria-selected="true"]{background:#b8201c;border-color:#b8201c}
    .preview-view[hidden]{display:none !important}
    .disabled-control{display:inline-block;background:#852926;opacity:.8;color:#fff;padding:12px 18px;border-radius:9px;font-weight:800}
    .preview-placeholder{padding:20px;border:1px solid #4a4f53;border-radius:11px;background:#14181b;display:flex;align-items:center;justify-content:center;gap:10px;font-weight:800;min-height:110px;margin:12px 0}
    .preview-values{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
    .preview-values span{border:1px solid #535c62;padding:13px;border-radius:8px}
    .preview-kicker{font-size:.8rem;color:#ffd5d0}
    .preview-photo-mark{display:flex;flex-direction:column;align-items:center;padding:12px}
    button:focus-visible{outline:3px solid #fff;outline-offset:3px}
  </style>
</head>
<body>
  <div class="preview-banner">DESIGN PREVIEW ONLY — Student login, videos, and payments are NOT active</div>
  <header class="top"><div class="shell top-inner">
    <a class="brand" href="/"><img src="/images/logo.png" alt="Burning Tree Mixed Martial Arts flaming-tree logo" width="54" height="74" /><span><span class="brand-title">BURNING TREE</span><span class="brand-subtitle">STUDENT PORTAL</span></span></a>
    <a class="back" href="/">Main Website</a>
  </div></header>
  <main class="shell content">
    <section class="hero" aria-labelledby="preview-welcome">
      <div class="hero-intro">
        <p class="eyebrow">EXCLUSIVE BURNING TREE FAMILY ACCESS</p>
        <h1 id="preview-welcome">Welcome to Your <span class="red">Training Home.</span></h1>
        <p>Continue learning beyond the mats. Access private instructional videos, see your family's training information, and manage tuition securely.</p>
        <strong>One Tree. One Family.</strong>
      </div>
      <figure class="portal-identity">
        <img src="/images/logo.png" alt="Burning Tree Mixed Martial Arts flaming-tree logo" width="707" height="960" loading="eager" decoding="async" />
        <figcaption>“KEEPERS OF THE FLAME”</figcaption>
      </figure>
    </section>
    <nav class="preview-navigation" aria-label="Preview sections">
      <button class="preview-tab" type="button" id="tab-login" aria-controls="preview-login" aria-selected="true">Family Login Preview</button>
      <button class="preview-tab" type="button" id="tab-dashboard" aria-controls="preview-dashboard" aria-selected="false">Student Dashboard Preview</button>
    </nav>
    <section class="preview-view" id="preview-login">
      <div class="panel" style="max-width:600px">
        <h2>Family Login</h2>
        <p class="muted">Only authorized Burning Tree families may sign in. Parents or guardians manage accounts for minor students.</p>
        <div class="fields" aria-label="Example login form; disabled in preview">
          <label>Email Address<input type="email" placeholder="parent@example.com" disabled /></label>
          <label>Password<input type="password" placeholder="••••••••••••" disabled /></label>
          <div class="preview-placeholder" style="min-height:66px">Security verification appears here when launched</div>
          <span class="disabled-control">SECURE SIGN IN — COMING SOON</span>
        </div>
        <p class="muted">Need an account or a password reset? Contact the studio at <a href="tel:+12023684395">(202) 368-4395</a>.</p>
      </div>
    </section>
    <section class="preview-view" id="preview-dashboard" hidden>
      <section class="panel">
        <p class="eyebrow">EXAMPLE ACCOUNT — PREVIEW ONLY</p>
        <h2>Welcome back, Burning Tree Family!</h2>
        <p class="muted">This is how the private student dashboard will look after launch.</p>
      </section>
      <section class="panel">
        <h2>My Students</h2>
        <p class="muted">Your family's programs, belt ranks, and account information will appear here.</p>
        <div class="grid">
          <div class="panel"><strong>Student Profile</strong><p class="muted">Kenpo Karate · Beginner</p></div>
        </div>
      </section>
      <h2>My Video Lessons</h2>
      <div class="grid">
        <article class="panel lesson"><span class="pill">KENPO KARATE</span><h3>Beginner Fundamentals</h3><div class="preview-placeholder" aria-label="Sample video thumbnail">▶ Video lesson preview</div><p class="muted">Practice your techniques between classes.</p></article>
        <article class="panel lesson"><span class="pill">MUAY THAI</span><h3>Striking Basics</h3><div class="preview-placeholder" aria-label="Sample video thumbnail">▶ Video lesson preview</div><p class="muted">Fundamentals and controlled technique.</p></article>
        <article class="panel lesson"><span class="pill">WING CHUN</span><h3>Forms & Techniques</h3><div class="preview-placeholder" aria-label="Sample video thumbnail">▶ Video lesson preview</div><p class="muted">Private lessons assigned by your instructor.</p></article>
      </div>
      <section class="panel">
        <h2>Monthly Tuition &amp; Payment History</h2>
        <p class="muted">Individual balances, due dates, and invoice history will appear once accounts are connected.</p>
        <div class="preview-values"><span><strong>Tuition Balance</strong><p class="muted">Available after setup</p></span><span><strong>Next Due Date</strong><p class="muted">Based on family plan</p></span><span><strong>Payment History</strong><p class="muted">Private to your household</p></span></div>
        <p class="preview-kicker">No charges can be made from this preview.</p>
        <span class="disabled-control">TUITION PAYMENTS — NOT ACTIVE</span>
      </section>
    </section>
    <p class="muted" style="margin-top:30px">This is a design demonstration, not an active student account. The real portal is intentionally locked until approved for launch.</p>
  </main>
  <footer class="foot"><div class="shell"><strong>Keepers of the Flame · One Tree. One Family.</strong><p>Burning Tree Mixed Martial Arts · Owings Mills, Maryland</p></div></footer>
  <script is:inline>
    (() => {
      const login=document.getElementById("preview-login");
      const dashboard=document.getElementById("preview-dashboard");
      const a=document.getElementById("tab-login");
      const b=document.getElementById("tab-dashboard");
      function show(which){
        const selected=which==="dashboard";
        login.hidden=selected;
        dashboard.hidden=!selected;
        a.setAttribute("aria-selected",String(!selected));
        b.setAttribute("aria-selected",String(selected));
      }
      a.addEventListener("click",()=>show("login"));
      b.addEventListener("click",()=>show("dashboard"));
    })();
  </script>
</body>
</html>