---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="$29 New Student Special | Burning Tree MMA"
  description="Two beginner martial arts classes and a free uniform for $29 in Owings Mills, Maryland."
  path="/29-trial"
  image="/images/jr-kenpo-gallery-1.jpg"
>
  <div class="trial-page">
    <section class="hero">
      <img src="/images/logo.png" alt="Burning Tree Mixed Martial Arts" width="90" height="122" />
      <p class="eyebrow">BURNING TREE MIXED MARTIAL ARTS</p>
      <h1>START YOUR MARTIAL ARTS JOURNEY!</h1>
      <p>Confidence. Focus. Discipline. Respect.</p>
      <div class="offer">
        <p class="eyebrow">NEW STUDENT SPECIAL</p>
        <strong class="price">$29</strong>
        <h2>2 Beginner Classes + FREE Uniform</h2>
        <p>One trial per new student. Each sibling registers separately.</p>
      </div>
      <a class="cta" href="#registration">REGISTER YOUR STUDENT</a>
      <p><strong>One Tree. One Family.</strong></p>
    </section>
    <section class="registration" id="registration">
      <h2>Student Registration</h2>
      <p>Register one student at a time. Parents can use the same contact information for multiple children.</p>
      <form id="student-registration" class="form" onsubmit="return false;">
        <div class="cf-turnstile" data-sitekey="0x4AAAAAAD6Ievu-t0Ll1euh"></div>
        <label for="studentType">Who are you registering for?</label>
        <select id="studentType" name="studentType" required>
          <option value="">Select student type</option>
          <option value="minor">Child / minor student</option>
          <option value="adult">Adult student</option>
        </select>
        <label for="studentName">Student's full name</label>
        <input id="studentName" name="studentName" type="text" autocomplete="off" maxlength="120" required />
        <label for="studentAge">Student's age</label>
        <input id="studentAge" name="studentAge" type="number" min="3" max="110" required />
        <div id="guardianFields" hidden>
          <label for="guardianName">Parent / guardian full name</label>
          <input id="guardianName" name="guardianName" type="text" autocomplete="name" maxlength="120" />
        </div>
        <label for="contactEmail">Contact email</label>
        <input id="contactEmail" name="email" type="email" autocomplete="email" required />
        <label for="contactPhone">Contact phone</label>
        <input id="contactPhone" name="phone" type="tel" autocomplete="tel" required />
        <label for="programInterest">Interested program</label>
        <select id="programInterest" name="programInterest" required>
          <option value="">Choose a program</option>
          <option>Kenpo Karate</option>
          <option>Muay Thai</option>
          <option>Wing Chun</option>
        </select>
        <p class="fine-print">By submitting, you agree to our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>.</p>
        <button type="submit" onclick="document.getElementById('setup-note').textContent='Checking form...'">CHECK TRIAL ELIGIBILITY</button>
        <p id="setup-note" class="notice" role="status">We will check the student’s eligibility before payment. Online checkout is not enabled yet.</p>
      </form>
    </section>
    <section class="contact">
      <h2>Questions? We're Here to Help.</h2>
      <p>Call <a href="tel:+14102180894">410-218-0894</a></p>
      <p>10210 S. Dolfield Road, Suite C · Owings Mills, MD 21117</p>
      <p><strong>One Tree. One Family.</strong></p>
    </section>
  </div>
</BaseLayout>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
  const type = document.querySelector("#studentType");
  const guardian = document.querySelector("#guardianFields");
  const guardianName = document.querySelector("#guardianName");
  function syncGuardian() {
    const isMinor = type?.value === "minor";
    if (guardian) guardian.hidden = !isMinor;
    if (guardianName) {
      guardianName.required = isMinor;
      if (!isMinor) guardianName.value = "";
    }
  }
  type?.addEventListener("change", syncGuardian);
  syncGuardian();
  const form = document.querySelector("#student-registration");
  if (form) form.onsubmit = (event) => { event.preventDefault(); return false; };
  const notice = document.querySelector("#setup-note");
  const submit = form?.querySelector('button[type="submit"]');
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) { if (notice) notice.textContent = "Please complete all required fields."; return; }
    const values = new FormData(form);
    const token = values.get("cf-turnstile-response");
    if (!token) {
      if (notice) notice.textContent = "Please complete the security check before continuing.";
      return;
    }
    const payload = Object.fromEntries(values.entries());
    delete payload["cf-turnstile-response"];
    if (submit) submit.disabled = true;
    if (notice) notice.textContent = "Checking trial eligibility...";
    try {
      const response = await fetch("/api/trial-eligibility", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ ...payload, turnstileToken: token })
      });
      const result = await response.json();
      if (notice) notice.textContent = result.message || result.error || "Please contact the studio to verify eligibility.";
    } catch {
      if (notice) notice.textContent = "Eligibility verification is unavailable. Please call 410-218-0894.";
    } finally {
      if (submit) submit.disabled = false;
      const turnstile = window.turnstile;
      turnstile?.reset();
    }
  });
</script>
<style>
  .trial-page{color:var(--text);text-align:center}
  .hero{max-width:820px;margin:auto;padding:45px 20px}
  .hero img{width:auto;height:100px;object-fit:contain}
  .eyebrow{color:var(--accent);font-weight:900;letter-spacing:1px}
  h1{font-size:clamp(2.1rem,6vw,4rem);line-height:1.1;margin:20px 0}
  .offer{border:3px solid var(--accent);border-radius:16px;max-width:560px;margin:28px auto;padding:24px}
  .price{display:block;font-size:clamp(4rem,11vw,7rem);color:var(--accent);line-height:1.1}
  .cta,.form button{display:inline-block;border:0;border-radius:9px;padding:17px 23px;background:var(--accent);color:#fff;font-weight:900;text-decoration:none}
  .registration{max-width:650px;margin:auto;padding:35px 20px 65px}
  .form{display:grid;gap:11px;text-align:left;border:1px solid #ddd;border-radius:16px;padding:25px}
  .form label{font-weight:700;margin-top:8px}
  .form input,.form select{width:100%;box-sizing:border-box;border:1px solid #999;border-radius:8px;padding:13px;font:inherit;background:var(--surface);color:var(--text)}
  #guardianFields:not([hidden]){display:grid;gap:11px}
  .form button:disabled{opacity:.55;cursor:not-allowed}
  .notice,.fine-print{font-size:.9rem;line-height:1.5}
  .contact{padding:40px 20px;background:var(--surface)}
  .contact a{color:var(--accent)}
  @media(max-width:600px){.form{padding:16px}.cta{width:100%;box-sizing:border-box}}
</style>
