---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="$29 New Student Special | Burning Tree MMA"
  description="Two beginner martial arts classes and a free uniform for $29 in Owings Mills, Maryland."
  path="/29-trial"
  image="/images/jr-kenpo-gallery-1.jpg"
>
  <div class="trial-page">
    <section class="hero">
      <img src="/images/logo.png" alt="Burning Tree Mixed Martial Arts" width="90" height="122" />
      <p class="eyebrow">BURNING TREE MIXED MARTIAL ARTS</p>
      <h1>START YOUR MARTIAL ARTS JOURNEY!</h1>
      <p>Confidence. Focus. Discipline. Respect.</p>
      <div class="offer">
        <p class="eyebrow">NEW STUDENT SPECIAL</p>
        <strong class="price">$29</strong>
        <h2>2 Beginner Classes + FREE Uniform</h2>
        <p>One trial per new student. Each sibling registers separately.</p>
      </div>
      <a class="cta register-student-cta" href="#registration">REGISTER YOUR STUDENT</a>
      <p><strong>One Tree. One Family.</strong></p>
    </section>
    <nav class="trial-steps" aria-label="Three steps to get started"><ol>
      <li id="trial-step-1" class="current" aria-current="step"><strong>1</strong><span>Student Registration</span></li>
      <li id="trial-step-2"><strong>2</strong><span>Pay $29</span></li>
      <li id="trial-step-3"><strong>3</strong><span>Enrollment Questionnaire</span></li>
    </ol><p>Three steps: enter student details, complete payment, then tell us about your goals so we can prepare for your first classes.</p></nav>
    <section class="registration" id="registration">
      <h2>Step 1: Student Registration</h2>
      <p>First enter the student’s essential details and choose a martial art. Next choose how to pay $29. After payment is verified, Step 3 collects goals and training preferences. Siblings may share parent contact details but register separately.</p>
      <p class="first-class-help">First time on the mats? <a href="/your-first-class">See what to wear, where to park, and what happens after you register.</a></p>
      <form id="student-registration" class="form">
        <div id="step-one-fields">
        <label for="studentType">Who are you registering for?</label>
        <select id="studentType" name="studentType" required>
          <option value="">Select student type</option>
          <option value="minor">Child / minor student</option>
          <option value="adult">Adult student</option>
        </select>
        <label for="studentName">Student's full name</label>
        <input id="studentName" name="studentName" type="text" autocomplete="off" maxlength="120" required />
        <p id="dob-label" class="form-heading">Student's date of birth</p>
        <div class="dob-fields" role="group" aria-labelledby="dob-label">
          <label for="dobMonth">Month
            <select id="dobMonth" autocomplete="bday-month" required>
              <option value="">Month</option>
              <option value="01">January</option>
              <option value="02">February</option>
              <option value="03">March</option>
              <option value="04">April</option>
              <option value="05">May</option>
              <option value="06">June</option>
              <option value="07">July</option>
              <option value="08">August</option>
              <option value="09">September</option>
              <option value="10">October</option>
              <option value="11">November</option>
              <option value="12">December</option>
            </select>
          </label>
          <label for="dobDay">Day
            <select id="dobDay" autocomplete="bday-day" required>
              <option value="">Day</option>
              <option value="01">1</option>
              <option value="02">2</option>
              <option value="03">3</option>
              <option value="04">4</option>
              <option value="05">5</option>
              <option value="06">6</option>
              <option value="07">7</option>
              <option value="08">8</option>
              <option value="09">9</option>
              <option value="10">10</option>
              <option value="11">11</option>
              <option value="12">12</option>
              <option value="13">13</option>
              <option value="14">14</option>
              <option value="15">15</option>
              <option value="16">16</option>
              <option value="17">17</option>
              <option value="18">18</option>
              <option value="19">19</option>
              <option value="20">20</option>
              <option value="21">21</option>
              <option value="22">22</option>
              <option value="23">23</option>
              <option value="24">24</option>
              <option value="25">25</option>
              <option value="26">26</option>
              <option value="27">27</option>
              <option value="28">28</option>
              <option value="29">29</option>
              <option value="30">30</option>
              <option value="31">31</option>
            </select>
          </label>
          <label for="dobYear">Year (4 digits)
            <input id="dobYear" type="text" inputmode="numeric" autocomplete="bday-year" minlength="4" maxlength="4" pattern="[0-9]{4}" placeholder="YYYY" title="Enter exactly four numbers for the birth year" required />
          </label>
        </div>
        <input id="studentDob" name="studentDob" type="hidden" />
        <p class="fine-print">Used to help verify each student's eligibility, including siblings sharing contact details.</p>
        <div id="guardianFields" hidden>
          <label for="guardianName">Parent / guardian full name</label>
          <input id="guardianName" name="guardianName" type="text" autocomplete="name" maxlength="120" />
        </div>
        <label for="contactEmail">Contact email</label>
        <input id="contactEmail" name="email" type="email" autocomplete="email" required />
        <label for="contactPhone">Contact phone</label>
        <input id="contactPhone" name="phone" type="tel" autocomplete="tel" required />
        <label for="programInterest">Interested program</label>
        <select id="programInterest" name="programInterest" required>
          <option value="">Choose a program</option>
          <option>Kenpo Karate</option>
          <option>Muay Thai</option>
          <option>Wing Chun</option>
        </select>

        </div>
        <p class="fine-print">By submitting, you agree to our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>.</p>
        <div id="pilotFields" hidden>
          <label for="pilotCode">Private launch test code</label>
          <input id="pilotCode" name="pilotCode" type="password" autocomplete="off" maxlength="128" />
          <p class="fine-print">Only for Burning Tree’s authorized live-payment verification. A real $29 charge will apply.</p>
        </div>
        <div class="form-security">
          <p class="security-caption">Security check</p>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAD6Ievu-t0Ll1euh" data-size="compact"></div>
        </div>
        <p id="setup-note" class="notice" role="status" aria-live="polite">We’ll check eligibility before showing payment options. Cards and Apple Pay use Stripe; direct Cash App payments require manual verification.</p>
        <p id="registration-next-step" class="fine-print">We’ll check the student’s registration, then show available payment methods. You will not be charged by clicking this button.</p>
        <button class="verify-registration-button" type="submit">COMPLETE STEP 1 &amp; CHOOSE PAYMENT</button>
        <div id="payment-stage" hidden>
          <h3>Step 2: Pay $29</h3>
          <p>Card and Apple Pay use secure Stripe checkout. Cash App and Zelle require Coach David to verify the transfer before Step 3 opens.</p>
        <button id="applepay-button" type="button" hidden disabled>APPLE PAY / APPLE CASH — $29</button>
        <button id="checkout-button" type="button" hidden disabled>PAY $29 WITH CREDIT / DEBIT CARD</button>
        <a id="checkout-fallback" class="cta" hidden rel="noopener noreferrer">OPEN SECURE $29 CARD CHECKOUT</a>
        <button id="cashapp-button" type="button" hidden disabled>PAY $29 DIRECTLY WITH CASH APP</button>
        <button id="zelle-button" type="button" hidden disabled>PAY $29 DIRECTLY WITH ZELLE</button>
        <p id="applepay-help" class="payment-help" hidden>Apple Pay opens secure Stripe checkout and appears on supported devices. To use your Apple Cash balance, choose your Apple Cash card in Apple Pay. If Apple Pay is unavailable, you can still use a card. These payments are processed by Stripe, not sent directly to a personal Apple Cash account.</p>
        <div id="cashapp-instructions" class="cashapp-instructions" hidden aria-live="polite">
          <h3>Direct Cash App Payment</h3>
          <p>Send exactly <strong>$29</strong> to <strong>$BTMMA</strong> through Cash App.</p>
          <a class="cta" href="https://cash.app/pay/link/tvqncp9q" rel="noopener noreferrer">OPEN CASH APP — $29 TO $BTMMA</a>
          <p class="fine-print">Before you tap Send, confirm Cash App shows the correct recipient ($BTMMA) and total ($29). If either is different, do not pay; contact the studio.</p>
          <p>Add “BTMMA New Student Special” in the payment note. Once paid, text the student's name and your payment confirmation to <a href="sms:+14102180894">(410) 218-0894</a>.</p>
          <p><strong>Your registration is pending.</strong> We will confirm it only after verifying the $29 payment in our Cash App account. Do not pay again through Stripe.</p>
          <p>Need to change payment methods? Call <a href="tel:+12023684395">(202) 368-4395</a>.</p>
                    <p class="manual-step3-help">After Coach David verifies your payment, return to this page on the same device to complete Step 3.</p>
          <button type="button" class="check-step-three">CHECK PAYMENT &amp; CONTINUE TO STEP 3</button>
<button type="button" id="cashapp-new-student">REGISTER ANOTHER STUDENT</button>
        </div>
        <div id="zelle-instructions" class="cashapp-instructions" hidden aria-live="polite">
          <h3>Direct Zelle Payment — $29</h3>
          <p><strong>Send exactly $29</strong> through Zelle to <strong>410-218-0894</strong>, Coach David's Zelle-enrolled mobile number. This is a <strong>phone number, not a mailing or studio address</strong>.</p>
          <button id="zelle-copy-number" type="button">COPY ZELLE PHONE NUMBER</button>
          <p id="zelle-copy-status" class="fine-print" role="status"></p>
          <p>Open the Zelle option in your bank or credit union's app, enter the mobile number <strong>410-218-0894</strong> and the exact amount <strong>$29.00</strong>.</p>
          <p><strong>Check the recipient name your bank displays before sending.</strong> If the name does not match the person you intend to pay or you're uncertain, do not send the money; contact Coach David first.</p>
          <p>Include <strong>BTMMA $29 New Student Special</strong> in the payment note, if your bank supports payment notes.</p>
          <p>After sending, <strong>text the student's name and your Zelle payment confirmation</strong> to <a href="sms:+14102180894">(410) 218-0894</a>.</p>
          <p><strong>Your registration is pending.</strong> Burning Tree will confirm it only after verifying the $29 transfer was received through Zelle. Choosing this option does not automatically confirm payment. <strong>Do not pay a second time</strong> by card, Apple Pay or Cash App.</p>
          <p>Need help or want to change payment methods? Call or text <a href="tel:+14102180894">(410) 218-0894</a> before sending another payment.</p>
                    <p class="manual-step3-help">After Coach David verifies your payment, return to this page on the same device to complete Step 3.</p>
          <button type="button" class="check-step-three">CHECK PAYMENT &amp; CONTINUE TO STEP 3</button>
<button type="button" id="zelle-new-student">REGISTER ANOTHER STUDENT</button>
        </div>
        </div>
      </form>
    </section>
    <section class="registration" id="checkout-result" aria-live="polite" hidden>
      <div class="offer">
        <h2 id="checkout-result-title">Verifying your payment...</h2>
        <p id="checkout-result-message" role="status">Checking your secure Stripe transaction.</p>
        <p>Please do not make another payment while confirmation is pending.</p>
        <a class="cta" id="step-three-jump" href="#post-payment" hidden>CONTINUE TO STEP 3</a>
        <a class="cta" href="tel:+12023684395">QUESTIONS? CALL (202) 368-4395</a>
      </div>
    </section>
    <section class="registration" id="post-payment" hidden aria-labelledby="post-payment-title">
      <h2 id="post-payment-title">Step 3: Enrollment Questionnaire</h2>
      <p>Payment verified! Please complete this last step to help us prepare for your classes—no need to reenter anything from Step 1.</p>
      <form id="post-payment-questionnaire" class="form">
        <section class="questionnaire-online" aria-labelledby="questionnaire-title">
          <p class="questionnaire-eyebrow">STEP 3 OF 3 — AFTER VERIFIED PAYMENT</p>
          <h3 id="questionnaire-title">Tell Us About Your Goals</h3>
          <p>Your payment is verified. We already have your name, contact information, date of birth and chosen martial art from Step 1.</p>
          <p class="questionnaire-note">Please share your main goal in Question 3. All other questions are optional, and you can discuss them with Coach David later.</p>
<details class="question-group" open><summary>1 / Your goals & motivation<span class="question-hint">Tap to expand or collapse</span></summary><div class="question-content"><div class="question-line"><p class="question-label">1. What interests you about martial arts?</p><div class="question-options"><label class="question-option"><input type="checkbox" name="q1" value="Self-defense" /><span>Self-defense</span></label>
<label class="question-option"><input type="checkbox" name="q1" value="Confidence" /><span>Confidence</span></label>
<label class="question-option"><input type="checkbox" name="q1" value="Discipline / focus" /><span>Discipline / focus</span></label>
<label class="question-option"><input type="checkbox" name="q1" value="Respect" /><span>Respect</span></label>
<label class="question-option"><input type="checkbox" name="q1" value="Fitness" /><span>Fitness</span></label>
<label class="question-option"><input type="checkbox" name="q1" value="Leadership" /><span>Leadership</span></label>
<label class="question-option"><input type="checkbox" name="q1" value="Friendships / social skills" /><span>Friendships / social skills</span></label>
<label class="question-option"><input type="checkbox" name="q1" value="Traditional martial arts" /><span>Traditional martial arts</span></label>
<label class="question-option"><input type="checkbox" name="q1" value="Other" /><span>Other</span></label></div></div>
<div class="question-line"><p class="question-label">2. What motivated you to look into martial arts right now?</p><div class="question-options"><label class="question-option"><input type="checkbox" name="q2" value="Confidence" /><span>Confidence</span></label>
<label class="question-option"><input type="checkbox" name="q2" value="Discipline" /><span>Discipline</span></label>
<label class="question-option"><input type="checkbox" name="q2" value="Safety / bullying" /><span>Safety / bullying</span></label>
<label class="question-option"><input type="checkbox" name="q2" value="After-school activity" /><span>After-school activity</span></label>
<label class="question-option"><input type="checkbox" name="q2" value="Fitness" /><span>Fitness</span></label>
<label class="question-option"><input type="checkbox" name="q2" value="Personal growth" /><span>Personal growth</span></label>
<label class="question-option"><input type="checkbox" name="q2" value="Other" /><span>Other</span></label></div></div>
<div class="question-line"><label for="q3" class="question-label">3. What is your top goal for the next 6–12 months?</label><textarea id="q3" name="q3" rows="2" maxlength="600" placeholder="What would you like to achieve?"></textarea></div>
<div class="question-line"><label for="q4" class="question-label">4. If we helped you or your child accomplish ONE thing, what would make the biggest difference?</label><textarea id="q4" name="q4" rows="2" maxlength="600" placeholder="Tell us what matters most to you."></textarea></div>
<div class="question-line"><p class="question-label">5. Have you or your child trained before?</p><div class="question-options"><label class="question-option"><input type="radio" name="q5" value="Yes" /><span>Yes</span></label>
<label class="question-option"><input type="radio" name="q5" value="No" /><span>No</span></label></div><label class="question-subfield" for="q5Details">If yes, what style and for how long?<input id="q5Details" name="q5Details" type="text" maxlength="120" /></label></div>
<div class="question-line"><p class="question-label">6. Are there specific areas you'd like help with?</p><div class="question-options"><label class="question-option"><input type="checkbox" name="q6" value="Shyness" /><span>Shyness</span></label>
<label class="question-option"><input type="checkbox" name="q6" value="Confidence" /><span>Confidence</span></label>
<label class="question-option"><input type="checkbox" name="q6" value="Focus" /><span>Focus</span></label>
<label class="question-option"><input type="checkbox" name="q6" value="Listening" /><span>Listening</span></label>
<label class="question-option"><input type="checkbox" name="q6" value="Fitness" /><span>Fitness</span></label>
<label class="question-option"><input type="checkbox" name="q6" value="Self-control" /><span>Self-control</span></label>
<label class="question-option"><input type="checkbox" name="q6" value="None" /><span>None</span></label></div></div>
<div class="question-line"><p class="question-label">7. What has prevented you from starting martial arts before?</p><div class="question-options"><label class="question-option"><input type="checkbox" name="q7" value="Schedule" /><span>Schedule</span></label>
<label class="question-option"><input type="checkbox" name="q7" value="Cost" /><span>Cost</span></label>
<label class="question-option"><input type="checkbox" name="q7" value="Finding the right school" /><span>Finding the right school</span></label>
<label class="question-option"><input type="checkbox" name="q7" value="Nervousness" /><span>Nervousness</span></label>
<label class="question-option"><input type="checkbox" name="q7" value="Unsure where to begin" /><span>Unsure where to begin</span></label>
<label class="question-option"><input type="checkbox" name="q7" value="Nothing" /><span>Nothing</span></label>
<label class="question-option"><input type="checkbox" name="q7" value="Other" /><span>Other</span></label></div></div>
<div class="question-line"><p class="question-label">8. How important is earning a black belt?</p><div class="question-options"><label class="question-option"><input type="radio" name="q8" value="Major goal" /><span>Major goal</span></label>
<label class="question-option"><input type="radio" name="q8" value="Somewhat important" /><span>Somewhat important</span></label>
<label class="question-option"><input type="radio" name="q8" value="Personal growth first" /><span>Personal growth first</span></label>
<label class="question-option"><input type="radio" name="q8" value="Unsure" /><span>Unsure</span></label></div></div></div></details>
<details class="question-group" open><summary>2 / Your family, confidence & fit<span class="question-hint">Tap to expand or collapse</span></summary><div class="question-content"><div class="question-line"><label for="q9" class="question-label">9. What matters most when choosing a martial arts school?</label><textarea id="q9" name="q9" rows="2" maxlength="600" placeholder="Tell us what you're looking for."></textarea></div>
<div class="question-line"><label for="q10" class="question-label">10. What would help you feel confident Burning Tree is the right fit?</label><textarea id="q10" name="q10" rows="2" maxlength="600" placeholder="What would you like to see or experience?"></textarea></div>
<div class="question-line"><p class="question-label">11. Are other family members interested in training?</p><div class="question-options"><label class="question-option"><input type="checkbox" name="q11" value="Parents" /><span>Parents</span></label>
<label class="question-option"><input type="checkbox" name="q11" value="Siblings" /><span>Siblings</span></label>
<label class="question-option"><input type="checkbox" name="q11" value="Other relatives" /><span>Other relatives</span></label>
<label class="question-option"><input type="checkbox" name="q11" value="No" /><span>No</span></label>
<label class="question-option"><input type="checkbox" name="q11" value="Maybe later" /><span>Maybe later</span></label></div><label class="question-subfield" for="q11Count">How many additional family members?<input id="q11Count" name="q11Count" type="text" maxlength="120" /></label></div>
<div class="question-line"><label for="q12" class="question-label">12. Anything you would like instructors to know before the first class?</label><textarea id="q12" name="q12" rows="2" maxlength="500" placeholder="Training preferences or questions (optional). Please discuss medical or safety accommodations privately with us."></textarea></div></div></details>
<details class="question-group" open><summary>3 / Training schedule<span class="question-hint">Tap to expand or collapse</span></summary><div class="question-content"><div class="question-line"><p class="question-label">14. How often would you like to train?</p><div class="question-options"><label class="question-option"><input type="radio" name="q14" value="Once weekly" /><span>Once weekly</span></label>
<label class="question-option"><input type="radio" name="q14" value="Twice weekly" /><span>Twice weekly</span></label>
<label class="question-option"><input type="radio" name="q14" value="3+ times weekly" /><span>3+ times weekly</span></label>
<label class="question-option"><input type="radio" name="q14" value="Unlimited" /><span>Unlimited</span></label></div></div>
<div class="question-line"><p class="question-label">15. Which days are convenient?</p><div class="question-options"><label class="question-option"><input type="checkbox" name="q15" value="Monday" /><span>Monday</span></label>
<label class="question-option"><input type="checkbox" name="q15" value="Tuesday" /><span>Tuesday</span></label>
<label class="question-option"><input type="checkbox" name="q15" value="Wednesday" /><span>Wednesday</span></label>
<label class="question-option"><input type="checkbox" name="q15" value="Thursday" /><span>Thursday</span></label>
<label class="question-option"><input type="checkbox" name="q15" value="Friday" /><span>Friday</span></label>
<label class="question-option"><input type="checkbox" name="q15" value="Saturday" /><span>Saturday</span></label>
<label class="question-option"><input type="checkbox" name="q15" value="Sunday" /><span>Sunday</span></label></div></div></div></details>
<details class="question-group" open><summary>4 / Getting started<span class="question-hint">Tap to expand or collapse</span></summary><div class="question-content"><div class="question-line"><p class="question-label">16. After your $29 trial, which options might you like to discuss?</p><div class="question-options"><label class="question-option"><input type="checkbox" name="q16" value="$189 / month unlimited membership" /><span>$189 / month unlimited membership</span></label>
<label class="question-option"><input type="checkbox" name="q16" value="Family membership" /><span>Family membership</span></label>
<label class="question-option"><input type="checkbox" name="q16" value="Leadership opportunities" /><span>Leadership opportunities</span></label>
<label class="question-option"><input type="checkbox" name="q16" value="Help me choose" /><span>Help me choose</span></label>
<label class="question-option"><input type="checkbox" name="q16" value="Not ready to discuss memberships" /><span>Not ready to discuss memberships</span></label></div><p class="questionnaire-note">These are future discussion preferences only; your checkout remains the $29 two-class offer.</p></div>
<div class="question-line"><p class="question-label">17. If the first class goes well, when might you begin?</p><div class="question-options"><label class="question-option"><input type="radio" name="q17" value="Immediately" /><span>Immediately</span></label>
<label class="question-option"><input type="radio" name="q17" value="Within 7 days" /><span>Within 7 days</span></label>
<label class="question-option"><input type="radio" name="q17" value="Within 30 days" /><span>Within 30 days</span></label>
<label class="question-option"><input type="radio" name="q17" value="Exploring" /><span>Exploring</span></label></div></div>
<div class="question-line"><p class="question-label">18. If Burning Tree is a good fit, would you like to review membership options?</p><div class="question-options"><label class="question-option"><input type="radio" name="q18" value="Ready to start" /><span>Ready to start</span></label>
<label class="question-option"><input type="radio" name="q18" value="Review options" /><span>Review options</span></label>
<label class="question-option"><input type="radio" name="q18" value="Have questions" /><span>Have questions</span></label>
<label class="question-option"><input type="radio" name="q18" value="Not yet" /><span>Not yet</span></label></div></div>
<div class="question-line"><p class="question-label">19. How did you hear about us?</p><div class="question-options"><label class="question-option"><input type="radio" name="q19" value="Referral" /><span>Referral</span></label>
<label class="question-option"><input type="radio" name="q19" value="Facebook" /><span>Facebook</span></label>
<label class="question-option"><input type="radio" name="q19" value="Instagram" /><span>Instagram</span></label>
<label class="question-option"><input type="radio" name="q19" value="Google" /><span>Google</span></label>
<label class="question-option"><input type="radio" name="q19" value="Drove by" /><span>Drove by</span></label>
<label class="question-option"><input type="radio" name="q19" value="Community event" /><span>Community event</span></label>
<label class="question-option"><input type="radio" name="q19" value="Other" /><span>Other</span></label></div><label class="question-subfield" for="q19Referrer">Referred by (optional)<input id="q19Referrer" name="q19Referrer" type="text" maxlength="120" /></label><label class="question-subfield" for="q19Other">Other source (optional)<input id="q19Other" name="q19Other" type="text" maxlength="120" /></label></div>
<div class="question-line"><label class="question-label" for="preferredFirstClass">Preferred first class date or time (optional)</label><input id="preferredFirstClass" type="text" name="preferredFirstClass" maxlength="160" placeholder="Example: Next Tuesday after 5 PM" /></div>
<label class="questionnaire-permission"><input type="checkbox" name="contactPermission" value="yes" /><span>You may contact me about this registration, trial scheduling, and follow-up. Promotional text marketing requires separate consent.</span></label></div></details>
          <p class="questionnaire-bottom">Your answers will be saved to the existing student registration. This is not a membership contract.</p>
        </section>


        <p id="post-payment-status" class="notice" role="status" aria-live="polite">Tell us about your main goal, then send your answers securely.</p>
        <button id="post-payment-submit" type="submit">FINISH REGISTRATION — SEND QUESTIONNAIRE</button>
        <button id="step3-new-student" type="button" class="register-more-students">REGISTER ANOTHER STUDENT</button>
      </form>
      <div id="post-payment-done" hidden>
        <h3>All set! Welcome to the Burning Tree family.</h3>
        <p>We've received your enrollment questionnaire. We'll contact you about your first classes.</p>
      </div>
    </section>
    <section class="contact">
      <h2>Questions? We're Here to Help.</h2>
      <p>Call <a href="tel:+12023684395">(202) 368-4395</a></p>
      <p>10210 S. Dolfield Road, Suite C · Owings Mills, MD 21117</p>
      <p><strong>One Tree. One Family.</strong></p>
    </section>
  </div>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
(() => {
  function initializeTrialForm() {
    const form = document.getElementById("student-registration");
    const notice = document.getElementById("setup-note");
    const type = document.getElementById("studentType");
    const guardian = document.getElementById("guardianFields");
    const guardianName = document.getElementById("guardianName");
    const dobMonth = document.getElementById("dobMonth");
    const dobDay = document.getElementById("dobDay");
    const dobYear = document.getElementById("dobYear");
    const studentDob = document.getElementById("studentDob");
    const checkoutButton = document.getElementById("checkout-button");
    const checkoutFallback = document.getElementById("checkout-fallback");
    const applePayButton = document.getElementById("applepay-button");
    const applePayHelp = document.getElementById("applepay-help");
    const cashAppButton = document.getElementById("cashapp-button");
    const cashAppInstructions = document.getElementById("cashapp-instructions");
    const zelleButton = document.getElementById("zelle-button");
    const zelleInstructions = document.getElementById("zelle-instructions");
    const paymentStage = document.getElementById("payment-stage");
    const stepOneFields = document.getElementById("step-one-fields");
    const step3Panel = document.getElementById("post-payment");
    const postForm = document.getElementById("post-payment-questionnaire");
    const postStatus = document.getElementById("post-payment-status");
    const postSubmit = document.getElementById("post-payment-submit");
    const donePanel = document.getElementById("post-payment-done");
    const stepThreeJump = document.getElementById("step-three-jump");
    const pilotFields = document.getElementById("pilotFields");
    const pilotCode = document.getElementById("pilotCode");

    // Only the new Burning Tree GA4 property receives these funnel events.
    // The site's existing global page_view tracking remains unchanged.
    const ga4Id = "G-5M75V93ZV5";
    const offerId = "btmma_29_trial";
    const trialItem = {
      item_id: offerId,
      item_name: "Burning Tree $29 New Student Special",
      price: 29,
      quantity: 1
    };
    const trackTrial = (eventName, eventParams = {}) => {
      try {
        if (typeof window.gtag !== "function") return false;
        // Never include student details, contact information or form data.
        window.gtag("event", eventName, {
          send_to: ga4Id,
          offer_id: offerId,
          ...eventParams
        });
        return true;
      } catch {
        // Analytics must never interrupt eligibility or Stripe payments.
        return false;
      }
    };
    const recordVerifiedPurchase = (sessionId) => {
      // Called only after our server checks the live Stripe session is paid.
      // One browser event per checkout session; transaction_id also enables
      // GA4's purchase deduplication when this page is revisited.
      const key = "btmma_ga4_purchase_" + sessionId;
      try {
        if (window.sessionStorage.getItem(key) === "sent") return;
      } catch { /* Storage may be disabled. */ }
      if (trackTrial("purchase", {
        transaction_id: sessionId,
        currency: "USD",
        value: 29,
        items: [trialItem]
      })) {
        try { window.sessionStorage.setItem(key, "sent"); }
        catch { /* GA4 uses transaction_id to deduplicate as well. */ }
      }
    };
    // Native date pickers can allow a five-digit year in their segmented UI.
    // Keep birth-year entry to four digits and create the ISO date the API expects.
    const syncDob = () => {
      if (!dobMonth || !dobDay || !dobYear || !studentDob) return false;
      const digits = dobYear.value.replace(/[^0-9]/g, "").slice(0, 4);
      if (dobYear.value !== digits) dobYear.value = digits;
      dobYear.setCustomValidity("");
      studentDob.value = "";
      if (!dobMonth.value || !dobDay.value || !/^[0-9]{4}$/.test(digits)) return false;
      const year = Number(digits);
      const month = Number(dobMonth.value);
      const day = Number(dobDay.value);
      const date = new Date(Date.UTC(year, month - 1, day));
      const valid = date.getUTCFullYear() === year &&
        date.getUTCMonth() === month - 1 && date.getUTCDate() === day &&
        date.getTime() <= Date.now();
      if (!valid) {
        dobYear.setCustomValidity("Enter a valid date of birth that is not in the future.");
        return false;
      }
      studentDob.value = digits + "-" + dobMonth.value + "-" + dobDay.value;
      return true;
    };
    dobMonth?.addEventListener("change", syncDob);
    dobDay?.addEventListener("change", syncDob);
    dobYear?.addEventListener("input", syncDob);
    syncDob();
    let grant = null;
    let liveMode = null; // null until the server confirms the current checkout mode.
    let pilotOnly = false;

    // Signed access identifies the student, not payment. The API independently
    // verifies Stripe or staff-confirmed Cash App/Zelle before unlocking Step 3.
    const accessKey = "btmma_trial_questionnaire_access_v1";
    let questionnaireAccess = null;
    try { questionnaireAccess = window.localStorage.getItem(accessKey); }
    catch { /* Stripe checkout returns also carry a verifiable session ID. */ }
    let verifiedSessionId = null;
    const setStep = (num, finished = false) => {
      for (let i = 1; i <= 3; i++) {
        const step = document.getElementById("trial-step-" + i);
        if (!step) continue;
        step.classList.toggle("current", i === num && !finished);
        step.classList.toggle("completed", i < num || finished);
        if (i === num && !finished) step.setAttribute("aria-current", "step");
        else step.removeAttribute("aria-current");
      }
    };
    const showStepThree = (completed = false) => {
      if (step3Panel) step3Panel.hidden = false;
      if (postForm) postForm.hidden = completed;
      if (donePanel) donePanel.hidden = !completed;
      if (stepThreeJump) stepThreeJump.hidden = completed;
      setStep(3, completed);
      if (form) form.hidden = true;
      if (step3Panel && !completed) step3Panel.scrollIntoView({ behavior: "smooth", block: "start" });
      if (completed) {
        try { window.localStorage.removeItem(accessKey); }
        catch { /* Confirmation doesn't require browser storage. */ }
      }
    };
    const checkStepThree = async ({ sessionId = null, quiet = false } = {}) => {
      if (!questionnaireAccess && !sessionId) {
        if (!quiet && notice) notice.textContent = "Please complete Step 1, or contact Coach David for help with your registration.";
        return false;
      }
      try {
        const response = await fetch("/api/trial-questionnaire", {
          method: "POST",
          headers: { "content-type": "application/json" },
          cache: "no-store",
          body: JSON.stringify({ action: "status", accessToken: questionnaireAccess, sessionId })
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || "Payment verification is temporarily unavailable.");
        if (result.paid === true) {
          verifiedSessionId = sessionId || verifiedSessionId;
          showStepThree(result.completed === true);
          return true;
        }
        if (!quiet && notice) notice.textContent = "Your registration is saved, but the $29 payment is still awaiting verification. Please do not pay twice.";
        return false;
      } catch (error) {
        if (!quiet && notice) notice.textContent = error?.message || "Payment verification could not be checked.";
        return false;
      }
    };
    postForm?.addEventListener("submit", async event => {
      event.preventDefault();
      const values = new FormData(postForm);
      const answers = {};
      for (const key of new Set(values.keys())) {
        answers[key] = values.getAll(key).map(value => String(value).trim()).filter(Boolean).join(", ");
      }
      if (!answers.q3?.trim()) {
        if (postStatus) postStatus.textContent = "Please answer question 3 about the student's main goal.";
        document.getElementById("q3")?.focus();
        return;
      }
      if (postSubmit) postSubmit.disabled = true;
      if (postStatus) postStatus.textContent = "Sending your answers securely...";
      try {
        const response = await fetch("/api/trial-questionnaire", {
          method: "POST",
          headers: { "content-type": "application/json" },
          cache: "no-store",
          body: JSON.stringify({
            action: "submit",
            accessToken: questionnaireAccess,
            sessionId: verifiedSessionId,
            answers
          })
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.success !== true)
          throw new Error(result.error || "We could not save your questionnaire.");
        showStepThree(true);
      } catch (error) {
        if (postStatus) postStatus.textContent = error?.message || "Please try again, or contact Coach David.";
      } finally {
        if (postSubmit) postSubmit.disabled = false;
      }
    });
    document.getElementById("step3-new-student")?.addEventListener("click", () => {
      try { window.localStorage.removeItem(accessKey); } catch { /* Optional. */ }
      window.location.assign("/29-trial/#registration");
    });
    document.querySelectorAll(".check-step-three").forEach(button => {
      button.addEventListener("click", () => { void checkStepThree(); });
    });
    const openCheckout = async () => {
      if (!grant || !checkoutButton || liveMode === null) {
        if (notice) notice.textContent = "Please verify the student registration before choosing a payment method.";
        return;
      }
      checkoutButton.disabled = true;
      if (applePayButton) applePayButton.disabled = true;
      if (cashAppButton) cashAppButton.disabled = true;
      if (zelleButton) zelleButton.disabled = true;
      if (checkoutFallback) {
        checkoutFallback.hidden = true;
        checkoutFallback.removeAttribute("href");
      }
      notice.textContent = liveMode ? "Connecting to secure $29 Stripe checkout..." : "Connecting to secure Stripe test checkout...";
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 20000);
      try {
        const response = await fetch(liveMode ? "/api/create-checkout-live" : "/api/create-checkout", {
          method: "POST",
          headers: { "content-type": "application/json" },
          cache: "no-store",
          body: JSON.stringify({ grant }),
          signal: controller.signal
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || "Secure checkout is temporarily unavailable. Please call (202) 368-4395.");
        if (typeof result.url !== "string" || !/^https:\/\/checkout\.stripe\.com\//.test(result.url))
          throw new Error("We couldn't confirm a secure Stripe checkout link. Please call (202) 368-4395.");
        // Give customers a clickable, verified Stripe link if their browser prevents navigation.
        if (checkoutFallback) {
          checkoutFallback.href = result.url;
          checkoutFallback.hidden = false;
        }
        notice.textContent = "Opening secure Stripe checkout. If you are not redirected, tap OPEN SECURE $29 CARD CHECKOUT.";
        // Analytics must never hold up a payment redirect.
        trackTrial("begin_checkout", { currency: "USD", value: 29, items: [trialItem] });
        window.location.assign(result.url);
      } catch (error) {
        notice.textContent = error?.name === "AbortError"
          ? "Secure checkout took too long to respond. Please try the card button again, or call (202) 368-4395."
          : error?.message || "Secure checkout is unavailable. Please call (202) 368-4395.";
        checkoutButton.disabled = false;
        if (applePayButton && liveMode) applePayButton.disabled = false;
        if (cashAppButton && liveMode) cashAppButton.disabled = false;
        if (zelleButton && liveMode) zelleButton.disabled = false;
      } finally {
        clearTimeout(timeout);
      }
    };
    checkoutButton?.addEventListener("click", openCheckout);
    // Both options use the same vetted Stripe session; Stripe shows Apple Pay
    // only when the customer's device, browser and Wallet are eligible.
    applePayButton?.addEventListener("click", openCheckout);
    cashAppButton?.addEventListener("click", async () => {
      if (!grant || !cashAppButton || !checkoutButton || liveMode !== true) return;
      cashAppButton.disabled = true;
      checkoutButton.disabled = true;
      if (applePayButton) applePayButton.disabled = true;
      if (zelleButton) zelleButton.disabled = true;
      notice.textContent = "Preparing direct Cash App payment instructions...";
      try {
        const response = await fetch("/api/trial-cashapp-live", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ grant })
        });
        const result = await response.json();
        if (!response.ok || !result.success || result.state !== "pending_manual_verification")
          throw new Error(result.error || "Cash App payment is unavailable.");
        // Cash App does not report a receipt to this website. Never mark paid here.
        grant = null;
        cashAppButton.hidden = true;
        checkoutButton.hidden = true;
        if (applePayButton) applePayButton.hidden = true;
        if (applePayHelp) applePayHelp.hidden = true;
        if (zelleButton) zelleButton.hidden = true;
        if (cashAppInstructions) cashAppInstructions.hidden = false;
        notice.textContent = "Opening Cash App with $BTMMA and $29. Check the details before sending. We'll verify your payment manually.";
        // Restore receipt instructions only after returning from this approved
        // Cash App selection, not on every future visit to the trial page.
        try {
          const bytes = window.crypto.getRandomValues(new Uint8Array(16));
          const returnToken = Array.from(bytes, b => b.toString(16).padStart(2, "0")).join("");
          window.sessionStorage.setItem("btmma_cashapp_trial_return_v2", returnToken);
          const returnUrl = new URL(window.location.href);
          returnUrl.searchParams.delete("checkout");
          returnUrl.searchParams.delete("session_id");
          returnUrl.searchParams.set("cashapp_return", returnToken);
          window.history.replaceState(window.history.state, "", returnUrl.pathname + returnUrl.search + returnUrl.hash);
        } catch { /* Payment directions remain visible if storage is blocked. */ }
        trackTrial("trial_cashapp_payment_selected");
        // Cash App's amount URL is not universally reliable. Keep an on-page
        // fallback and a clear instruction to verify $BTMMA and $29.
        const paymentUrl = result.paymentUrl;
        if (paymentUrl === "https://cash.app/pay/link/tvqncp9q") {
          window.location.assign(paymentUrl);
        }
      } catch (error) {
        notice.textContent = error?.message || "Please call (202) 368-4395 for payment assistance.";
        cashAppButton.disabled = false;
        checkoutButton.disabled = false;
        if (applePayButton) applePayButton.disabled = false;
        if (zelleButton) zelleButton.disabled = false;
      }
    });
    zelleButton?.addEventListener("click", async () => {
      if (!grant || !zelleButton || !checkoutButton || liveMode !== true) {
        if (notice) notice.textContent = "Please verify the student's registration before choosing Zelle.";
        return;
      }
      zelleButton.disabled = true;
      checkoutButton.disabled = true;
      if (applePayButton) applePayButton.disabled = true;
      if (cashAppButton) cashAppButton.disabled = true;
      notice.textContent = "Preparing secure registration instructions for Zelle. No payment has been charged.";
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 15000);
        let response;
        try {
          response = await fetch("/api/trial-zelle-live", {
            method: "POST",
            headers: { "content-type": "application/json" },
            cache: "no-store",
            body: JSON.stringify({ grant }),
            signal: controller.signal
          });
        } finally {
          clearTimeout(timeout);
        }
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.success !== true ||
            result.state !== "pending_manual_verification" ||
            result.recipientPhone !== "410-218-0894" || result.amount !== 29) {
          throw new Error(result.error || "Zelle instructions could not be verified. Please contact Coach David.");
        }
        // Zelle is a bank-to-bank transfer outside Stripe. Never claim paid.
        grant = null;
        zelleButton.hidden = true;
        checkoutButton.hidden = true;
        if (applePayButton) applePayButton.hidden = true;
        if (cashAppButton) cashAppButton.hidden = true;
        if (applePayHelp) applePayHelp.hidden = true;
        if (checkoutFallback) { checkoutFallback.hidden = true; checkoutFallback.removeAttribute("href"); }
        if (cashAppInstructions) cashAppInstructions.hidden = true;
        if (zelleInstructions) zelleInstructions.hidden = false;
        notice.textContent = "Zelle selected: $29 to Coach David's mobile (410) 218-0894. Registration stays pending until we verify payment.";
        try {
          const bytes = window.crypto.getRandomValues(new Uint8Array(16));
          const returnToken = Array.from(bytes, b => b.toString(16).padStart(2, "0")).join("");
          window.sessionStorage.setItem("btmma_zelle_trial_return_v1", returnToken);
          const url = new URL(window.location.href);
          url.searchParams.delete("checkout");
          url.searchParams.delete("session_id");
          url.searchParams.set("zelle_return", returnToken);
          window.history.replaceState(window.history.state, "", url.pathname + url.search + url.hash);
        } catch { /* Payment instructions remain visible without storage. */ }
        trackTrial("trial_zelle_payment_selected");
        zelleInstructions?.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } catch (error) {
        notice.textContent = error?.name === "AbortError"
          ? "Zelle selection timed out. Please contact Coach David before sending a payment."
          : error?.message || "Zelle is unavailable. Call or text (410) 218-0894.";
        zelleButton.disabled = false;
        checkoutButton.disabled = false;
        if (applePayButton) applePayButton.disabled = false;
        if (cashAppButton) cashAppButton.disabled = false;
      }
    });
    const submit = form?.querySelector('button[type="submit"]');
    if (!form || !notice || !submit) return;
    submit.disabled = true;
    document.getElementById("cashapp-new-student")?.addEventListener("click", () => {
      try { window.localStorage.removeItem(accessKey); } catch { /* Optional browser storage. */ }
      try {
        window.sessionStorage.removeItem("btmma_cashapp_trial_pending");
        window.sessionStorage.removeItem("btmma_cashapp_trial_return_v2");
      } catch { /* Allow reset without storage. */ }
      window.location.assign("/29-trial/");
    });
    document.getElementById("zelle-copy-number")?.addEventListener("click", async () => {
      const status = document.getElementById("zelle-copy-status");
      try {
        await navigator.clipboard.writeText("4102180894");
        if (status) status.textContent = "Copied 410-218-0894. Enter it as a mobile number in your bank's Zelle app.";
      } catch {
        if (status) status.textContent = "Copy this Zelle recipient mobile number: 410-218-0894.";
      }
    });
    document.getElementById("zelle-new-student")?.addEventListener("click", () => {
      try { window.localStorage.removeItem(accessKey); } catch { /* Optional browser storage. */ }
      try { window.sessionStorage.removeItem("btmma_zelle_trial_return_v1"); }
      catch { /* Continue to a fresh registration if storage is disabled. */ }
      window.location.assign("/29-trial/");
    });
    // Verify Stripe's session server-side. The return URL alone is not a receipt.
    const checkoutReturn = new URLSearchParams(window.location.search);
    const checkoutState = checkoutReturn.get("checkout");
    if (checkoutState === "cancelled") {
      trackTrial("trial_checkout_cancelled");
    } else if (checkoutState !== "success") {
      // New landing-page visit (not a Stripe return).
      trackTrial("trial_offer_view");
    }
    if (checkoutState === "success") {
      const panel = document.getElementById("checkout-result");
      const heading = document.getElementById("checkout-result-title");
      const message = document.getElementById("checkout-result-message");
      form.hidden = true;
      if (panel) panel.hidden = false;
      const sessionId = checkoutReturn.get("session_id");
      const valid = typeof sessionId === "string" && /^cs_live_[A-Za-z0-9_]+$/.test(sessionId);
      (async () => {
        if (!valid) {
          if (heading) heading.textContent = "Payment verification needed";
          if (message) message.textContent = "We couldn't verify the return from checkout. If you have a Stripe receipt, call the studio. Please don't make another payment.";
          return;
        }
        try {
          // Stripe redirects can arrive slightly before its signed webhook finishes.
          // Check briefly for final registration confirmation without making a new charge.
          let result;
          for (let attempt = 0; attempt < 5; attempt++) {
            const response = await fetch("/api/trial-checkout-status?session_id=" + encodeURIComponent(sessionId), { cache: "no-store" });
            if (!response.ok) throw new Error("Verification unavailable");
            result = await response.json();
            if (result.status !== "processing" || attempt === 4) break;
            await new Promise(resolve => setTimeout(resolve, 1800));
          }
          // Both statuses mean the server independently verified Stripe's
          // payment_status=paid. "processing" only means Airtable/D1
          // fulfillment is still finishing, not that payment is unverified.
          if (result.status === "confirmed" || result.status === "processing") {
            recordVerifiedPurchase(sessionId);
          }
          if (result.status === "confirmed") {
            if (heading) heading.textContent = "Registration confirmed!";
            if (message) message.textContent = "Your $29 payment and registration are verified. Welcome to Burning Tree! We'll contact you to arrange your two beginner classes and free uniform.";
          } else if (result.status === "processing") {
            if (heading) heading.textContent = "Payment received!";
            if (message) message.textContent = "Stripe confirmed your $29 payment. We're finalizing registration and will follow up about classes. Don't pay again.";
          } else {
            if (heading) heading.textContent = "Payment confirmation pending";
            if (message) message.textContent = "Payment has not yet been confirmed. If you have a Stripe receipt, contact the studio before trying again.";
          }
          // Step 3 is unlocked by a second independent server-side check.
          if (result.status === "confirmed" || result.status === "processing") {
            await checkStepThree({ sessionId });
          }
        } catch {
          if (heading) heading.textContent = "Payment verification pending";
          if (message) message.textContent = "We couldn't check payment status right now. Contact the studio with your Stripe receipt before trying another payment.";
        }
      })();
      return;
    }
    // Do not let old pending flags block new students from registering.
    // Receipt help is restored only when the URL and the original tab's
    // saved token match a verified Cash App selection.
    const cashAppReturnToken = checkoutReturn.get("cashapp_return");
    let cashAppPending = false;
    try {
      cashAppPending = !!cashAppReturnToken && /^[a-f0-9]{32}$/.test(cashAppReturnToken) &&
        window.sessionStorage.getItem("btmma_cashapp_trial_return_v2") === cashAppReturnToken;
      window.sessionStorage.removeItem("btmma_cashapp_trial_pending");
    } catch { /* Default to a fresh registration form. */ }
    if (cashAppPending) {
      if (cashAppInstructions) cashAppInstructions.hidden = false;
      if (checkoutButton) checkoutButton.hidden = true;
      if (cashAppButton) cashAppButton.hidden = true;
      submit.disabled = true;
      notice.textContent = "Your Cash App payment is pending verification. Please text your receipt to (410) 218-0894. Do not pay twice.";
      void checkStepThree({ quiet: true });
      return;
    }
    // Ignore stale or shared return links without this tab's matching token.
    if (cashAppReturnToken) {
      const freshUrl = new URL(window.location.href);
      freshUrl.searchParams.delete("cashapp_return");
      window.history.replaceState(window.history.state, "", freshUrl.pathname + freshUrl.search + freshUrl.hash);
    }
    // Zelle receipt instructions are restored only in the same browser tab
    // after a successful manual-payment selection. A URL alone is not proof.
    const zelleReturnToken = checkoutReturn.get("zelle_return");
    let zellePending = false;
    try {
      zellePending = !!zelleReturnToken && /^[a-f0-9]{32}$/.test(zelleReturnToken) &&
        window.sessionStorage.getItem("btmma_zelle_trial_return_v1") === zelleReturnToken;
    } catch { /* Default to fresh registration if browser storage is unavailable. */ }
    if (zellePending) {
      if (zelleInstructions) zelleInstructions.hidden = false;
      if (checkoutButton) checkoutButton.hidden = true;
      if (applePayButton) applePayButton.hidden = true;
      if (cashAppButton) cashAppButton.hidden = true;
      if (zelleButton) zelleButton.hidden = true;
      if (applePayHelp) applePayHelp.hidden = true;
      submit.disabled = true;
      notice.textContent = "Your $29 Zelle registration is pending manual payment verification. Text your receipt and student's name to (410) 218-0894. Do not pay twice.";
      void checkStepThree({ quiet: true });
      return;
    }
    if (zelleReturnToken) {
      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete("zelle_return");
      window.history.replaceState(window.history.state, "", cleanUrl.pathname + cleanUrl.search + cleanUrl.hash);
    }
    // Check older direct-transfer signups on this device without requiring
    // a duplicate registration or another payment.
    if (questionnaireAccess) { void checkStepThree({ quiet: true }); }
    // Fail closed until the server confirms whether checkout is test or live.
    (async () => {
      try {
        const response = await fetch("/api/trial-eligibility-live", { cache: "no-store" });
        if (!response.ok) throw new Error("Could not verify checkout mode");
        const status = await response.json();
        if (!["locked", "enabled"].includes(status.liveRegistration)) throw new Error("Invalid checkout mode");
        liveMode = status.liveRegistration === "enabled";
        pilotOnly = liveMode && status.pilotOnly !== false;
        if (pilotFields) pilotFields.hidden = !pilotOnly;
        if (pilotCode) pilotCode.required = pilotOnly;
        const returnState = new URLSearchParams(window.location.search).get("checkout");
        notice.textContent = returnState === "success"
          ? "Thank you for completing checkout! We'll verify your payment and follow up about classes."
          : returnState === "cancelled"
          ? "Checkout was cancelled. You have not completed payment."
          : liveMode
          ? pilotOnly
            ? "Private live payment verification is enabled. A real $29 charge applies after approval."
            : "We'll check the student's eligibility before taking a secure $29 payment."
           : "Student registration is available. Online payments are not yet enabled. Call (202) 368-4395 or text (410) 218-0894 for assistance.";
        submit.disabled = false;
      } catch {
        notice.textContent = "Registration is temporarily unavailable. Please call (202) 368-4395.";
      }
    })();
    const syncGuardian = () => {
      const isMinor = type?.value === "minor";
      if (guardian) guardian.hidden = !isMinor;
      if (guardianName) {
        guardianName.required = isMinor;
        if (!isMinor) guardianName.value = "";
      }
    };
    type?.addEventListener("change", syncGuardian);
    syncGuardian();
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      grant = null;
      if (checkoutButton) { checkoutButton.hidden = true; checkoutButton.disabled = true; }
      if (applePayButton) { applePayButton.hidden = true; applePayButton.disabled = true; }
      if (applePayHelp) applePayHelp.hidden = true;
      if (cashAppButton) { cashAppButton.hidden = true; cashAppButton.disabled = true; }
      if (cashAppInstructions) cashAppInstructions.hidden = true;
      if (zelleButton) { zelleButton.hidden = true; zelleButton.disabled = true; }
      if (zelleInstructions) zelleInstructions.hidden = true;
      if (liveMode === null) {
        notice.textContent = "Registration is temporarily unavailable. Please call (202) 368-4395.";
        return;
      }
      notice.textContent = "Validating registration...";
      syncDob();
      if (!form.reportValidity() || !studentDob?.value) {
        notice.textContent = "Please complete all required fields.";
        return;
      }
      const values = new FormData(form);
      const token = values.get("cf-turnstile-response");
      if (!token) {
        notice.textContent = "Please complete the security check before continuing.";
        return;
      }
      const payload = Object.fromEntries(values.entries());
      delete payload["cf-turnstile-response"];
      // Attach optional first-touch metadata. Never put student information in analytics.
      try {
        const firstTouch = JSON.parse(window.localStorage.getItem("btmma_first_touch_v1") || "null");
        if (firstTouch && typeof firstTouch === "object" && !Array.isArray(firstTouch)) {
          payload.attribution = {
            firstLandingPage: firstTouch.firstLandingPage || "",
            acquisitionSource: firstTouch.acquisitionSource || "",
            acquisitionMedium: firstTouch.acquisitionMedium || "",
            utmCampaign: firstTouch.utmCampaign || "",
            originalReferrer: firstTouch.originalReferrer || ""
          };
        }
      } catch { /* Registration must work even without local storage. */ }
      submit.disabled = true;
      notice.textContent = "Checking trial eligibility...";
      trackTrial("trial_form_submitted");
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 15000);
      try {
        const response = await fetch(liveMode ? "/api/trial-eligibility-live" : "/api/trial-eligibility", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ ...payload, turnstileToken: token }),
          signal: controller.signal
        });
        const result = await response.json();
        notice.textContent = result.message || result.error || "Please contact the studio to verify eligibility.";
        if (liveMode && result.success && result.eligible && result.registrationSaved && result.checkoutGrant && checkoutButton) {
          grant = result.checkoutGrant;
          if (typeof result.questionnaireAccess === "string" && /^qt1\.rec[A-Za-z0-9]{14}\.\d{13}\.[a-f0-9]{64}$/.test(result.questionnaireAccess)) {
            questionnaireAccess = result.questionnaireAccess;
            try { window.localStorage.setItem(accessKey, questionnaireAccess); }
            catch { /* Stripe buyers can return with their verified Checkout session. */ }
          }
          setStep(2);
          if (stepOneFields) stepOneFields.hidden = true;
          if (paymentStage) paymentStage.hidden = false;
          submit.hidden = true;
          paymentStage?.scrollIntoView({ behavior: "smooth", block: "start" });
          trackTrial("trial_registration_approved");
          checkoutButton.hidden = false;
          checkoutButton.disabled = false;
          if (applePayButton) { applePayButton.hidden = false; applePayButton.disabled = false; }
          if (applePayHelp) applePayHelp.hidden = false;
          if (cashAppButton) { cashAppButton.hidden = false; cashAppButton.disabled = false; }
          if (zelleButton) { zelleButton.hidden = false; zelleButton.disabled = false; }
          notice.textContent = "Registration approved! Choose Apple Pay / Apple Cash, credit or debit card, direct Cash App, or Zelle. Wallets appear on eligible devices; Cash App and Zelle require manual payment verification.";
        }
      } catch (error) {
        notice.textContent = error?.name === "AbortError"
          ? "Verification timed out. Please try again or call (202) 368-4395."
          : "Eligibility verification is unavailable. Please call (202) 368-4395.";
      } finally {
        clearTimeout(timeout);
        submit.disabled = false;
        window.turnstile?.reset();
      }
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeTrialForm, { once: true });
  } else {
    initializeTrialForm();
  }
})();
</script>
