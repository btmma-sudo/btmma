
---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadForm from "../components/LeadForm.astro";
const checkoutUrl = "https://buy.stripe.com/aFa3cvaLf06hfc869V73G03";
---
<BaseLayout
  title="$29 Martial Arts Trial in Owings Mills | Burning Tree MMA"
  description="Try two beginner martial arts classes and get a free uniform for $29 at Burning Tree MMA in Owings Mills, MD. New students only. Register today."
  path="/29-trial"
  image="/images/jr-kenpo-gallery-1.jpg"
>
  <div class="trial-page">
    <section class="trial-hero">
      <img class="trial-logo" src="/images/logo.png" alt="Burning Tree Mixed Martial Arts" width="100" height="136" />
      <p class="eyebrow">BURNING TREE MIXED MARTIAL ARTS</p>
      <h1>YOUR CHILD IS CAPABLE OF MORE!</h1>
      <p class="intro">Confidence. Focus. Discipline. Respect. Give your child the opportunity to discover what they can accomplish on the mats.</p>
      <div class="offer">
        <p class="offer-label">NEW STUDENT SPECIAL</p>
        <p class="price">$29</p>
        <h2>2 Beginner Classes + FREE Uniform</h2>
        <p>Start with real training in a supportive, family-focused school.</p>
      </div>
      <a class="trial-button" href="#registration">CLAIM YOUR $29 SPECIAL</a>
      <p class="tagline">One Tree. One Family.</p>
    </section>
    <section class="benefits" aria-label="Benefits of martial arts">
      <div><strong>CONFIDENCE</strong><span>Believe in what you can accomplish</span></div>
      <div><strong>FOCUS</strong><span>Build discipline through practice</span></div>
      <div><strong>COMMUNITY</strong><span>Grow in a supportive environment</span></div>
    </section>
    <section class="registration" id="registration">
      <p class="eyebrow">GET STARTED TODAY</p>
      <h2>Two Simple Steps to Get Started</h2>
      <p class="instructions">First, share your contact information so we can help select the right class. Then complete your $29 payment securely through Stripe.</p>
      <div class="steps">
        <div class="step">
          <span class="number">1</span>
          <LeadForm config={{ title: "Tell Us About Your Student", intro: "Complete this form so we can contact you about classes.", submitLabel: "Send My Information" }} />
        </div>
        <div class="step payment">
          <span class="number">2</span>
          <h3>Complete Your $29 Purchase</h3>
          <p>After submitting your information, purchase the special using our secure Stripe checkout. We will reach out to arrange beginner classes.</p>
          <a class="trial-button" href={checkoutUrl} target="_blank" rel="noopener noreferrer">PAY $29 SECURELY</a>
          <p class="note">Please complete both steps. Submitting the form does not process payment. Payment alone does not automatically schedule a class.</p>
        </div>
      </div>
    </section>
    <section class="trial-contact">
      <h2>Questions? We're Here to Help.</h2>
      <p>Call <a href="tel:+14102180894">410-218-0894</a></p>
      <p>10210 S. Dolfield Road, Suite C · Owings Mills, MD 21117</p>
      <p class="tagline">One Tree. One Family.</p>
    </section>
  </div>
</BaseLayout>
<style>
 .trial-page {
  background: var(--bg);
  color: var(--text);
  text-align: center;
}
  .trial-hero{max-width:850px;margin:auto;padding:48px 20px}
  .trial-logo{display:block;height:108px;width:auto;object-fit:contain;margin:0 auto 15px}
  .eyebrow,.offer-label{color:var(--accent);font-weight:900;letter-spacing:1.3px;font-size:.9rem}
  h1{font-size:clamp(2.2rem,6vw,4.2rem);line-height:1.08;font-weight:900;margin:20px 0}
  .intro{font-size:clamp(1.05rem,2.5vw,1.35rem);max-width:680px;margin:auto;line-height:1.55}
  .offer{border:3px solid var(--accent);border-radius:18px;max-width:560px;margin:30px auto;padding:22px;box-shadow:0 8px 28px #0001}
  .offer-label{margin:0}.offer h2{font-size:clamp(1.35rem,4vw,2rem);margin:8px auto}
 .price{color:var(--accent);font-size:clamp(5rem,12vw,7rem);line-height:1;font-weight:900;margin:12px 0}
  .trial-button{display:inline-block;background:var(--accent);color:white!important;text-decoration:none;padding:17px 27px;border-radius:9px;font-size:1rem;font-weight:900;text-align:center;box-shadow:0 6px 14px #0002}
.trial-button:hover,.trial-button:focus{background:var(--accent-soft);font-size:clamp(5rem,12vw,7rem);line-height:1;font-weight:900;margin:12px 0}}.tagline{font-weight:800;margin-top:23px}
  .benefits{background:#171717;color:#fff;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding:28px max(20px,calc((100% - 980px)/2))}
  .benefits div{display:flex;flex-direction:column;gap:7px}.benefits span{font-size:.95rem}
  .registration{padding:60px 20px;max-width:1060px;margin:auto;scroll-margin-top:30px}
  .registration h2{font-size:clamp(1.8rem,4vw,2.4rem)}.instructions{max-width:730px;margin:15px auto 32px;line-height:1.6}
  .steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:25px;text-align:left;align-items:start}
  .step{border:1px solid #ddd;border-radius:14px;padding:21px;min-width:0}.number{display:grid;place-items:center;background:var(--accent);font-size:clamp(5rem,12vw,7rem);line-height:1;font-weight:900;margin:12px 0};color:#fff;width:37px;height:37px;border-radius:50%;font-weight:900;margin-bottom:14px}
  .payment h3{font-size:1.5rem}.payment p{line-height:1.6}.payment .trial-button{margin:14px 0}.note(color:var(--muted);font-size:clamp(5rem,12vw,7rem);line-height:1;font-weight:900;margin:12px 0};font-size:.9rem}
  .trial-contact{background:var(--surface);padding:40px 20px}.trial-contact a{color:var(--accent);font-weight:900}
  @media(max-width:700px){.trial-hero{padding:30px 16px}.steps,.benefits{grid-template-columns:1fr}.step{padding:14px}.trial-button{width:100%;max-width:400px;box-sizing:border-box}}
</style>

