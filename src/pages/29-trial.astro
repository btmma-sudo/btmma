
---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadForm from "../components/LeadForm.astro";
const checkoutUrl = "https://buy.stripe.com/aFa3cvaLf06hfc869V73G03";
---
<BaseLayout
  title="$29 Martial Arts Trial in Owings Mills | Burning Tree MMA"
  description="Try two beginner martial arts classes and get a free uniform for $29 at Burning Tree MMA in Owings Mills, MD. New students only. Register today."
  path="/29-trial"
  image="/images/jr-kenpo-gallery-1.jpg"
>
  <div class="trial-page">
    <section class="trial-hero">
      <img class="trial-logo" src="/images/logo.png" alt="Burning Tree Mixed Martial Arts" width="100" height="136" />
      <p class="eyebrow">BURNING TREE MIXED MARTIAL ARTS</p>
      <h1>YOUR CHILD IS CAPABLE OF MORE!</h1>
      <p class="intro">Confidence. Focus. Discipline. Respect. Give your child the opportunity to discover what they can accomplish on the mats.</p>
      <div class="offer">
        <p class="offer-label">NEW STUDENT SPECIAL</p>
        <p class="price">$29</p>
        <h2>2 Beginner Classes + FREE Uniform</h2>
        <p>Start with real training in a supportive, family-focused school.</p>
      </div>
      <a class="trial-button" href="#registration">CLAIM YOUR $29 SPECIAL</a>
      <p class="tagline">One Tree. One Family.</p>
    </section>
    <section class="benefits" aria-label="Benefits of martial arts">
      <div><strong>CONFIDENCE</strong><span>Believe in what you can accomplish</span></div>
      <div><strong>FOCUS</strong><span>Build discipline through practice</span></div>
      <div><strong>COMMUNITY</strong><span>Grow in a supportive environment</span></div>
    </section>
    <section class="registration" id="registration">
      <p class="eyebrow">GET STARTED TODAY</p>
      <h2>Two Simple Steps to Get Started</h2>
      <p class="instructions">First, share your contact information so we can help select the right class. Then complete your $29 payment securely through Stripe.</p>
      <div class="steps">
        <div class="step">
          <span class="number">1</span>
          <LeadForm config={{ title: "Tell Us About Your Student", intro: "Complete this form so we can contact you about classes.", submitLabel: "Send My Information" }} />
        </div>
        <div class="step payment">
          <span class="number">2</span>
          <h3>Complete Your $29 Purchase</h3>
          <p>After submitting your information, purchase the special using our secure Stripe checkout. We will reach out to arrange beginner classes.</p>
          <a class="trial-button" href={checkoutUrl} target="_blank" rel="noopener noreferrer">PAY $29 SECURELY</a>
          <p class="note">Please complete both steps. Submitting the form does not process payment. Payment alone does not automatically schedule a class.</p>
        </div>
      </div>
    </section>
    <section class="trial-contact">
      <h2>Questions? We're Here to Help.</h2>
      <p>Call <a href="tel:+14102180894">410-218-0894</a></p>
      <p>10210 S. Dolfield Road, Suite C · Owings Mills, MD 21117</p>
      <p class="tagline">One Tree. One Family.</p>
    </section>
  </div>
</BaseLayout>
<style>
  /* Keep the $29 offer readable and usable on phones, tablets, and desktops. */
  .trial-page {
    background: var(--bg);
    color: var(--text);
    text-align: center;
    max-width: 100%;
  }
  .trial-hero {
    width: min(100%, 850px);
    margin: auto;
    padding: clamp(2rem, 5vw, 3rem) 1rem;
  }
  .trial-logo {
    display: block;
    width: auto;
    max-width: 110px;
    height: 108px;
    object-fit: contain;
    margin: 0 auto 1rem;
  }
  .trial-page .eyebrow,
  .offer-label {
    color: #ff8989;
    font-size: .9rem;
    font-weight: 900;
    letter-spacing: .07em;
  }
  .trial-hero h1 {
    color: #fff;
    font-size: clamp(2rem, 6vw, 4.2rem);
    line-height: 1.12;
    margin: 1.1rem 0;
    overflow-wrap: break-word;
  }
  .intro {
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    max-width: 680px;
    line-height: 1.55;
    margin: 0 auto;
  }
  .offer {
    width: min(100%, 560px);
    border: 3px solid #d51b1b;
    border-radius: 18px;
    margin: 1.8rem auto;
    padding: clamp(1rem, 4vw, 1.4rem);
    box-shadow: 0 8px 28px #0003;
  }
  .offer-label { margin: 0; }
  .offer h2 {
    color: #fff;
    font-size: clamp(1.35rem, 4vw, 2rem);
    margin: .5rem auto;
    line-height: 1.18;
  }
  .offer p:last-child { margin-bottom: 0; }
  .price {
    color: #ff7373;
    font-size: clamp(4.5rem, 12vw, 7rem);
    line-height: 1;
    font-weight: 900;
    margin: .7rem 0;
  }
  .trial-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #b20d16;
    border: 2px solid #d8202c;
    color: #fff !important;
    text-decoration: none;
    padding: .9rem 1.25rem;
    min-height: 3.3rem;
    max-width: 100%;
    border-radius: 9px;
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 900;
    text-align: center;
    overflow-wrap: break-word;
    transition: background .2s ease;
  }
  .trial-button:hover,
  .trial-button:focus-visible { background: #d1222e; }
  .tagline { font-weight: 800; margin-top: 1.4rem; }
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    background: #171717;
    color: #fff;
    padding: 1.8rem max(1rem, calc((100% - 980px) / 2));
  }
  .benefits > div { display: flex; flex-direction: column; gap: .45rem; min-width: 0; }
  .benefits span { font-size: .95rem; }
  .registration {
    width: min(100%, 1060px);
    padding: clamp(2.2rem, 5vw, 3.75rem) 1rem;
    margin: auto;
    scroll-margin-top: 7rem;
  }
  .registration h2 { font-size: clamp(1.65rem, 4vw, 2.4rem); color: #fff; }
  .instructions { max-width: 730px; margin: 1rem auto 2rem; line-height: 1.6; }
  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
    text-align: left;
  }
  .step {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: clamp(.9rem, 2.6vw, 1.35rem);
  }
  .number {
    display: inline-grid;
    place-items: center;
    background: #b20d16;
    color: #fff;
    width: 2.4rem;
    height: 2.4rem;
    line-height: 1;
    font-size: 1rem;
    font-weight: 900;
    border-radius: 50%;
    margin: 0 0 1rem;
  }
  .payment h3 { color: #fff; font-size: 1.5rem; }
  .payment p { line-height: 1.6; }
  .payment .trial-button { margin: .9rem 0; }
  .note { color: var(--muted); font-size: .9rem; line-height: 1.5; }
  .trial-contact { background: var(--surface); padding: 2.5rem 1rem; }
  .trial-contact h2 { color: #fff; }
  .trial-contact a { color: #ff8989; font-weight: 900; }
  @media (max-width: 800px) {
    .steps { grid-template-columns: minmax(0, 1fr); }
    .benefits { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 700px) {
    .trial-hero { padding: 2rem 1rem; }
    .step { padding: 1rem; }
    .trial-button { width: 100%; }
    .registration { scroll-margin-top: 5rem; }
  }
</style>
