---
import {getPortalEnv, getPortalAccount, secureHeaders} from "../lib/student-portal-auth.js";
import StudentPortalPreview from "../components/StudentPortalPreview.astro";
export const prerender = false;
const env = getPortalEnv(Astro.locals);
const account = await getPortalAccount(Astro.request,env);
let loginReady = false;
if (env?.TURNSTILE_SECRET_KEY) {
  try {
    const exists = await env.LIVE_TRIAL_DB.prepare("SELECT 1 AS found FROM sqlite_master WHERE type='table' AND name='portal_accounts' LIMIT 1").first();
    loginReady = !!exists;
  } catch { /* Fail closed while the household database is being prepared. */ }
}
const errors = {invalid:"Your login could not be verified. Check your details and try again.",security:"Please complete the security check and try again."};
const code = Astro.url.searchParams.get("error");
const err = code === "invalid" ? errors.invalid : code === "security" ? errors.security : "";
// Demo view is static and contains NO real student information or payment operations.
const showPreview = Astro.url.searchParams.get("preview") === "1";
let students = [], lessons = [], invoices = [], stripeNotice = "";
let billingReady = false;
let paymentEnabled = false;
if (account) {
  try {
    const people = await env.LIVE_TRIAL_DB.prepare(
      "SELECT display_name, program, belt_rank FROM portal_students WHERE account_id=? AND active=1 ORDER BY display_name LIMIT 12"
    ).bind(account.id).all();
    students = people.results || [];
    const available = await env.LIVE_TRIAL_DB.prepare(
      "SELECT l.id, l.title, l.description, l.program, l.stream_uid FROM portal_lessons l JOIN portal_lesson_access a ON a.lesson_id=l.id WHERE a.account_id=? AND l.published=1 ORDER BY l.sort_order, l.title LIMIT 12"
    ).bind(account.id).all();
    lessons = (available.results || []).map((row: any)=>({...row, playableUrl:""}));
    if (env.STUDENT_PORTAL_STREAM_ACCOUNT_ID && env.STUDENT_PORTAL_STREAM_API_TOKEN) {
      const accountId = String(env.STUDENT_PORTAL_STREAM_ACCOUNT_ID);
      if (/^[a-f0-9]{32}$/.test(accountId)) {
        lessons = await Promise.all(lessons.map(async (lesson: any) => {
          if (!/^[a-f0-9]{32}$/.test(lesson.stream_uid)) return lesson;
          try {
            const r = await fetch("https://api.cloudflare.com/client/v4/accounts/" + accountId + "/stream/" + lesson.stream_uid + "/token", {
              method:"POST",
              headers:{"Authorization":"Bearer "+env.STUDENT_PORTAL_STREAM_API_TOKEN,"Content-Type":"application/json"},
              body:JSON.stringify({ exp:Math.floor(Date.now()/1000)+1800, downloadable:false })
            });
            const data = r.ok ? await r.json() : null;
            if (data?.success && /^[A-Za-z0-9_.-]{50,3000}$/.test(data?.result?.token || ""))
              return {...lesson, playableUrl:"https://iframe.videodelivery.net/"+data.result.token};
          } catch { /* Fail closed: do not display an unsigned video URL. */ }
          return lesson;
        }));
      }
    }
  } catch { stripeNotice = "Your lesson information is temporarily unavailable. Please contact the studio."; }
  paymentEnabled = env.STUDENT_PORTAL_PAYMENTS_ENABLED === "true" &&
    /^bpc_[A-Za-z0-9]+$/.test(String(env.STUDENT_PORTAL_STRIPE_PORTAL_CONFIGURATION_ID || "")) &&
    /^(sk|rk)_live_/.test(String(env.STRIPE_LIVE_SECRET_KEY || ""));
  billingReady = paymentEnabled && /^cus_[A-Za-z0-9]+$/.test(account.stripe_customer_id || "");
  if (billingReady) {
    try {
      const response = await fetch("https://api.stripe.com/v1/invoices?customer=" +
        encodeURIComponent(account.stripe_customer_id) + "&limit=12", {
        headers:{"Authorization":"Bearer "+env.STRIPE_LIVE_SECRET_KEY}
      });
      if (response.ok) {
        const result = await response.json();
        invoices = (result.data || []).filter((i: any)=>i.livemode===true &&
          i.customer===account.stripe_customer_id).map((i: any)=>({
          number: String(i.number || "Invoice").slice(0,60),
          due: Number.isInteger(i.due_date) ? new Intl.DateTimeFormat("en-US",{timeZone:"America/New_York",year:"numeric",month:"short",day:"numeric"}).format(new Date(i.due_date*1000)) : "See invoice",
          balance: new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(Math.max(0,Number(i.amount_remaining || 0))/100),
          status: String(i.status || "unknown").slice(0,20)
        }));
      } else stripeNotice = "Your billing history is temporarily unavailable.";
    } catch { stripeNotice = "Your billing history is temporarily unavailable."; }
  }
}
for (const [key,value] of Object.entries(secureHeaders())) Astro.response.headers.set(key,value);
// Astro compiles page/component <style> blocks into same-origin /_astro/*.css assets.
// Allow same-origin stylesheets and scripts; keep unrelated external origins blocked.
Astro.response.headers.set("Content-Security-Policy", "default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://challenges.cloudflare.com https://iframe.videodelivery.net; connect-src 'self' https://challenges.cloudflare.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>Student Portal | Burning Tree Mixed Martial Arts</title>
  <meta name="description" content="Private Burning Tree student lessons and family tuition access." />
  <style is:inline>
    *{box-sizing:border-box}body{margin:0;background:#111416;color:#f6f7f8;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.55}a{color:#fff}button,input{font:inherit}.shell{max-width:1100px;margin:auto;padding:0 22px}.top{border-bottom:1px solid #383e41;background:#07090b}.top-inner{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:85px}.brand{display:flex;align-items:center;gap:14px;text-decoration:none;font-weight:800;letter-spacing:.02em}.brand img{width:50px;height:65px;object-fit:contain}.back{font-size:.9rem;text-decoration:none;padding:10px 12px;border:1px solid #555;border-radius:8px}.back:hover,.back:focus{border-color:#fc4a40}.hero{padding:54px 0 30px}.eyebrow{letter-spacing:.18em;color:#fb6b5e;font-size:.78rem;font-weight:800}.hero h1{font-size:clamp(2rem,5vw,3.6rem);line-height:1.12;margin:8px 0 16px}.hero p{color:#d6d8da;max-width:690px}.red{color:#f85a50}.content{padding-bottom:72px}.panel{border:1px solid #3b4348;background:#1c2023;border-radius:18px;padding:25px;margin:18px 0;box-shadow:0 10px 30px #0002}.panel h2{font-size:1.35rem;margin:0 0 10px}.muted{color:#bfc5c8}.notice{border-left:4px solid #e7574f;background:#2c2423;padding:12px 16px;border-radius:4px}.fields{display:grid;gap:15px;max-width:480px}.fields label{font-weight:700;display:grid;gap:5px}.fields input{width:100%;background:#fff;color:#141414;padding:13px 15px;border:2px solid transparent;border-radius:8px}.fields input:focus{outline:2px solid #fb6257}.btn{display:inline-block;background:#c52724;color:#fff;border:0;border-radius:9px;text-decoration:none;padding:13px 20px;font-weight:800;cursor:pointer}.btn:hover,.btn:focus{background:#a91a18}.secondary{background:#363b3d}.secondary:hover{background:#555}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:18px}.grid .panel{margin:0}.pill{display:inline-block;font-size:.74rem;letter-spacing:.04em;text-transform:uppercase;padding:3px 9px;border:1px solid #b54843;border-radius:50px;color:#ffaaa5}.lesson{padding:20px}.lesson h3{margin:8px 0}.player{position:relative;padding-top:56.25%;border-radius:12px;overflow:hidden;background:#090b0d;margin:12px 0}.player iframe{border:0;position:absolute;inset:0;width:100%;height:100%}.price-table{width:100%;border-collapse:collapse}.price-table th,.price-table td{text-align:left;padding:12px 8px;border-bottom:1px solid #444}.price-table th{font-size:.82rem;color:#ccc}.foot{color:#b9bdc0;border-top:1px solid #383e41;padding:28px 0;text-align:center;font-size:.9rem}@media(max-width:520px){.top-inner{min-height:72px}.brand img{height:52px;width:38px}.brand span{font-size:.85rem}.back{font-size:.8rem}.panel{padding:19px}.price-table{font-size:.85rem}} 
    /* Portal-only logo treatment: the existing Burning Tree mark plus the
       Keepers of the Flame motto, without altering any public-site branding. */
    .btn:disabled{cursor:not-allowed;opacity:.58;background:#6e2927}.fields input:disabled{background:#c9ced0;color:#444;cursor:not-allowed}
    .portal-preview-callout{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;border-color:#a44842}
    .portal-preview-callout>div{max-width:610px}
    .portal-preview-callout h2{margin:3px 0 8px;font-size:1.45rem}
    .portal-preview-callout p.muted{margin:0}
    .portal-preview-callout .btn{white-space:normal;text-align:center}
    @media(max-width:620px){.portal-preview-callout .btn{width:100%}}
    .brand .brand-title{display:block;font-size:12px;letter-spacing:.09em;line-height:1.25}
    .brand .brand-subtitle{display:block;color:#ffb6af;font-size:11px;letter-spacing:.12em;line-height:1.5}
    .top .brand img{width:54px;height:74px;object-fit:contain}
    .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(210px,290px);align-items:center;gap:26px}
    .hero-intro{min-width:0}
    .portal-identity{margin:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;background:#080a0c;border:1px solid #373a3c;border-radius:16px;padding:18px 10px 20px}
    .portal-identity img{display:block;width:min(100%,215px);height:auto;max-height:292px;object-fit:contain;object-position:center}
    .portal-identity figcaption{color:#ededee;font-size:11px;font-style:italic;letter-spacing:.08em;text-align:center}
    @media(max-width:720px){.hero{grid-template-columns:1fr;gap:22px;padding-top:34px}.portal-identity{order:-1;justify-self:center;width:min(100%,260px);padding:12px 10px}.portal-identity img{width:min(100%,175px);max-height:238px}.brand .brand-title{font-size:11px}.brand .brand-subtitle{font-size:10px}.top .brand img{width:41px;height:57px}}

    /* Screenshot-matched design: screenshot preview and signed-in area share
       simple near-black surfaces, bright white type and red accents. */
    html{background:#111315}
    body{background:#111315;color:#f5f6f7}
    .shell{max-width:1040px;padding-inline:clamp(18px,4vw,32px)}
    .top{background:#080a0c;border-bottom:1px solid #40464b}
    .top-inner{min-height:74px;padding-block:9px}
    .top .brand{color:#f8f8f9;gap:12px;font-size:.9rem}
    .top .brand span,.top .brand .brand-title{color:#fff;font-weight:800}
    .top .brand .brand-subtitle{color:#f5b3ae;font-weight:750}
    .top .brand img{display:block;background:#fff;border:2px solid #f6f6f6;border-radius:6px;object-fit:contain;width:49px;height:65px}
    .top .back{color:#f7f7f7;background:#262a2e;border:1px solid #555e63;text-decoration:none}
    .top .back:hover{background:#34393f}
    .content{padding-bottom:48px}
    .hero{display:block;padding:34px 0 12px}
    .hero .eyebrow{font-size:.81rem;color:#f17c75;font-weight:850;letter-spacing:.2em;margin:0 0 17px}
    .hero h1{font-size:clamp(1.9rem,5.8vw,2.9rem);font-weight:850;letter-spacing:-.035em;line-height:1.11;color:#f9f9fa;margin:0 0 19px}
    .hero h1 .red{color:#f3645d}
    .hero p{font-size:clamp(.95rem,2.8vw,1.09rem);color:#bfc5c9;line-height:1.65;max-width:690px;margin:0 0 22px}
    .hero .portal-motto{display:block;color:#fff;font-size:1rem;font-weight:800;margin:0 0 10px}
    .portal-tabs{display:flex;align-items:stretch;gap:10px;flex-wrap:wrap;margin:10px 0 20px}
    .portal-tab{display:inline-flex;align-items:center;justify-content:center;min-height:48px;text-align:center;padding:11px 17px;border:1px solid #5a6165;background:#272c30;border-radius:10px;color:#fff;font-size:.92rem;font-weight:800;text-decoration:none;line-height:1.35}
    .portal-tab.selected{background:#c52b28;color:#fff;border-color:#c52b28}
    .portal-tab:not(.selected):hover,.portal-tab:not(.selected):focus-visible{background:#42484c}
    .portal-tab:focus-visible{outline:2px solid #fff;outline-offset:3px}
    .panel{background:#1c2226;border-color:#414a50;box-shadow:none}
    .panel h2,h2,h3,strong{color:#f6f7f8}
    .muted{color:#bfc6ca}
    #login-title{font-size:1.65rem}
    .fields label{color:#f7f7f7}
    .fields input{border:1px solid #6c7378}
    .member-welcome,.member-students,.member-tuition{margin-top:19px}
    .member-welcome h2{font-size:clamp(1.45rem,4.2vw,1.9rem);line-height:1.28}
    .member-students h2,.member-lessons h2,.member-tuition h2{font-size:clamp(1.55rem,4.4vw,2rem);line-height:1.16;letter-spacing:-.025em;font-weight:800;margin:0 0 18px}
    .member-profiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
    .member-student-card{padding:17px 18px;border:1px solid #424b50;border-radius:12px;background:#1b2024}
    .member-student-card strong{font-size:1.08rem}
    .member-student-card p{margin:3px 0}
    .member-lessons{margin:30px 0 26px}
    .member-lesson-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .member-lesson-card{min-width:0;display:flex;flex-direction:column;margin:0;padding:16px 13px;border-radius:15px}
    .member-lesson-card .pill{align-self:start;margin-bottom:12px}
    .member-lesson-card h3{font-size:clamp(1rem,3.3vw,1.28rem);line-height:1.35;margin:0 0 6px}
    .member-lesson-card .muted{font-size:.89rem;margin:0 0 12px}
    .member-lesson-card .player{margin:0 0 14px}
    .member-tuition .price-table{width:100%;font-size:.93rem}
    .member-tuition .price-table th,.member-tuition .price-table td{color:#e3e4e6;border-color:#495058}
    .member-tuition .notice{color:#ffd8d4}
    .foot{color:#c1c5c8}
    @media(min-width:850px){.member-lesson-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media(max-width:520px){
      .top .brand img{width:38px;height:53px}
      .top .brand .brand-title{font-size:.8rem}
      .top .brand .brand-subtitle{font-size:.73rem}
      .top .back{font-size:.75rem;padding:8px}
      .hero{padding:30px 0 12px}
      .portal-tab{padding:10px 14px;font-size:.85rem}
      .member-lesson-grid{gap:10px}
      .member-lesson-card{padding:13px 10px}
      .member-lesson-card .pill{font-size:.65rem}
      .member-welcome,.member-students,.member-tuition{padding:20px 16px}
    }
    @media(max-width:330px){.portal-tab{font-size:.79rem}.member-lesson-card{padding:11px 8px}}
  </style>
</head>
<body>
  <header class="top"><div class="shell top-inner">
    <a class="brand" href="/"><img src="/images/logo.png" alt="Burning Tree Mixed Martial Arts flaming-tree logo" width="54" height="74" /><span><span class="brand-title">BURNING TREE</span><span class="brand-subtitle">STUDENT PORTAL</span></span></a>
    <a class="back" href="/">Main Website</a>
  </div></header>
  <main class="shell content">
    <section class="hero" aria-labelledby="student-portal-welcome">
      <div class="hero-intro">
        <p class="eyebrow">KEEPERS OF THE FLAME</p>
        <h1 id="student-portal-welcome">Welcome to Your<br/><span class="red">Training Home.</span></h1>
        <p>Continue learning beyond the mats. Access private instructional videos, view your family's training information, and manage tuition securely.</p>
        <strong class="portal-motto">One Tree. One Family.</strong>
      </div>
    </section>
    {!account && (
      <nav class="portal-tabs" aria-label="Portal access and preview">
        <a href="/student-portal/" class={!showPreview ? "portal-tab selected" : "portal-tab"} aria-current={!showPreview ? "page" : undefined}>Student Login</a>
        <a href="/student-portal/?preview=1" class={showPreview ? "portal-tab selected" : "portal-tab"} aria-current={showPreview ? "page" : undefined}>See Dashboard Preview</a>
      </nav>
    )}
    {!account && showPreview ? (
      <StudentPortalPreview />
    ) : !account ? (
      <>
      <section class="panel" aria-labelledby="login-title">
        <h2 id="login-title">Family Login</h2>
        <p class="muted">Only currently authorized Burning Tree families may sign in. Parents or guardians should manage accounts for minor students.</p>
        {!loginReady && <p class="notice" role="status">We’re getting individual family accounts ready. You can view the portal design now, but student sign-in is not accepting logins yet. For account help, call or text Coach David at 410-218-0894.</p>}
        {err && <p class="notice" role="alert">{err}</p>}
        <form method="post" action="/api/student-portal/login" class="fields">
          <label>Email Address<input name="email" type="email" autocomplete="username" maxlength="254" disabled={!loginReady} required /></label>
          <label>Password<input name="password" type="password" autocomplete="current-password" minlength="12" maxlength="200" disabled={!loginReady} required /></label>
          {loginReady && <div class="cf-turnstile" data-sitekey="0x4AAAAAAD6Ievu-t0Ll1euh" data-theme="dark"></div>}
          <button type="submit" class="btn" disabled={!loginReady}>{loginReady ? "SECURE SIGN IN" : "STUDENT LOGINS COMING SOON"}</button>
        </form>
        <p class="muted">Need help with your account, signing in, or a password reset? Contact Coach David directly at <a href="tel:+14102180894">410-218-0894</a> (call or <a href="sms:+14102180894">text</a>). Accounts are created by staff; public registration is disabled.</p>
        {loginReady && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
      </section>
      </>
    ) : (
      <>
        <section class="panel member-welcome">
          <div style="display:flex;gap:15px;align-items:center;justify-content:space-between;flex-wrap:wrap">
            <div><p class="eyebrow">SIGNED IN</p><h2>Welcome back, {account.display_name}!</h2><p class="muted">Your private training dashboard.</p></div>
            <form action="/api/student-portal/logout" method="post"><button class="btn secondary" type="submit">Sign out</button></form>
          </div>
        </section>
        <section class="panel member-students" aria-labelledby="people-title">
          <h2 id="people-title">My Students</h2>
          {students.length ? <div class="member-profiles">
            {students.map((student: any)=><article class="member-student-card">
              <strong>{student.display_name}</strong><p class="muted">{student.program} · {student.belt_rank}</p>
            </article>)}
          </div> : <p class="muted">Your student profiles will appear once your enrollment is connected.</p>}
        </section>
        <section class="member-lessons" aria-labelledby="lessons-title">
          <h2 id="lessons-title">My Video Lessons</h2>
          {stripeNotice && <p class="notice">{stripeNotice}</p>}
          {lessons.length ? <div class="member-lesson-grid">
            {lessons.map((lesson: any)=><article class="panel member-lesson-card">
              <span class="pill">{lesson.program}</span><h3>{lesson.title}</h3><p class="muted">{lesson.description}</p>
              {lesson.playableUrl ? <div class="player"><iframe title={lesson.title} src={lesson.playableUrl} allow="accelerometer; gyroscope; encrypted-media; picture-in-picture" allowfullscreen loading="lazy" referrerpolicy="no-referrer"></iframe></div> :
                <p class="muted">This private video is not available yet. Check back after the instructor publishes it.</p>}
            </article>)}
          </div> : <div class="panel"><p class="muted">Your instructor has not assigned any private lessons yet. Your Kenpo, Muay Thai, Wing Chun, and Leadership video lessons will appear here as they are approved.</p></div>}
        </section>
        <section class="panel member-tuition" aria-labelledby="tuition-title">
          <h2 id="tuition-title">Monthly Tuition &amp; Payments</h2>
          <p class="muted">Your exact tuition and due dates come from your family's approved billing account. The portal does not change your membership rate or automatically add fees.</p>
          {billingReady ? <>
            {invoices.length ? <div style="overflow-x:auto"><table class="price-table"><thead><tr><th>Invoice</th><th>Due date</th><th>Balance</th><th>Status</th></tr></thead><tbody>
              {invoices.map((i: any)=><tr><td>{i.number}</td><td>{i.due}</td><td>{i.balance}</td><td>{i.status}</td></tr>)}
            </tbody></table></div> : <p class="muted">{stripeNotice || "No invoices to display yet."}</p>}
            <form method="post" action="/api/student-portal/billing"><button class="btn" type="submit">OPEN SECURE TUITION BILLING</button></form>
          </> : <p class="notice">Online tuition payment is not connected to your household yet. Please contact the studio for your exact balance and approved payment options.</p>}
          <p class="muted">Important: Credit-card surcharges and late fees are not being assessed by this portal. Any approved charges must be fully disclosed and legally compliant before activation.</p>
        </section>
      </>
    )}
  </main>
  <footer class="foot"><div class="shell"><strong>Keepers of the Flame · One Tree. One Family.</strong><p>Need help with your student account? Call or text Coach David at <a href="tel:+14102180894">410-218-0894</a>.</p><p>Burning Tree Mixed Martial Arts · Owings Mills, Maryland</p></div></footer>
</body>
</html>
