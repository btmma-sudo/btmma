---
import {getPortalEnv, getPortalAccount, secureHeaders} from "../lib/student-portal-auth.js";
export const prerender = false;
const env = getPortalEnv(Astro.locals);
const account = await getPortalAccount(Astro.request,env);
const errors = {invalid:"Your login could not be verified. Check your details and try again.",security:"Please complete the security check and try again."};
const code = Astro.url.searchParams.get("error");
const err = code === "invalid" ? errors.invalid : code === "security" ? errors.security : "";
let students = [], lessons = [], invoices = [], stripeNotice = "";
let billingReady = false;
let paymentEnabled = false;
if (account) {
  try {
    const people = await env.LIVE_TRIAL_DB.prepare(
      "SELECT display_name, program, belt_rank FROM portal_students WHERE account_id=? AND active=1 ORDER BY display_name LIMIT 12"
    ).bind(account.id).all();
    students = people.results || [];
    const available = await env.LIVE_TRIAL_DB.prepare(
      "SELECT l.id, l.title, l.description, l.program, l.stream_uid FROM portal_lessons l JOIN portal_lesson_access a ON a.lesson_id=l.id WHERE a.account_id=? AND l.published=1 ORDER BY l.sort_order, l.title LIMIT 12"
    ).bind(account.id).all();
    lessons = (available.results || []).map(row=>({...row, playableUrl:""}));
    if (env.STUDENT_PORTAL_STREAM_ACCOUNT_ID && env.STUDENT_PORTAL_STREAM_API_TOKEN) {
      const accountId = String(env.STUDENT_PORTAL_STREAM_ACCOUNT_ID);
      if (/^[a-f0-9]{32}$/.test(accountId)) {
        lessons = await Promise.all(lessons.map(async lesson => {
          if (!/^[a-f0-9]{32}$/.test(lesson.stream_uid)) return lesson;
          try {
            const r = await fetch("https://api.cloudflare.com/client/v4/accounts/" + accountId + "/stream/" + lesson.stream_uid + "/token", {
              method:"POST",
              headers:{"Authorization":"Bearer "+env.STUDENT_PORTAL_STREAM_API_TOKEN,"Content-Type":"application/json"},
              body:JSON.stringify({ exp:Math.floor(Date.now()/1000)+1800, downloadable:false })
            });
            const data = r.ok ? await r.json() : null;
            if (data?.success && /^[A-Za-z0-9_.-]{50,3000}$/.test(data?.result?.token || ""))
              return {...lesson, playableUrl:"https://iframe.videodelivery.net/"+data.result.token};
          } catch { /* Fail closed: do not display an unsigned video URL. */ }
          return lesson;
        }));
      }
    }
  } catch { stripeNotice = "Your lesson information is temporarily unavailable. Please contact the studio."; }
  paymentEnabled = env.STUDENT_PORTAL_PAYMENTS_ENABLED === "true" &&
    /^bpc_[A-Za-z0-9]+$/.test(String(env.STUDENT_PORTAL_STRIPE_PORTAL_CONFIGURATION_ID || "")) &&
    /^(sk|rk)_live_/.test(String(env.STRIPE_LIVE_SECRET_KEY || ""));
  billingReady = paymentEnabled && /^cus_[A-Za-z0-9]+$/.test(account.stripe_customer_id || "");
  if (billingReady) {
    try {
      const response = await fetch("https://api.stripe.com/v1/invoices?customer=" +
        encodeURIComponent(account.stripe_customer_id) + "&limit=12", {
        headers:{"Authorization":"Bearer "+env.STRIPE_LIVE_SECRET_KEY}
      });
      if (response.ok) {
        const result = await response.json();
        invoices = (result.data || []).filter(i=>i.livemode===true &&
          i.customer===account.stripe_customer_id).map(i=>({
          number: String(i.number || "Invoice").slice(0,60),
          due: Number.isInteger(i.due_date) ? new Intl.DateTimeFormat("en-US",{timeZone:"America/New_York",year:"numeric",month:"short",day:"numeric"}).format(new Date(i.due_date*1000)) : "See invoice",
          balance: new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(Math.max(0,Number(i.amount_remaining || 0))/100),
          status: String(i.status || "unknown").slice(0,20)
        }));
      } else stripeNotice = "Your billing history is temporarily unavailable.";
    } catch { stripeNotice = "Your billing history is temporarily unavailable."; }
  }
}
for (const [key,value] of Object.entries(secureHeaders())) Astro.response.headers.set(key,value);
Astro.response.headers.set("Content-Security-Policy", "default-src 'none'; script-src https://challenges.cloudflare.com; style-src 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://challenges.cloudflare.com https://iframe.videodelivery.net; connect-src 'self' https://challenges.cloudflare.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>Student Portal | Burning Tree Mixed Martial Arts</title>
  <meta name="description" content="Private Burning Tree student lessons and family tuition access." />
  <style is:global>
    *{box-sizing:border-box}body{margin:0;background:#111416;color:#f6f7f8;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.55}a{color:#fff}button,input{font:inherit}.shell{max-width:1100px;margin:auto;padding:0 22px}.top{border-bottom:1px solid #383e41;background:#07090b}.top-inner{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:85px}.brand{display:flex;align-items:center;gap:14px;text-decoration:none;font-weight:800;letter-spacing:.02em}.brand img{width:50px;height:65px;object-fit:contain}.back{font-size:.9rem;text-decoration:none;padding:10px 12px;border:1px solid #555;border-radius:8px}.back:hover,.back:focus{border-color:#fc4a40}.hero{padding:54px 0 30px}.eyebrow{letter-spacing:.18em;color:#fb6b5e;font-size:.78rem;font-weight:800}.hero h1{font-size:clamp(2rem,5vw,3.6rem);line-height:1.12;margin:8px 0 16px}.hero p{color:#d6d8da;max-width:690px}.red{color:#f85a50}.content{padding-bottom:72px}.panel{border:1px solid #3b4348;background:#1c2023;border-radius:18px;padding:25px;margin:18px 0;box-shadow:0 10px 30px #0002}.panel h2{font-size:1.35rem;margin:0 0 10px}.muted{color:#bfc5c8}.notice{border-left:4px solid #e7574f;background:#2c2423;padding:12px 16px;border-radius:4px}.fields{display:grid;gap:15px;max-width:480px}.fields label{font-weight:700;display:grid;gap:5px}.fields input{width:100%;background:#fff;color:#141414;padding:13px 15px;border:2px solid transparent;border-radius:8px}.fields input:focus{outline:2px solid #fb6257}.btn{display:inline-block;background:#c52724;color:#fff;border:0;border-radius:9px;text-decoration:none;padding:13px 20px;font-weight:800;cursor:pointer}.btn:hover,.btn:focus{background:#a91a18}.secondary{background:#363b3d}.secondary:hover{background:#555}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:18px}.grid .panel{margin:0}.pill{display:inline-block;font-size:.74rem;letter-spacing:.04em;text-transform:uppercase;padding:3px 9px;border:1px solid #b54843;border-radius:50px;color:#ffaaa5}.lesson{padding:20px}.lesson h3{margin:8px 0}.player{position:relative;padding-top:56.25%;border-radius:12px;overflow:hidden;background:#090b0d;margin:12px 0}.player iframe{border:0;position:absolute;inset:0;width:100%;height:100%}.price-table{width:100%;border-collapse:collapse}.price-table th,.price-table td{text-align:left;padding:12px 8px;border-bottom:1px solid #444}.price-table th{font-size:.82rem;color:#ccc}.foot{color:#b9bdc0;border-top:1px solid #383e41;padding:28px 0;text-align:center;font-size:.9rem}@media(max-width:520px){.top-inner{min-height:72px}.brand img{height:52px;width:38px}.brand span{font-size:.85rem}.back{font-size:.8rem}.panel{padding:19px}.price-table{font-size:.85rem}} 
  </style>
</head>
<body>
  <header class="top"><div class="shell top-inner">
    <a class="brand" href="/"><img src="/images/logo.png" alt="" width="50" height="65" /><span>BURNING TREE<br/>STUDENT PORTAL</span></a>
    <a class="back" href="/">Main Website</a>
  </div></header>
  <main class="shell content">
    <section class="hero">
      <p class="eyebrow">KEEPERS OF THE FLAME</p>
      <h1>Welcome to Your <span class="red">Training Home.</span></h1>
      <p>Continue learning beyond the mats. Access private instructional videos, see your family's training information, and manage tuition securely.</p>
      <strong>One Tree. One Family.</strong>
    </section>
    {!env ? (
      <section class="panel"><h2>Private student access is being prepared</h2><p class="muted">This section is not accepting logins yet. For tuition assistance, please call <a href="tel:+12023684395">(202) 368-4395</a>.</p></section>
    ) : !account ? (
      <section class="panel" aria-labelledby="login-title">
        <h2 id="login-title">Family Login</h2>
        <p class="muted">Only currently authorized Burning Tree families may sign in. Parents or guardians should manage accounts for minor students.</p>
        {err && <p class="notice" role="alert">{err}</p>}
        <form method="post" action="/api/student-portal/login" class="fields">
          <label>Email Address<input name="email" type="email" autocomplete="username" maxlength="254" required /></label>
          <label>Password<input name="password" type="password" autocomplete="current-password" minlength="12" maxlength="200" required /></label>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAD6Ievu-t0Ll1euh" data-theme="dark"></div>
          <button type="submit" class="btn">SECURE SIGN IN</button>
        </form>
        <p class="muted">Need an account or a password reset? Contact the studio at <a href="tel:+12023684395">(202) 368-4395</a>. Accounts are created by staff; public registration is disabled.</p>
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      </section>
    ) : (
      <>
        <section class="panel">
          <div style="display:flex;gap:15px;align-items:center;justify-content:space-between;flex-wrap:wrap">
            <div><p class="eyebrow">SIGNED IN</p><h2>Welcome back, {account.display_name}!</h2><p class="muted">Your family's private student dashboard.</p></div>
            <form action="/api/student-portal/logout" method="post"><button class="btn secondary" type="submit">Sign out</button></form>
          </div>
        </section>
        <section class="panel" aria-labelledby="people-title">
          <h2 id="people-title">My Students</h2>
          {students.length ? <div class="grid">
            {students.map(student=><article class="panel">
              <strong>{student.display_name}</strong><p class="muted">{student.program} · {student.belt_rank}</p>
            </article>)}
          </div> : <p class="muted">Your student profiles will appear once your enrollment is connected.</p>}
        </section>
        <section aria-labelledby="lessons-title">
          <h2 id="lessons-title">My Video Lessons</h2>
          {stripeNotice && <p class="notice">{stripeNotice}</p>}
          {lessons.length ? <div class="grid">
            {lessons.map(lesson=><article class="panel lesson">
              <span class="pill">{lesson.program}</span><h3>{lesson.title}</h3><p class="muted">{lesson.description}</p>
              {lesson.playableUrl ? <div class="player"><iframe title={lesson.title} src={lesson.playableUrl} allow="accelerometer; gyroscope; encrypted-media; picture-in-picture" allowfullscreen loading="lazy" referrerpolicy="no-referrer"></iframe></div> :
                <p class="muted">This private video is not available yet. Check back after the instructor publishes it.</p>}
            </article>)}
          </div> : <div class="panel"><p class="muted">Your instructor has not assigned any private lessons yet. Your Kenpo, Muay Thai, Wing Chun, and Leadership video lessons will appear here as they are approved.</p></div>}
        </section>
        <section class="panel" aria-labelledby="tuition-title">
          <h2 id="tuition-title">Monthly Tuition &amp; Payment History</h2>
          <p class="muted">Your exact tuition and due dates come from your family's approved billing account. The portal does not change your membership rate or automatically add fees.</p>
          {billingReady ? <>
            {invoices.length ? <div style="overflow-x:auto"><table class="price-table"><thead><tr><th>Invoice</th><th>Due date</th><th>Balance</th><th>Status</th></tr></thead><tbody>
              {invoices.map(i=><tr><td>{i.number}</td><td>{i.due}</td><td>{i.balance}</td><td>{i.status}</td></tr>)}
            </tbody></table></div> : <p class="muted">{stripeNotice || "No invoices to display yet."}</p>}
            <form method="post" action="/api/student-portal/billing"><button class="btn" type="submit">OPEN SECURE TUITION BILLING</button></form>
          </> : <p class="notice">Online tuition payment is not connected to your household yet. Please contact the studio for your exact balance and approved payment options.</p>}
          <p class="muted">Important: Credit-card surcharges and late fees are not being assessed by this portal. Any approved charges must be fully disclosed and legally compliant before activation.</p>
        </section>
      </>
    )}
  </main>
  <footer class="foot"><div class="shell"><strong>Keepers of the Flame · One Tree. One Family.</strong><p>Burning Tree Mixed Martial Arts · Owings Mills, Maryland</p></div></footer>
</body>
</html>
