---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ClassSchedule from "../components/ClassSchedule.astro";
import LeadForm from "../components/LeadForm.astro";
import GalleryCarousel from "../components/GalleryCarousel.astro";
import { homePage, homepagePrograms } from "../data/site";
import { adviceArticles } from "../data/advice";
import "../styles/advice.css";
---

<BaseLayout
  title={homePage.seo.title}
  description={homePage.seo.description}
  path="/"
  keywords={homePage.seo.keywords}
  image={homePage.hero.image}>
  <div class="hero-form-layout">
    <PageHero
      hero={homePage.hero}
      large
      centerContent
      ctaLabel="Claim the $29 Special"
      ctaHref="/29-trial"
      ctaDescription="2 beginner classes + a FREE uniform for just $29. New students only."
    />
    <GalleryCarousel />
    <section class="home-trial-banner shell" aria-label="$29 new student special">
      <div class="home-trial-banner-copy">
        <p class="eyebrow">New Student Special</p>
        <h2>$29 — 2 Beginner Classes + FREE Uniform</h2>
        <p>Ready to get on the mats? Register for our new student special today. <a href="/your-first-class" style="text-decoration: underline; text-underline-offset: 3px;">Not sure what to expect? Start with our first-class guide.</a></p>
      </div>
      <a class="button" href="/29-trial">Claim Your $29 Special</a>
    </section>
    <div class="hero-form-float">
      <LeadForm config={homePage.leadForm} />
    </div>
  </div>

  <section class="shell section-divider home-kids-spotlight" aria-labelledby="home-kids-heading">
    <div class="home-kids-spotlight-inner">
      <img src="/images/kids-martial-arts-focus.png" width="760" height="550" loading="lazy" decoding="async" alt="Young Burning Tree martial arts student practicing focus and discipline during class" />
      <div class="home-kids-spotlight-copy">
        <p class="eyebrow">Parents in Owings Mills: This Is For You</p>
        <h2 id="home-kids-heading">Kids Martial Arts. Confidence For Life.</h2>
        <p>Looking for something that helps your child build focus, discipline, respect, and real confidence? Explore our beginner-friendly kids karate, Muay Thai, and Wing Chun classes.</p>
        <a class="button" href="/kids-martial-arts">Explore Kids Martial Arts</a>
      </div>
    </div>
  </section>

  <section class="shell section-divider home-adult-spotlight" aria-labelledby="home-adult-heading">
    <div class="home-adult-spotlight-inner">
      <div class="home-adult-spotlight-copy">
        <p class="eyebrow">Teens &amp; Adults • Owings Mills</p>
        <h2 id="home-adult-heading">You Don't Need Experience. You Just Need to Start.</h2>
        <p>Ready to build real skills, get moving, and challenge yourself? Our beginner-friendly Kenpo Karate, Muay Thai, and Wing Chun classes welcome teens and adults at every starting point.</p>
        <a class="button" href="/teens-adults-martial-arts">Explore Teens &amp; Adults Classes</a>
      </div>
      <img src="/images/adult-martial-arts-gallery-2.jpg" width="760" height="550" loading="lazy" decoding="async" alt="Adult martial artists working together on controlled self-defense techniques at Burning Tree MMA" />
    </div>
  </section>

  <section class="shell section-divider">
    <div class="section-heading">
      <div>
        <h2>Our Programs</h2>
      </div>
    </div>

    <div class="card-grid program-grid">
      {homepagePrograms.map((program) => (
        <a class="program-card" href={program.href}>
          {program.image && (
            <div class="program-card-image">
              <img src={program.image} alt={program.imageAlt ?? program.title} loading="lazy" decoding="async" width="600" height="400" />
            </div>
          )}
          <div class="program-card-body">
            <p class="eyebrow">{program.eyebrow}</p>
            <h3>{program.title}</h3>
            <p>{program.summary}</p>
            <span class="button program-card-btn">View Program</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="shell section-divider" aria-labelledby="owings-mills-martial-arts">
    <article class="detail-card narrative-section">
      <p class="eyebrow">Your Local Martial Arts School in Baltimore County</p>
      <h2 id="owings-mills-martial-arts">Which Martial Arts Class Is Right for You?</h2>
      <p>Burning Tree Mixed Martial Arts is located in Owings Mills, Maryland, and welcomes families from Reisterstown, Pikesville, Randallstown, and surrounding Baltimore County communities. Whether you're looking for kids karate after school, adult martial arts in the evening, or practical self-defense training, we can help you find a starting point.</p>
      <p><strong>For kids:</strong> Our junior Kenpo Karate, Muay Thai, and Wing Chun classes focus on movement, discipline, confidence, and age-appropriate skill development. <a href="/kids-martial-arts">Compare kids martial arts programs</a>.</p>
      <p><strong>For teens and adults:</strong> American Kenpo develops structured self-defense skills; Muay Thai emphasizes striking and conditioning; and Wing Chun explores balance, timing, and efficient movement. <a href="/teens-adults-martial-arts">Find teen and adult classes</a>.</p>
      <p><strong>For women interested in self-defense:</strong> Ask about our Sunday <a href="/womens-defense">Women's Self-Defense / Sanuces classes</a> with practical technique instruction.</p>
      <p>Not sure where to begin? Call or text us at <a href="tel:4102180894">410-218-0894</a>, or <a href="/29-trial">claim our $29 new student special</a> with two beginner classes and a free uniform.</p>
    </article>
  </section>


  <section class="shell section-divider" aria-labelledby="home-advice-title">
    <div class="advice-heading">
      <p class="eyebrow">Advice &amp; Community</p>
      <h2 id="home-advice-title">Questions Before Your First Class?</h2>
      <p>Explore advice from our training floor about building confidence, choosing a martial art, and feeling prepared for your first day at Burning Tree.</p>
    </div>
    <div class="advice-grid">
      {adviceArticles.map((article) => (
        <article class="advice-card">
          <a href={`/advice/${article.slug}`} aria-label={`Read ${article.title}`}>
            <img src={article.image} alt={article.imageAlt} loading="lazy" decoding="async" width="640" height="400" />
          </a>
          <div class="advice-card-body">
            <p class="eyebrow">{article.category}</p>
            <h3><a href={`/advice/${article.slug}`}>{article.title}</a></h3>
            <p>{article.excerpt}</p>
            <a class="advice-card-link" href={`/advice/${article.slug}`}>Read the Guide</a>
          </div>
        </article>
      ))}
    </div>
    <a class="advice-all-link" href="/advice">Explore Martial Arts Advice &amp; Community</a>
  </section>

  <ClassSchedule ctaHref="/29-trial" ctaLabel="Claim the $29 Special" />

  <section class="shell section-divider">
    <article class="detail-card narrative-section">
      <h2>About Burning Tree MMA</h2>
      <p>
        At Burning Tree Mixed Martial Arts in Owings Mills, we combine tradition and
        modern training to help students of all ages grow stronger in mind, body, and
        spirit. Guided by respect, perseverance, and community, we aim to create a
        place where families and individuals can train seriously while feeling supported.
      </p>
      <p>
        Our mission is to help students build real confidence, strengthen both mind and
        body, and develop discipline through martial training that is practical,
        structured, and welcoming.
      </p>
    </article>
  </section>

  <section class="shell section-divider">
    <div class="section-heading">
      <div>
        <h2>Testimonials</h2>
      </div>
    </div>

    <div class="card-grid">
      <blockquote class="quote-card">
        <p>"Best place ever for mixed martial arts. My child is super happy there, come and try today!"</p>
        <footer>Shoshana S.</footer>
      </blockquote>
      <blockquote class="quote-card">
        <p>"Great place to be for the best experience in martial arts."</p>
        <footer>Zainab A.</footer>
      </blockquote>
      <blockquote class="quote-card">
        <p>"My grandson has learned discipline, confidence and martial arts techniques. I am so glad my husband made the decision to enroll him, it was the best choice."</p>
        <footer>Kelly W.</footer>
      </blockquote>
    </div>
  </section>
</BaseLayout>

<style>
  .home-kids-spotlight { padding-top: 3rem; padding-bottom: 3rem; }
  .home-kids-spotlight-inner { display: grid; grid-template-columns: .92fr 1.08fr; align-items: center; gap: 2.5rem; background: #1b1b1b; border: 1px solid #4b1c1c; padding: 1.2rem; }
  .home-kids-spotlight-inner img { height: 310px; width: 100%; object-fit: cover; }
  .home-kids-spotlight-copy { padding: 1.2rem 1.3rem 1.2rem 0; }
  .home-kids-spotlight-copy h2 { margin: 0 0 1rem; }
  .home-kids-spotlight-copy p:not(.eyebrow) { color: #e6e6e6; max-width: 610px; }
  .home-kids-spotlight-copy .button { margin-top: .8rem; }
  .home-adult-spotlight { padding-top: 3rem; padding-bottom: 3rem; }
  .home-adult-spotlight-inner { display: grid; grid-template-columns: 1.07fr .93fr; align-items: center; gap: 2.5rem; background: #1b1b1b; border: 1px solid #4b1c1c; padding: 1.2rem; }
  .home-adult-spotlight-inner img { height: 310px; width: 100%; object-fit: cover; }
  .home-adult-spotlight-copy { padding: 1.2rem 0 1.2rem 1.3rem; }
  .home-adult-spotlight-copy h2 { margin: 0 0 1rem; color: #fff; }
  .home-adult-spotlight-copy p:not(.eyebrow) { color: #e6e6e6; max-width: 610px; }
  .home-adult-spotlight-copy .button { margin-top: .8rem; }
  @media(max-width: 720px) {
    .home-adult-spotlight-inner { grid-template-columns: 1fr; gap: 0; }
    .home-adult-spotlight-inner img { height: 240px; }
    .home-adult-spotlight-copy { padding: 1.4rem .3rem .8rem; }
    .home-adult-spotlight-copy .button { width: 100%; }
    .home-kids-spotlight-inner { grid-template-columns: 1fr; gap: 0; }
    .home-kids-spotlight-inner img { height: 240px; }
    .home-kids-spotlight-copy { padding: 1.4rem .3rem .5rem; }
    .home-kids-spotlight-copy .button { width: 100%; }
  }
</style>
