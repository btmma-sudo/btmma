---
const images = [
  "/images/kids-martial-arts-group.png",
  "/images/kids-martial-arts-karate-guard.png",
  "/images/kids-martial-arts-bag-training.png",
  "/images/kids-martial-arts-partner-practice.png",
  "/images/kids-martial-arts-certificates.png",
  "/images/jr-kenpo-gallery-3.jpg",
  "/images/jr-muay-thai-gallery-2.jpg",
  "/images/jr-wing-chun-gallery-2.jpg",
  "/images/burning-tree-teen-kenpo-training.webp",
  "/images/burning-tree-muay-thai-female.webp",
  "/images/burning-tree-adult-striking-drill.webp",
  "/images/burning-tree-womens-self-defense-cropped.webp"
];

---

<div class="carousel" role="region" aria-label="Burning Tree class and student photos">
  <div class="carousel-track">
    {[0, 1].map((copy) => (
      <div class="carousel-set" aria-hidden={copy === 1 ? "true" : undefined}>
        {images.map((src) => (
          <img
            src={src}
            alt={copy === 0 ? "Real Burning Tree Mixed Martial Arts students and instructors at the studio and events" : ""}
            width="360"
            height="260"
            loading="eager"
            fetchpriority="low"
            decoding="async"
          />
        ))}
      </div>
    ))}
  </div>
</div>
