---
const images = [
  "/images/Gallery/gallery8.jpeg",
  "/images/Gallery/gallery6.jpeg",
  "/images/Gallery/gallery11.jpeg",
  "/images/Gallery/gallery5.jpeg",
  "/images/Gallery/gallery3.jpeg",
  "/images/Gallery/gallery4.jpeg",
  "/images/Gallery/gallery7.jpeg",
  "/images/Gallery/gallery10.jpeg",
  "/images/Gallery/gallery1.jpeg",
  "/images/Gallery/gallery2.jpeg",
  "/images/burning-tree-kenpo-team.webp",
  "/images/burning-tree-belt-achievements.webp",
  "/images/burning-tree-teen-kenpo-training.webp",
  "/images/burning-tree-adult-striking-drill.webp",
  "/images/burning-tree-womens-self-defense-cropped.webp",
  "/images/jr-kenpo-gallery-3.jpg",
  "/images/adult-martial-arts-gallery-1.jpg",
  "/images/adult-martial-arts-gallery-3.jpg",
];

---

<div class="carousel" role="region" aria-label="Burning Tree class and student photos">
  <div class="carousel-track">
    {[0, 1].map((copy) => (
      <div class="carousel-set" aria-hidden={copy === 1 ? "true" : undefined}>
        {images.map((src) => (
          <img
            src={src}
            alt={copy === 0 ? "Real Burning Tree Mixed Martial Arts students and instructors at the studio and events" : ""}
            width="360"
            height="260"
            loading="eager"
            fetchpriority="low"
            decoding="async"
          />
        ))}
      </div>
    ))}
  </div>
</div>
