
---
import { weeklySchedule, formatClassTime } from "../data/schedule";

type Props = {
  ctaHref?: string;
  ctaLabel?: string;
};

const { ctaHref = "/29-trial", ctaLabel = "Try a Class" } = Astro.props;
---

<section class="shell section-divider">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Weekly Schedule</p>
      <h2>Find a class that fits your week.</h2>
    </div>
  </div>

  <div class="schedule-grid">
    {weeklySchedule.map((day) => (
      <div class="schedule-day">
        <p class="schedule-day-label">{day.day}</p>

        <ul class="schedule-slots">
          {day.slots.map((slot) => (
            <li class="schedule-slot">
              <span class="schedule-time">{formatClassTime(slot.start, slot.end)}</span>
              <span class="schedule-class">{slot.cls}</span>
            </li>
          ))}
        </ul>

        {day.note && (
          <p class="schedule-note">{day.note}</p>
        )}
      </div>
    ))}
  </div>

  <div class="schedule-cta">
    <a class="button" href={ctaHref}>
      {ctaLabel}
    </a>
  </div>
</section>
