---
import type { ProgramPage } from "../data/site";
import ClassSchedule from "./ClassSchedule.astro";

type Props = {
  program: ProgramPage;
  showCurriculum?: boolean;
};

const { program, showCurriculum = true } = Astro.props;
const showTestimonials = program.showTestimonials !== false;
const showSchedule = program.showSchedule !== false;
const showLeadForm = program.showLeadForm !== false;
const curriculumBlocks = program.curriculum.copy.split("\n\n");
const { seoCopy } = program;

---

{showCurriculum && (
<section class="shell section-divider">
  <div class="stack">
    <article class="detail-card detail-card-feature">
      <p class="eyebrow">{program.audience}</p>
      <h2>{program.curriculum.title}</h2>
      <div class="program-copy">
        {curriculumBlocks.map((block) =>
          block.startsWith("- ") ? (
            <ul class="program-copy-list">
              {block.split("\n").map((item) => (
                <li>{item.replace(/^- /, "")}</li>
              ))}
            </ul>
          ) : (
            <p>{block}</p>
          )
        )}
      </div>
    </article>
  </div>
</section>
)}

{program.galleryImages.length > 0 && (
  program.galleryImages.length <= 2 ? (
    <div class="shell program-photo-grid" role="region" aria-label="Burning Tree martial arts class photos">
      {program.galleryImages.map((image) => (
        <figure class="program-photo-tile">
          <img src={image.src} alt={image.alt} loading="lazy" decoding="async" width="680" height="440" />
        </figure>
      ))}
    </div>
  ) : (
    <div class="carousel" role="region" aria-label="Burning Tree martial arts class photos">
      <div class="carousel-track page-carousel-track">
        {[0, 1].map((copy) => (
          <div class="carousel-set" aria-hidden={copy === 1 ? "true" : undefined}>
            {program.galleryImages.map((image) => (
              <img
                src={image.src}
                alt={copy === 0 ? image.alt : ""}
                width="360"
                height="260"
                loading="eager"
                fetchpriority="low"
                decoding="async"
              />
            ))}
          </div>
        ))}
      </div>
    </div>
    
  )
)}

{seoCopy && (
  <section class="seo-copy-section">
    <div class="seo-copy-inner">
      <div class="seo-copy-header">
        <h2 class="seo-copy-tagline">{seoCopy.tagline}</h2>
      </div>
      <div class="seo-copy-bullets-block">
        <p class="seo-bullet-heading">{seoCopy.bulletHeading}</p>
        <ul class="seo-copy-bullets">
          {seoCopy.bullets.map((b) => <li><span class="seo-bullet-icon">&#9656;</span>{b}</li>)}
        </ul>
      </div>
    </div>
  </section>
)}

{showSchedule && <ClassSchedule ctaHref="#lead-form" />}

<section class="shell section-divider">
  <div class="stack">
    {showTestimonials && (
      <section class="testimonials-section">
        <h2>Testimonials</h2>
        <div class="card-grid">
          <blockquote class="quote-card">
            <p>"Best place ever for mixed martial arts. My child is super happy there, come and try today!"</p>
            <footer>Shoshana S.</footer>
          </blockquote>
          <blockquote class="quote-card">
            <p>"Great place to be for the best experience in martial arts."</p>
            <footer>Zainab A.</footer>
          </blockquote>
          <blockquote class="quote-card">
            <p>"My grandson has learned discipline, confidence and martial arts techniques. I am so glad my husband made the decision to enroll him, it was the best choice."</p>
            <footer>Kelly W.</footer>
          </blockquote>
        </div>
      </section>
    )}
  </div>
</section>

<style>
  .program-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .program-photo-tile { margin: 0; min-width: 0; background: #1d1d1d; }
  .program-photo-tile img { display: block; width: 100%; height: clamp(220px, 30vw, 350px); object-fit: contain; object-position:center; background:#1d1d1d; border-radius: 4px; }
  @media (max-width: 700px) {
    .program-photo-grid { grid-template-columns: 1fr; }
    .program-photo-tile img { height: auto; max-height: 360px; object-fit: contain; }
  }
</style>
