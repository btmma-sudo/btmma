---
import { programInterestOptions, type LeadFormConfig } from "../data/site";

type Props = {
  config?: LeadFormConfig;
  formId?: string;
};

const { config, formId = "lead-form" } = Astro.props;

const title = config?.title ?? "Start Your First Step";
const intro = config?.intro ?? "Tell us what you are interested in and we will follow up with the best class option.";
const defaultProgram = config?.defaultProgram ?? "";
const submitLabel = config?.submitLabel ?? "Request Information";
const hideProgramSelect = config?.hideProgramSelect ?? false;
const fields = config?.fields ?? "standard";
---

<section class="lead-card-compact-card" id={formId}>
  <h2>{title}</h2>
  <p>{intro}</p>

  <form
    class="lead-form-compact"
    method="post"
    data-submit-label={submitLabel}
    data-lead-form>
    {fields === "emailOnly" ? (
      <>
        <input name="fullName" type="text" placeholder="Name (optional)" autocomplete="name" />
        <input name="email" type="email" placeholder="Email" autocomplete="email" required />
        <input type="hidden" name="phone" value="" />
        <textarea
          name="comments"
          rows="2"
          placeholder="Anything you want us to know about size, interest, or drop updates? (optional)"></textarea>
        <input type="hidden" name="programInterest" value={defaultProgram || "ChimpmanGi"} />
      </>
    ) : (
      <>
        <div class="form-row">
          <input name="fullName" type="text" placeholder="Name" autocomplete="name" required />
          <input name="email" type="email" placeholder="Email" autocomplete="email" required />
        </div>
        <div class="form-row">
          <input name="phone" type="tel" placeholder="Phone" autocomplete="tel" required />
          {!hideProgramSelect && (
            <select name="programInterest" required>
              <option value="">Program</option>
              {programInterestOptions.map((option) => (
                <option value={option} selected={defaultProgram === option}>{option}</option>
              ))}
            </select>
          )}
          {hideProgramSelect && <input type="hidden" name="programInterest" value={defaultProgram} />}
        </div>
        <textarea name="comments" rows="2" placeholder="Comments (optional)"></textarea>
      </>
    )}

    <input name="source" type="hidden" value="" data-source-field />
    <div class="cf-turnstile" data-sitekey="0x4AAAAAAD6Ievu-t0Ll1euh"></div>
    {fields !== "emailOnly" && (
      <label class="lead-sms-optin">
        <input type="checkbox" name="smsConsent" value="yes" />
        <span>Yes, I agree to receive automated text messages from Burning Tree Mixed Martial Arts about my inquiry and classes at the number provided. Message frequency varies; message and data rates may apply. Reply STOP to unsubscribe or HELP for help. Consent is optional and is not required to purchase or enroll.</span>
      </label>
    )}
    <p class="fine-print">
      By submitting, you accept our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>.
    </p>
    <style>
      .lead-sms-optin { display: flex; align-items: flex-start; gap: .6rem; color: #f1eded; font-size: .82rem; line-height: 1.5; margin: .8rem 0; cursor: pointer; }
      .lead-sms-optin input[type="checkbox"] { flex: 0 0 1.15rem; width: 1.15rem; height: 1.15rem; margin: .14rem 0 0; accent-color: #e53935; }
    </style>
    <p class="form-status" data-form-status aria-live="polite"></p>
    <button class="button" type="submit">{submitLabel}</button>
  </form>
</section>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script is:inline>
  if (!(window).__btmmaLeadFormsInitialized) {
    (window).__btmmaLeadFormsInitialized = true;

    const initializeLeadForms = () => {
      const forms = document.querySelectorAll("[data-lead-form]");

    for (const form of forms) {
      if (!(form instanceof HTMLFormElement) || form.dataset.bound === "true") continue;
      form.dataset.bound = "true";

      const status = form.querySelector("[data-form-status]");
      const submitButton = form.querySelector('button[type="submit"]');
      const defaultSubmitLabel = form.dataset.submitLabel ?? "Submit";
      const sourceField = form.querySelector("[data-source-field]");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const token = formData.get("cf-turnstile-response");

        if (!token) {
          if (status instanceof HTMLElement) {
            status.textContent = "Please wait for the security check to complete.";
            status.dataset.state = "error";
          }
          return;
        }

        const currentSource = window.location.pathname + window.location.search + window.location.hash;
        formData.set("source", currentSource || "/");
        // Preserve the visitor's original marketing source for Airtable reporting.
        // The first-touch record is set by BaseLayout; never include personal details.
        try {
          const firstTouch = JSON.parse(window.localStorage.getItem("btmma_first_touch_v1") || "null");
          const fields = ["firstLandingPage", "acquisitionSource", "acquisitionMedium", "utmCampaign", "originalReferrer"];
          if (firstTouch && typeof firstTouch.savedAt === "number" &&
              firstTouch.savedAt <= Date.now() &&
              Date.now() - firstTouch.savedAt < 30 * 24 * 60 * 60 * 1000) {
            for (const field of fields) {
              if (typeof firstTouch[field] === "string" && firstTouch[field]) {
                formData.set(field, firstTouch[field]);
              }
            }
          }
        } catch { /* Inquiry submission must work even if attribution is unavailable. */ }
        if (sourceField instanceof HTMLInputElement) {
          sourceField.value = currentSource || "/";
        }

        const encodedPayload = new URLSearchParams();
        for (const [key, value] of formData.entries()) {
          encodedPayload.set(key, String(value ?? ""));
        }

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.textContent = "Sending...";
        }

        if (status instanceof HTMLElement) {
          status.textContent = "Sending your request...";
          status.dataset.state = "pending";
        }

        try {
          const response = await fetch("/verify-turnstile", {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8"
            },
            body: encodedPayload.toString()
          });

          let result;
          try {
            result = await response.json();
          } catch {
            throw new Error("We could not submit the form right now. Please try again or contact us directly.");
          }

          if (!response.ok || !result.success) {
            throw new Error(result.error || "Submission failed.");
          }

          form.reset();

          const programField = form.querySelector('input[name="programInterest"][type="hidden"]');
          if (programField instanceof HTMLInputElement && programField.defaultValue) {
            programField.value = programField.defaultValue;
          }

          if (status instanceof HTMLElement) {
            status.textContent = "Thanks! Your inquiry has been saved. We'll follow up soon.";
            status.dataset.state = "success";
          }
          // Only record success after the website confirms the inquiry was accepted.
          // Never send names, phone numbers, email addresses or form fields to GA4.
          try {
            if (typeof window.gtag === "function") {
              window.gtag("event", "generate_lead", {
                send_to: "G-5M75V93ZV5",
                lead_type: "website_inquiry",
                form_id: form.id || "site-lead-form",
                page_path: window.location.pathname
              });
            }
          } catch { /* Analytics must never interfere with contact forms. */ }
        } catch (error) {
          if (status instanceof HTMLElement) {
            status.textContent = error instanceof Error ? error.message : "We could not submit the form right now. Please try again or contact us directly.";
            status.dataset.state = "error";
          }
        } finally {
          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;
            submitButton.textContent = defaultSubmitLabel;
          }
        }
      });
    }
    };

    // Wait for all tabs and form instances to be parsed before binding handlers.
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeLeadForms, { once: true });
    } else {
      initializeLeadForms();
    }
  }
</script>
