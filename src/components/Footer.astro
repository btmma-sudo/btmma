---
import { primaryPrograms, secondaryNav, site } from "../data/site";
---

<footer class="site-footer">
  <div class="shell footer-grid">

    <div>
      <p class="footer-label">Contact</p>
      <p>{site.addressLine1}</p>
      <p>
        {site.city}, {site.regionName} {site.postalCode}
      </p>
      <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>

    <div>
      <p class="footer-label">Programs</p>
      <ul class="footer-list">
        <li><a href="/kids-martial-arts">Kids Martial Arts</a></li>
        <li><a href="/teens-adults-martial-arts">Teens &amp; Adults Martial Arts</a></li>
        {primaryPrograms.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="footer-label">Quick Links</p>
      <ul class="footer-list">
        <li><a href="/29-trial">$29 New Student Special</a></li>
        <li><a href="/seminars/">Upcoming Seminars — Register Online</a></li>
        <li><a href="/private-lessons/">Private Lessons — Packages &amp; Booking</a></li>
        <li><a href="/corporate-self-defense/">Corporate &amp; Group Self-Defense Workshops</a></li>
        <li><a href="/studio-rental/">Rent Our Studio Space</a></li>
        <li><a href="/your-first-class">Your First Class</a></li>
        <li><a href="/birthday-parties">Birthday Parties</a></li>
        <li><a href="/advice">Martial Arts Advice &amp; Community</a></li>
        {secondaryNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="shell footer-local">
    <p class="footer-label">Martial Arts Near Owings Mills, Maryland</p>
    <p>Burning Tree Mixed Martial Arts welcomes students from Owings Mills, Reisterstown, Pikesville, Randallstown, and nearby Baltimore County communities. Find the right class for your age and goals:</p>
    <nav class="footer-local-links" aria-label="Popular martial arts programs">
      <a href="/kids-martial-arts">Kids Karate &amp; Martial Arts</a>
      <a href="/teens-adults-martial-arts">Teen &amp; Adult Martial Arts</a>
      <a href="/kenpo-karate">Kenpo Karate</a>
      <a href="/muay-thai">Muay Thai</a>
      <a href="/wing-chun">Wing Chun</a>
      <a href="/womens-defense">Women's Self-Defense</a>
    </nav>
    <p>New to martial arts? <a href="/your-first-class">Learn what to expect at your first class</a>, then <a href="/29-trial">see our $29 offer: two beginner classes and a free uniform.</a></p>
  </div>

  <div class="shell footer-bottom">
    <p>&copy; 2026 Burning Tree Mixed Martial Arts. All rights reserved.</p>
    <p>
      <a href={site.social.instagram}>Instagram</a>
      <span aria-hidden="true"> / </span>
      <a href={site.social.facebook}>Facebook</a>
    </p>
  </div>
</footer>

<style>
  .footer-local { border-top: 1px solid var(--line); padding-top: 1.4rem; padding-bottom: 1.3rem; }
  .footer-local > p { max-width: 850px; margin: .5rem 0; }
  .footer-local-links { display: flex; flex-wrap: wrap; gap: .6rem 1.2rem; margin: .9rem 0; }
  .footer-local-links a { text-decoration: underline; text-underline-offset: 3px; }
</style>
