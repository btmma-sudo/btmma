---
/**
 * Public screenshot-style preview ONLY. No student or payment records are ever
 * queried or embedded here. Never put real names, videos, or billing data here.
 */
---
<div class="screenshot-demo" aria-label="Example student dashboard with sample information">
  <section class="panel demo-welcome">
    <p class="eyebrow">SIGNED IN · EXAMPLE</p>
    <h2>Welcome back, Burning Tree Family!</h2>
    <p>Your private training dashboard.</p>
  </section>

  <section class="panel demo-students">
    <h2>My Students</h2>
    <div class="student-profile">
      <strong>Student Profile</strong>
      <p>Kenpo Karate · Beginner Belt</p>
    </div>
  </section>

  <section class="demo-lessons" aria-labelledby="demo-lessons-title">
    <h2 id="demo-lessons-title">My Video Lessons</h2>
    <div class="lesson-grid">
      <article class="lesson-card">
        <span class="rank-pill">KENPO KARATE</span>
        <div class="video-placeholder" aria-label="Video placeholder">
          <span class="play-ring" aria-hidden="true"><span class="play-triangle"></span></span>
        </div>
        <h3>Beginner Fundamentals</h3>
        <p>Private instructional lesson</p>
      </article>
      <article class="lesson-card">
        <span class="rank-pill">MUAY THAI</span>
        <div class="video-placeholder" aria-label="Video placeholder">
          <span class="play-ring" aria-hidden="true"><span class="play-triangle"></span></span>
        </div>
        <h3>Striking Basics</h3>
        <p>Private instructional lesson</p>
      </article>
      <article class="lesson-card">
        <span class="rank-pill">WING CHUN</span>
        <div class="video-placeholder" aria-label="Video placeholder">
          <span class="play-ring" aria-hidden="true"><span class="play-triangle"></span></span>
        </div>
        <h3>Forms &amp; Techniques</h3>
        <p>Private instructional lesson</p>
      </article>
    </div>
  </section>

  <section class="panel demo-tuition">
    <h2>Monthly Tuition &amp; Payments</h2>
    <p class="tuition-intro">Example only — actual balances and due dates will come from each family's verified account.</p>
    <div class="tuition-rows" aria-label="Example tuition dashboard">
      <div class="tuition-row"><span>Tuition Balance</span><strong>Displayed after setup</strong></div>
      <div class="tuition-row"><span>Next Due Date</span><strong>From your account</strong></div>
      <div class="tuition-row"><span>Payment History</span><strong>Private to your family</strong></div>
    </div>
    <span class="disabled-pay" aria-disabled="true">TUITION BILLING — NOT ACTIVE</span>
    <p class="preview-disclaimer">Preview only. No real student data, live videos, or payment processing are available without an authorized account.</p>
  </section>
</div>

<style is:inline>
  .screenshot-demo{width:100%;max-width:980px;margin:0 auto;padding:1px 0 24px;color:#f4f5f7}
  .screenshot-demo *{box-sizing:border-box}
  .screenshot-demo h2,.screenshot-demo h3,.screenshot-demo strong{color:#f7f7f8}
  .screenshot-demo .panel{border:1px solid #40494e;border-radius:16px;background:#1c2226;box-shadow:none}
  .demo-welcome{padding:24px 22px;margin:0 0 18px}
  .demo-welcome .eyebrow{margin:0 0 10px;color:#f08077;font-weight:800;letter-spacing:.18em;font-size:.78rem}
  .demo-welcome h2{font-size:clamp(1.35rem,4.7vw,1.95rem);font-weight:800;letter-spacing:-.02em;line-height:1.26;margin:0 0 10px}
  .demo-welcome p:last-child{color:#c0c7cb;margin:0;font-size:1rem}
  .demo-students{padding:24px 22px;margin:0 0 24px}
  .demo-students h2,.demo-lessons>h2,.demo-tuition h2{font-size:clamp(1.55rem,4.4vw,2rem);line-height:1.18;font-weight:800;letter-spacing:-.035em;margin:0 0 18px;color:#f5f6f7}
  .student-profile{border:1px solid #444d52;border-radius:12px;padding:18px 16px;background:#1b2024}
  .student-profile strong{font-size:1.05rem;font-weight:800}
  .student-profile p{font-size:1rem;color:#bfc7ca;margin:2px 0 0}
  .demo-lessons{margin:16px 0 26px}
  .demo-lessons>h2{margin:0 0 18px}
  .lesson-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:860px}
  .lesson-card{min-width:0;display:flex;flex-direction:column;border:1px solid #424a50;border-radius:15px;background:#1c2226;padding:17px 15px 18px;box-shadow:none}
  .rank-pill{align-self:flex-start;border:1px solid #c14a46;border-radius:999px;color:#f8a39d;padding:5px 9px;font-weight:750;font-size:.71rem;white-space:nowrap;max-width:100%;line-height:1.35;letter-spacing:.015em}
  .video-placeholder{width:100%;aspect-ratio:16/10;border-radius:9px;background:linear-gradient(135deg,#25272b,#101214);display:grid;place-items:center;margin:16px 0 16px}
  .play-ring{width:49px;height:49px;border:2px solid #e5e6e7;border-radius:50%;display:grid;place-items:center}
  .play-triangle{width:0;height:0;margin-left:4px;border-top:10px solid transparent;border-bottom:10px solid transparent;border-left:15px solid #fff}
  .lesson-card h3{font-size:clamp(.99rem,3.25vw,1.26rem);line-height:1.42;font-weight:800;letter-spacing:-.02em;margin:0;color:#f4f6f6;overflow-wrap:break-word}
  .lesson-card p{font-size:clamp(.85rem,2.75vw,1rem);line-height:1.35;margin:1px 0 0;color:#bfc6ca}
  .demo-tuition{padding:25px 22px 27px;margin:24px 0}
  .demo-tuition h2{margin-bottom:13px}
  .tuition-intro{font-size:.98rem;color:#bec7cb;margin:0 0 17px;line-height:1.55}
  .tuition-row{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:6px 18px;border-bottom:1px solid #444b4f;padding:13px 0;font-size:.93rem;color:#d7d9dc}
  .tuition-row strong{font-size:.92rem;text-align:right;font-weight:700;color:#f5f5f6;margin-left:auto}
  .tuition-row:last-child{border-bottom:0}
  .disabled-pay{display:inline-block;background:#9c302b;color:white;border-radius:9px;padding:13px 18px;font-size:.86rem;letter-spacing:.01em;font-weight:800;margin-top:20px;opacity:.75}
  .preview-disclaimer{font-size:.76rem;color:#c0c5c8;line-height:1.5;margin:12px 0 0}
  @media(min-width:850px){.lesson-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}}
  @media(max-width:440px){
    .screenshot-demo .panel{border-radius:14px}
    .demo-welcome,.demo-students,.demo-tuition{padding:20px 16px}
    .lesson-grid{gap:10px}
    .lesson-card{padding:14px 11px 16px;border-radius:13px}
    .rank-pill{font-size:.64rem;padding:4px 8px}
    .video-placeholder{margin:13px 0 15px}
    .play-ring{width:45px;height:45px}
    .tuition-row{font-size:.85rem}
    .tuition-row strong{font-size:.85rem}
    .disabled-pay{font-size:.8rem}
  }
  @media(max-width:330px){.lesson-grid{gap:8px}.lesson-card{padding:12px 8px}.rank-pill{font-size:.57rem}}
</style>