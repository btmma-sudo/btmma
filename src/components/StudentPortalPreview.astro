---
/**
 * Public, read-only design tour. Intentionally uses NO account/session data,
 * invoice lookups, Cloudflare video URLs, or tuition API links.
 * Never put real student or household information into this component.
 */
---
<section class="demo" aria-labelledby="demo-title">
  <div class="demo-banner" role="status">
    <strong>VIEW-ONLY DEMONSTRATION</strong>
    <span>Explore the student portal without a password. No real student information, playable videos, or payments appear in this preview.</span>
  </div>

  <section class="panel demo-intro">
    <div>
      <p class="eyebrow">INSIDE THE BURNING TREE STUDENT PORTAL</p>
      <h2 id="demo-title">Your Family Dashboard</h2>
      <p class="muted">This is an example of what families will see after signing in. Explore each section below, then return to the login page whenever you are ready.</p>
    </div>
    <a class="btn demo-signin" href="/student-portal/">RETURN TO FAMILY LOGIN</a>
  </section>

  <nav class="demo-jump" aria-label="Explore student portal sections">
    <a href="#demo-students">My Students</a>
    <a href="#demo-lessons">Video Lessons</a>
    <a href="#demo-tuition">Monthly Tuition</a>
  </nav>

  <section id="demo-students" class="panel demo-panel" aria-labelledby="demo-students-title">
    <div class="demo-section-head">
      <div><p class="eyebrow">TRAINING PROFILES</p><h2 id="demo-students-title">My Students</h2></div>
      <span class="demo-example">EXAMPLE ONLY</span>
    </div>
    <div class="grid demo-grid">
      <article class="demo-tile">
        <span class="demo-avatar" aria-hidden="true">🥋</span>
        <div>
          <strong>Example Student</strong>
          <p class="muted">Kenpo Karate · Beginner</p>
          <p class="demo-small">Families will see only the students associated with their own account.</p>
        </div>
      </article>
      <article class="demo-tile demo-explainer">
        <strong>Programs &amp; Progress</strong>
        <p class="muted">Your training styles, rank, and instructor-assigned lessons can appear here as they are added.</p>
      </article>
    </div>
  </section>

  <section id="demo-lessons" class="demo-lessons" aria-labelledby="demo-lessons-title">
    <div class="demo-section-head">
      <div><p class="eyebrow">CONTINUE LEARNING BEYOND THE MATS</p><h2 id="demo-lessons-title">My Video Lessons</h2></div>
      <span class="demo-example">SAMPLE LESSONS</span>
    </div>
    <div class="grid demo-grid">
      <article class="panel demo-lesson">
        <span class="pill">AMERICAN KENPO</span>
        <div class="demo-video" aria-label="Video placeholder, not playable"><span class="demo-play" aria-hidden="true">▶</span></div>
        <h3>Beginner Fundamentals</h3>
        <p class="muted">Stances, hand positions, and basic technique practice.</p>
        <small>Video available once assigned by your instructor</small>
      </article>
      <article class="panel demo-lesson">
        <span class="pill">MUAY THAI</span>
        <div class="demo-video" aria-label="Video placeholder, not playable"><span class="demo-play" aria-hidden="true">▶</span></div>
        <h3>Striking Foundations</h3>
        <p class="muted">Footwork, guard, and controlled combinations.</p>
        <small>Video available once assigned by your instructor</small>
      </article>
      <article class="panel demo-lesson">
        <span class="pill">WING CHUN</span>
        <div class="demo-video" aria-label="Video placeholder, not playable"><span class="demo-play" aria-hidden="true">▶</span></div>
        <h3>Forms &amp; Principles</h3>
        <p class="muted">Structure, balance, centerline, and forms.</p>
        <small>Video available once assigned by your instructor</small>
      </article>
    </div>
    <p class="demo-small">These are examples of possible lesson categories, not actual uploaded lesson videos. Real video playback requires an authorized student account.</p>
  </section>

  <section id="demo-tuition" class="panel demo-panel" aria-labelledby="demo-tuition-title">
    <div class="demo-section-head">
      <div><p class="eyebrow">PRIVATE FAMILY BILLING</p><h2 id="demo-tuition-title">Monthly Tuition &amp; Payment History</h2></div>
      <span class="demo-example">NOT ACTIVE</span>
    </div>
    <p class="muted">After verified account setup, families can review their own tuition and secure payment history. No personal financial details are shown in this preview.</p>
    <div class="demo-billing-grid">
      <div class="demo-billing-item"><span>Tuition balance</span><strong>Private to family</strong></div>
      <div class="demo-billing-item"><span>Next due date</span><strong>From billing account</strong></div>
      <div class="demo-billing-item"><span>Payment history</span><strong>Available after setup</strong></div>
    </div>
    <div class="demo-disabled-pay" aria-disabled="true">TUITION PAYMENT — COMING SOON</div>
    <p class="demo-small">This demonstration cannot charge cards, display bills, or assess fees.</p>
  </section>

  <div class="demo-end">
    <strong>One Tree. One Family.</strong>
    <p class="muted">Finished looking around? The login page is available now, and individual student accounts will be added as they're approved.</p>
    <a class="btn" href="/student-portal/">BACK TO STUDENT LOGIN</a>
  </div>
</section>

<style>
  .demo{padding-bottom:10px}
  .demo-banner{display:flex;gap:9px;flex-direction:column;background:#382425;border:1px solid #854843;border-radius:12px;padding:14px 18px;color:#fceeee;font-size:.9rem;line-height:1.5}
  .demo-banner strong{font-size:.8rem;letter-spacing:.1em;color:#ffb2aa}
  .demo-intro{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
  .demo-intro>div{max-width:660px}
  .demo-intro h2{font-size:clamp(1.5rem,3vw,2rem);margin:4px 0}
  .demo-signin{white-space:normal}
  .demo-jump{display:flex;gap:11px;flex-wrap:wrap;margin:18px 0 26px}
  .demo-jump a{background:#292f33;color:#fff;padding:11px 16px;font-size:.88rem;border-radius:8px;border:1px solid #555e63;text-decoration:none;font-weight:700}
  .demo-jump a:hover,.demo-jump a:focus-visible{background:#732a29;border-color:#d66660}
  .demo-section-head{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
  .demo-section-head h2{font-size:1.45rem;margin:3px 0 0}
  .demo-example{color:#ffd0cb;border:1px solid #984742;padding:5px 11px;border-radius:30px;font-size:.72rem;letter-spacing:.07em;font-weight:800}
  .demo-tile{display:flex;align-items:center;gap:16px;padding:20px;border:1px solid #495058;background:#121619;border-radius:12px;min-height:135px}
  .demo-tile strong{font-size:1.05rem}
  .demo-tile .muted{margin:4px 0}
  .demo-avatar{width:58px;height:58px;flex:0 0 58px;display:grid;place-items:center;font-size:2rem;background:#2d3135;border-radius:50%}
  .demo-explainer{display:block}
  .demo-explainer strong{display:block;margin-bottom:8px}
  .demo-small,.demo-lesson small{font-size:.8rem;color:#c4c9cb;line-height:1.5}
  .demo-lessons{margin:28px 0}
  .demo-lesson{margin-top:0;display:flex;flex-direction:column;gap:8px}
  .demo-lesson h3{font-size:1.13rem;margin:5px 0 0}
  .demo-lesson .muted{font-size:.9rem;margin:0;flex:1}
  .demo-lesson .pill{align-self:start}
  .demo-video{width:100%;aspect-ratio:16/9;border-radius:10px;background:radial-gradient(circle at 50% 45%,#4f3736,#191d21 75%);border:1px solid #40484c;display:grid;place-items:center;margin:9px 0}
  .demo-play{display:grid;place-items:center;background:#b92a26;width:49px;height:49px;border-radius:50%;font-size:1.2rem;padding-left:3px}
  .demo-billing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin:16px 0}
  .demo-billing-item{background:#111719;border:1px solid #475056;padding:16px;border-radius:10px;display:flex;flex-direction:column;gap:7px}
  .demo-billing-item span{font-size:.83rem;color:#cbd0d2}
  .demo-billing-item strong{font-size:.98rem}
  .demo-disabled-pay{background:#68312d;display:inline-flex;padding:13px 18px;border-radius:9px;font-size:.82rem;font-weight:800;letter-spacing:.015em;color:#fff}
  .demo-end{text-align:center;padding:25px 10px}
  .demo-end strong{font-size:1.14rem}
  .demo-end .muted{max-width:660px;margin:10px auto 16px}
  @media(max-width:540px){.demo-intro .btn{width:100%;text-align:center}.demo-jump a{flex:1;text-align:center}.demo-tile{padding:16px}}
</style>
