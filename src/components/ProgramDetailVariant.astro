---
import type { ProgramPage } from "../data/site";
import ClassSchedule from "./ClassSchedule.astro";

type Props = {
  program: ProgramPage;
};

const { program } = Astro.props;
const variants = program.variants!;
const showTestimonials = program.showTestimonials !== false;
const showSchedule = program.showSchedule !== false;

---

<div class="variant-tabs-bar shell" role="tablist" aria-label={program.hero.title + " class age groups"}>
  {variants.map((v, i) => (
    <button
      class:list={["variant-tab-btn", i === 0 && "is-active"]}
      data-variant-tab={String(i)}
      id={program.slug + "-tab-" + i}
      role="tab"
      aria-controls={program.slug + "-panel-" + i}
      aria-selected={i === 0}
      tabindex={i === 0 ? 0 : -1}
      type="button"
    >
      {v.label}
    </button>
  ))}
</div>

{variants.map((v, i) => (
  <div
    class:list={["variant-panel", i !== 0 && "variant-panel--hidden"]}
    data-variant-panel={String(i)}
    id={program.slug + "-panel-" + i}
    role="tabpanel"
    aria-labelledby={program.slug + "-tab-" + i}
    hidden={i !== 0}
  >
    <section class="shell section-divider variant-overview">
      <div class="variant-overview-grid">
        <article class="detail-card detail-card-feature variant-overview-copy">
          <p class="eyebrow">{v.audience}</p>
          <h2>{v.curriculum.title}</h2>
          <div class="program-copy">
            {v.curriculum.copy.split("\n\n").map((block) =>
              block.startsWith("- ") ? (
                <ul class="program-copy-list">
                  {block.split("\n").map((item) => (
                    <li>{item.replace(/^- /, "")}</li>
                  ))}
                </ul>
              ) : (
                <p>{block}</p>
              )
            )}
          </div>
        </article>
        <aside class="variant-benefits" aria-label={v.benefits.title}>
          <h3>{v.benefits.title}</h3>
          <ul>
            {v.benefits.items.map((item) => <li>{item}</li>)}
          </ul>
          <a class="button variant-benefits-cta" href="/29-trial">Claim the $29 New Student Special</a>
          <p class="variant-offer-note">2 beginner classes + a free uniform for new students.</p>
        </aside>
      </div>
    </section>

    {v.galleryImages.length > 0 && (
      v.galleryImages.length <= 2 ? (
        <div class="shell variant-photo-grid" role="region" aria-label={`Photos from Burning Tree ${v.label} classes`}>
          {v.galleryImages.map((image) => (
            <figure class="variant-photo-tile">
              <img src={image.src} alt={image.alt} loading="lazy" decoding="async" width="680" height="440" />
            </figure>
          ))}
        </div>
      ) : (
        <div class="carousel" role="region" aria-label={`Photos from Burning Tree ${v.label} classes`}>
        <div class="carousel-track page-carousel-track">
        {[0, 1].map((copy) => (
        <div class="carousel-set" aria-hidden={copy === 1 ? "true" : undefined}>
        {v.galleryImages.map((image) => (
        <img
        src={image.src}
        alt={copy === 0 ? image.alt : ""}
        width="360"
        height="260"
        loading="eager"
        fetchpriority="low"
        decoding="async"
        />
        ))}
        </div>
        ))}
        </div>
        </div>
        
      )
    )}

    {v.seoCopy && (
      <section class="seo-copy-section">
        <div class="seo-copy-inner">
          <div class="seo-copy-header">
            <h2 class="seo-copy-tagline">{v.seoCopy.tagline}</h2>
          </div>
          <div class="seo-copy-bullets-block">
            <p class="seo-bullet-heading">{v.seoCopy.bulletHeading}</p>
            <ul class="seo-copy-bullets">
              {v.seoCopy.bullets.map((b) => (
                <li><span class="seo-bullet-icon">&#9656;</span>{b}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}
  </div>
))}

{showSchedule && <ClassSchedule ctaHref="/29-trial" ctaLabel="Claim the $29 New Student Special" />}

{showTestimonials && (
  <section class="shell section-divider">
    <div class="stack">
      <section class="testimonials-section">
        <h2>Testimonials</h2>
        <div class="card-grid">
          <blockquote class="quote-card">
            <p>"Best place ever for mixed martial arts. My child is super happy there, come and try today!"</p>
            <footer>Shoshana S.</footer>
          </blockquote>
          <blockquote class="quote-card">
            <p>"Great place to be for the best experience in martial arts."</p>
            <footer>Zainab A.</footer>
          </blockquote>
          <blockquote class="quote-card">
            <p>"My grandson has learned discipline, confidence and martial arts techniques. I am so glad my husband made the decision to enroll him, it was the best choice."</p>
            <footer>Kelly W.</footer>
          </blockquote>
        </div>
      </section>
    </div>
  </section>
)}

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-variant-tab]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-variant-panel]"));

  const activateTab = (target: string) => {
    tabs.forEach((tab) => {
      const active = tab.dataset.variantTab === target;
      tab.classList.toggle("is-active", active);
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => {
      const active = panel.dataset.variantPanel === target;
      panel.hidden = !active;
      panel.classList.toggle("variant-panel--hidden", !active);
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activateTab(tab.dataset.variantTab || "0"));
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      tabs[next].focus();
      activateTab(tabs[next].dataset.variantTab || "0");
    });
  });
</script>

<style>
  .variant-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .variant-photo-tile { margin: 0; min-width: 0; background: #1d1d1d; }
  .variant-photo-tile img { display: block; width: 100%; height: clamp(220px, 30vw, 350px); object-fit: contain; object-position:center; background:#1d1d1d; border-radius: 4px; }
  @media (max-width: 700px) {
    .variant-photo-grid { grid-template-columns: 1fr; }
    .variant-photo-tile img { height: auto; max-height: 360px; object-fit: contain; }
  }

  .variant-tabs-bar {
    padding-top: 1.1rem;
    padding-bottom: .75rem;
  }
  .variant-tab-btn { padding: .55rem 1.4rem; }
  .variant-overview { padding-top: 1.25rem; padding-bottom: 1.35rem; }
  .variant-overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: 1.15rem;
    align-items: start;
  }
  .variant-overview-copy { min-width: 0; }
  .variant-overview-copy h2 { font-size: clamp(1.35rem, 2.5vw, 2rem); }
  .variant-overview-copy .program-copy p { margin: 0; }
  .variant-benefits {
    border: 1px solid rgba(255, 255, 255, .15);
    border-top: 2px solid var(--accent);
    background: #1f1f1f;
    padding: 1.15rem;
    min-width: 0;
  }
  .variant-benefits h3 {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    color: #fff;
    -webkit-text-stroke: 0;
    margin-bottom: .75rem;
  }
  .variant-benefits ul {
    margin: 0 0 1.1rem;
    padding-left: 1.2rem;
    display: grid;
    gap: .4rem;
    color: #f5f5f5;
  }
  .variant-benefits li { line-height: 1.5; font-size: .95rem; }
  .variant-benefits-cta { width: 100%; text-align: center; }
  .variant-offer-note {
    color: #efefef;
    font-size: .86rem;
    line-height: 1.5;
    margin: .65rem 0 0;
  }
  @media (max-width: 760px) {
    .variant-overview-grid { grid-template-columns: 1fr; }
    .variant-tabs-bar { padding-top: .9rem; }
    .variant-tab-btn { flex: 1; padding: .6rem .8rem; }
  }
</style>
