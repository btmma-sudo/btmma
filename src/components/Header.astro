---
import { primaryPrograms, site } from "../data/site";
---

<header class="site-header">
  <div class="header-notice">
    <div class="shell">
      <span>
        <a class="header-address-link" href={site.mapUrl} target="_blank" rel="noreferrer">
          {site.addressLine1}, {site.city}, {site.region} {site.postalCode}
        </a>
      </span>
      <span>Questions? Call us: <a href={`tel:${site.phoneHref}`}>{site.phone}</a></span>
    </div>
  </div>
  
  <div class="shell nav-shell">
    <a class="brand" href="/" aria-label="Burning Tree MMA home">
      <img
        src="/images/logo.png"
        alt="Burning Tree MMA"
        class="brand-logo"
        width="707"
        height="960"
        loading="eager"
        decoding="async" />
    </a>

    <nav class="top-nav desktop-nav" aria-label="Primary">
      <details class="nav-group">
        <summary>Classes</summary>
        <div class="nav-dropdown">
          <a href="/your-first-class">Your First Class</a>
          <a href="/private-lessons/">Private Lessons &amp; Coaching</a>
          <a href="/corporate-self-defense/">Corporate &amp; Group Self-Defense</a>
          <a href="/studio-rental/">Studio Space Rental</a>
          {primaryPrograms.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </details>

      <a class="header-trial-nav" href="/29-trial">$29 New Student Special</a>
      <a href="/seminars/">Upcoming Seminars</a>
      <a href="/private-lessons/">Private Lessons</a>
      <a href="/student-portal/">Student Portal</a>
      <details class="nav-group">
        <summary>About &amp; Programs</summary>
        <div class="nav-dropdown">
          <a href="/about">About Burning Tree</a>
          <a href="/faq">Frequently Asked Questions</a>
          <a href="/kids-martial-arts">Kids Martial Arts</a>
          <a href="/teens-adults-martial-arts">Teens &amp; Adults Martial Arts</a>
        </div>
      </details>
      <details class="nav-group">
        <summary>Advice &amp; Community</summary>
        <div class="nav-dropdown">
          <a href="/advice">Martial Arts Advice &amp; Community</a>
          <a href="/success-stories">Parent Success Stories</a>
        </div>
      </details>
      <a href="/gallery">Gallery</a>
      <a href="/birthday-parties">Birthday Parties</a>
      <a href="/chimpman-gi">ChimpmanGi</a>
      <a href="/health-and-wellness">Health and Wellness</a>
    </nav>

    <a class="header-mobile-offer" href="/29-trial">$29 Special</a>

    <details class="mobile-menu">
      <summary aria-label="Open navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <div class="mobile-menu-panel">
        <a class="mobile-menu-link mobile-menu-link-primary" href="/29-trial">$29 Special — 2 Classes + Free Uniform</a>
        <a class="mobile-menu-link" href="/seminars/">Upcoming Seminars — Register &amp; Pay</a>
        <a class="mobile-menu-link" href="/private-lessons/">Private Lessons — Packages &amp; Payment</a>
        <a class="mobile-menu-link" href="/corporate-self-defense/">Corporate &amp; Group Self-Defense — Workshops</a>
        <a class="mobile-menu-link" href="/studio-rental/">Studio Rental — Request Space</a>
        <a class="mobile-menu-link" href="/student-portal/">Student Portal — Family Login</a>
        <a class="mobile-menu-link" href="/your-first-class">Your First Class — What to Expect</a>
        <details class="mobile-submenu">
          <summary>Advice &amp; Community</summary>
          <div class="mobile-submenu-links">
            <a href="/advice">Martial Arts Advice &amp; Community</a>
            <a href="/success-stories">Parent Success Stories</a>
          </div>
        </details>
        <details class="mobile-submenu">
          <summary>Classes</summary>
          <div class="mobile-submenu-links">
            {primaryPrograms.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
        </details>

        <div class="mobile-menu-links">
          <details class="mobile-submenu">
            <summary>About &amp; Programs</summary>
            <div class="mobile-submenu-links">
              <a href="/about">About Burning Tree</a>
              <a href="/faq">Frequently Asked Questions</a>
              <a href="/kids-martial-arts">Kids Martial Arts</a>
              <a href="/teens-adults-martial-arts">Teens &amp; Adults Martial Arts</a>
            </div>
          </details>
          <a href="/gallery">Gallery</a>
          <a href="/birthday-parties">Birthday Parties</a>
          <a href="/chimpman-gi">ChimpmanGi</a>
          <a href="/health-and-wellness">Health and Wellness</a>
        </div>
      </div>
    </details>
  </div>
</header>
