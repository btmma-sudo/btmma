{
  "name": "burningtreemma",
  "compatibility_date": "2026-04-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./dist/_worker.js/index.js",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "SITE_GUIDE_LIMIT", "namespace_id": "921874", "simple": { "limit": 8, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "TRIAL_DB",
      "database_name": "burningtree-trial-payments",
      "database_id": "d2422ebf-13fe-4834-ab5f-586eb94121d3"
    },
    {
      "binding": "LIVE_TRIAL_DB",
      "database_name": "burningtree-live-payments",
      "database_id": "b7b87f5b-560a-4e92-b7e7-0b3959025c4f"
    }
  ],
  "vars": {
    "MAKE_WEBHOOK_URL": "https://hook.eu2.make.com/148pw2jrjro999olsiy0up1i54rixtj2",
    "AIRTABLE_BASE_ID": "apptGRToJEGKv0NDa",
    "CORPORATE_WORKSHOP_NOTIFICATION_EMAIL": "hybridkenpokarare@gmail.com",
    "LIVE_CHECKOUT_ENABLED": "true",
    "LIVE_PILOT_ONLY": "false",
    "SANDBOX_CHECKOUT_ENABLED": "false",
    "PNO_TEST_CHECKOUT_ENABLED": "true",
    "SEMINAR_TEST_CHECKOUT_ENABLED": "true",
    "STUDENT_PORTAL_ENABLED": "true",
    "STUDENT_PORTAL_PAYMENTS_ENABLED": "false",
    "STUDENT_PORTAL_STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1Ua5rRDFqxIwgzLY4UIJCYov"
  }
}
